<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t
    t-name="treasury_forecast_pivot_color.PivotRenderer"
    t-inherit="web.PivotRenderer"
    t-inherit-mode="primary"
  >
    <!--
            Odoo 19 calcula formattedValue dentro del div numérico y pinta
            formattedValue.value en un span. Se colorea ese div sin tocar el
            renderer booleano ni el resto del comportamiento del core.

            Si en el futuro piden colorear sólo una medida concreta,
            añadir cell.measure === '<nombre_campo>' a la condición.
            Para semáforo/rangos, sustituir las comparaciones > 0 / < 0
            por los umbrales que correspondan.
        -->
    <xpath expr="//div[t[@t-set='formattedValue']]" position="attributes">
      <attribute name="t-att-class">{
                'text-success': cell.value &gt; 0,
                'text-danger': cell.value &lt; 0,
            }</attribute>
    </xpath>
  </t>

</templates>
