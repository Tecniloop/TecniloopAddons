<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tl_demo_orders_wizard_form" model="ir.ui.view">
        <field name="name">tl.demo.orders.wizard.form</field>
        <field name="model">tl.demo.orders.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar pedidos demo">
                <sheet>
                    <group>
                        <group string="Intervalo">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="min_per_day"/>
                            <field name="max_per_day"/>
                        </group>
                        <group string="Opciones">
                            <field name="company_id"/>
                            <field name="warehouse_id"/>
                            <field name="sale_journal_id"/>
                            <field name="purchase_journal_id"/>
                            <field name="generate_confirmed"/>
                            <field name="generate_sale_quotes"/>
                            <field name="generate_purchase_rfqs"/>
                            <field name="sales_per_purchase"/>
                            <field name="purchase_price_ratio"/>
                            <field name="validate_deliveries_by_date" invisible="not generate_confirmed"/>
                            <field name="backdate_pickings" invisible="not validate_deliveries_by_date"/>
                            <field name="use_queue_job"/>
                            <field name="lines_min"/>
                            <field name="lines_max"/>
                        </group>
                    </group>
                    <group string="Usuarios (asignación aleatoria)">
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}" colspan="2"/>
                    </group>
                    <group string="Resultado" invisible="not last_summary">
                        <field name="last_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generar pedidos" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tl_demo_orders_wizard" model="ir.actions.act_window">
        <field name="name">Generar pedidos demo</field>
        <field name="res_model">tl.demo.orders.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_tl_demo_orders_root"
        name="Datos demo"
        parent="sale.sale_menu_root"
        sequence="90"/>
    <menuitem
        id="menu_tl_demo_orders_wizard"
        name="Pedidos aleatorios por fechas"
        parent="menu_tl_demo_orders_root"
        action="action_tl_demo_orders_wizard"
        sequence="10"/>

    <record id="view_tl_demo_invoice_wizard_form" model="ir.ui.view">
        <field name="name">tl.demo.invoice.wizard.form</field>
        <field name="model">tl.demo.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar pedidos demo">
                <sheet>
                    <group>
                        <group string="Intervalo">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Opciones">
                            <field name="invoice_sales"/>
                            <field name="sale_journal_id" invisible="not invoice_sales"/>
                            <field name="invoice_purchases"/>
                            <field name="purchase_journal_id" invisible="not invoice_purchases"/>
                            <field name="use_queue_job"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="not last_summary">
                        <field name="last_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_invoice" type="object" string="Facturar" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tl_demo_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Facturar pedidos demo</field>
        <field name="res_model">tl.demo.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_tl_demo_invoice_wizard"
        name="Facturar pedidos demo"
        parent="menu_tl_demo_orders_root"
        action="action_tl_demo_invoice_wizard"
        sequence="20"/>

    <record id="view_tl_demo_payment_wizard_form" model="ir.ui.view">
        <field name="name">tl.demo.payment.wizard.form</field>
        <field name="model">tl.demo.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Cobrar y pagar facturas demo">
                <sheet>
                    <group>
                        <group string="Intervalo">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Tesorería">
                            <field name="journal_id"/>
                            <field name="pay_customer"/>
                            <field name="pay_vendor"/>
                            <field name="use_queue_job"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="not last_summary">
                        <field name="last_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_pay" type="object" string="Cobrar / Pagar" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tl_demo_payment_wizard" model="ir.actions.act_window">
        <field name="name">Cobrar y pagar facturas demo</field>
        <field name="res_model">tl.demo.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_tl_demo_payment_wizard"
        name="Cobrar y pagar facturas demo"
        parent="menu_tl_demo_orders_root"
        action="action_tl_demo_payment_wizard"
        sequence="25"/>

    <record id="view_tl_demo_leads_wizard_form" model="ir.ui.view">
        <field name="name">tl.demo.leads.wizard.form</field>
        <field name="model">tl.demo.leads.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar leads demo">
                <sheet>
                    <group>
                        <group string="Intervalo">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="min_per_day"/>
                            <field name="max_per_day"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Asignación aleatoria">
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="country_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="stage_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="expected_revenue_min"/>
                            <field name="expected_revenue_max"/>
                            <field name="probability_min"/>
                            <field name="probability_max"/>
                            <field name="tags_min"/>
                            <field name="tags_max"/>
                            <field name="use_queue_job"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="not last_summary">
                        <field name="last_summary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generar leads" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tl_demo_leads_wizard" model="ir.actions.act_window">
        <field name="name">Generar leads demo</field>
        <field name="res_model">tl.demo.leads.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_tl_demo_leads_wizard"
        name="Leads aleatorios por fechas"
        parent="menu_tl_demo_orders_root"
        action="action_tl_demo_leads_wizard"
        sequence="30"/>
</odoo>
