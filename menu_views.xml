<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiebdc_import_wizard_form" model="ir.ui.view">
        <field name="name">fiebdc.import.wizard.form</field>
        <field name="model">fiebdc.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BC3 Products from ZIP">
                <sheet>
                    <group string="ZIP to import">
                        <div class="alert alert-info" role="alert" colspan="2">
                            Select a .zip file containing one .bc3 file and its related images/PDFs.
                        </div>
                        <field name="zip_attachment_ids"
                               widget="many2many_binary"
                               required="1"
                               options="{'accepted_file_extensions': '.zip'}"/>
                        <field name="zip_file" invisible="1"/>
                        <field name="zip_filename" invisible="1" force_save="1"/>
                        <field name="bc3_filename" placeholder="Optional: path/to/file.bc3"/>
                    </group>
                    <group string="Import Options" col="4">
                        <field name="update_existing"/>
                        <field name="default_product_type"/>
                        <field name="track_inventory" invisible="default_product_type != 'consu'"/>
                        <field name="import_type_4"/>
                        <field name="import_type_5"/>
                        <field name="import_images"/>
                        <field name="set_first_image"/>
                        <field name="overwrite_image"/>
                        <field name="import_attachments"/>
                        <field name="skip_duplicate_attachments"/>
                        <field name="dry_run"/>
                    </group>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fiebdc_import_wizard" model="ir.actions.act_window">
        <field name="name">Import BC3 Products</field>
        <field name="res_model">fiebdc.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiebdc_import_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
