<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_document_intake_list" model="ir.ui.view">
        <field name="name">vendor.document.intake.list</field>
        <field name="model">vendor.document.intake</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'exception'" decoration-success="state == 'applied'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="partner_id"/>
                <field name="document_number"/>
                <field name="po_number"/>
                <field name="purchase_id"/>
                <field name="document_date"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'identified')"
                       decoration-warning="state == 'matched'"
                       decoration-success="state == 'applied'"
                       decoration-danger="state == 'exception'"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_document_intake_form" model="ir.ui.view">
        <field name="name">vendor.document.intake.form</field>
        <field name="model">vendor.document.intake</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_identify" type="object" string="Identify &amp; match"
                            class="btn-primary" invisible="state in ('applied', 'cancelled')"/>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" invisible="state in ('applied', 'cancelled', 'draft')"/>
                    <button name="action_accept_document_prices" type="object"
                            string="Accept document prices"
                            invisible="document_type != 'vendor_bill' or state in ('applied', 'cancelled') or price_exception_count == 0"/>
                    <button name="action_keep_po_prices" type="object"
                            string="Keep PO prices"
                            invisible="document_type != 'vendor_bill' or state in ('applied', 'cancelled') or price_exception_count == 0"/>
                    <button name="action_review_price_exceptions" type="object"
                            string="Review prices"
                            invisible="price_exception_count == 0 or state in ('applied', 'cancelled')"/>
                    <button name="action_retry_related" type="object" string="Retry match"
                            invisible="state in ('applied', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft"
                            invisible="state not in ('exception', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('applied', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,identified,matched,applied"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not purchase_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Purchase</span>
                            </div>
                        </button>
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Receipt</span>
                            </div>
                        </button>
                        <button name="action_view_return_picking" type="object"
                                class="oe_stat_button" icon="fa-undo"
                                invisible="not return_picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Return</span>
                            </div>
                        </button>
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bill</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Exception" bg_color="text-bg-danger" invisible="state != 'exception'"/>
                    <widget name="web_ribbon" title="Applied" bg_color="text-bg-success" invisible="state != 'applied'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="_barcode_scanned" widget="barcode_handler" invisible="1"/>
                    <group string="Barcode scanner" name="barcode_scan">
                        <field name="last_scanned_barcode" placeholder="Scan product, lot or PO"/>
                        <field name="scan_message" readonly="1"/>
                        <button name="action_process_scanned_barcode" type="object"
                                string="Process scan" class="btn-secondary"
                                invisible="state in ('applied', 'cancelled')"/>
                    </group>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="mailbox_id"/>
                            <field name="partner_id"/>
                            <field name="supplier_name"/>
                            <field name="supplier_name_corrected"/>
                            <field name="supplier_vat"/>
                            <field name="supplier_code"/>
                        </group>
                        <group>
                            <field name="po_number"/>
                            <field name="purchase_id"/>
                            <field name="created_purchase"/>
                            <field name="document_number"/>
                            <field name="document_date"/>
                            <field name="delivery_note_number" invisible="document_type != 'delivery_note'"/>
                            <field name="invoice_number" invisible="document_type != 'vendor_bill'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_vat"/>
                            <field name="company_name_scan"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="candidate_purchase_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                            <field name="parseur_document_id"/>
                            <field name="match_score"/>
                            <field name="price_exception_count"/>
                            <field name="price_difference_amount"/>
                            <field name="receipt_exception_count"/>
                            <field name="has_pending_price_exception" invisible="1"/>
                            <field name="price_decision" invisible="document_type != 'vendor_bill'"/>
                            <field name="spellcheck_log" invisible="not spellcheck_log"/>
                        </group>
                    </group>
                    <group invisible="not exception_reason">
                        <field name="exception_reason" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="sku"/>
                                    <field name="supplier_code"/>
                                    <field name="barcode"/>
                                    <field name="qty_document"/>
                                    <field name="qty_ordered"/>
                                    <field name="qty_received"/>
                                    <field name="qty_remaining" optional="show"/>
                                    <field name="qty_extra" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="price_reference"/>
                                    <field name="price_variance"/>
                                    <field name="price_variance_pct"/>
                                    <field name="price_exception" widget="boolean_toggle" optional="show"/>
                                    <field name="price_decision" optional="show"/>
                                    <button name="action_accept_document_price" type="object"
                                            string="Accept" icon="fa-check"
                                            invisible="not price_exception or price_decision != 'pending' or parent.state in ('applied', 'cancelled')"/>
                                    <button name="action_keep_po_price" type="object"
                                            string="Keep PO" icon="fa-lock"
                                            invisible="not price_exception or price_decision != 'pending' or parent.state in ('applied', 'cancelled')"/>
                                    <field name="lot_name"/>
                                    <field name="lot_corrected" optional="hide"/>
                                    <field name="lot_ids" widget="many2many_tags" optional="show"/>
                                    <field name="tracking" optional="hide"/>
                                    <field name="expiry_date" optional="show"/>
                                    <field name="expiry_state" optional="show"/>
                                    <field name="purchase_line_id"/>
                                    <field name="match_status" widget="badge"
                                           decoration-success="match_status == 'ok'"
                                           decoration-warning="match_status in ('under', 'over')"
                                           decoration-danger="match_status in ('unordered', 'unidentified')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload" name="payload">
                            <field name="payload_json" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vendor_document_intake_search" model="ir.ui.view">
        <field name="name">vendor.document.intake.search</field>
        <field name="model">vendor.document.intake</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="document_number"/>
                <field name="po_number"/>
                <field name="purchase_id"/>
                <filter string="Delivery notes" name="dn" domain="[('document_type', '=', 'delivery_note')]"/>
                <filter string="Vendor bills" name="bills" domain="[('document_type', '=', 'vendor_bill')]"/>
                <separator/>
                <filter string="Exceptions" name="exceptions" domain="[('state', '=', 'exception')]"/>
                <filter string="Price exceptions" name="price_exc" domain="[('line_ids.price_exception', '=', True)]"/>
                <filter string="Receipt exceptions" name="receipt_exc" domain="[('line_ids.match_status', 'in', ('over', 'unordered', 'unidentified'))]"/>
                <filter string="To apply" name="to_apply" domain="[('state', 'in', ('identified', 'matched'))]"/>
                <filter string="Applied" name="applied" domain="[('state', '=', 'applied')]"/>
                <group>
                    <filter string="Vendor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_vendor_document_intake_line_price_list" model="ir.ui.view">
        <field name="name">vendor.document.intake.line.price.list</field>
        <field name="model">vendor.document.intake.line</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="product_id"/>
                <field name="description"/>
                <field name="qty_document"/>
                <field name="price_unit"/>
                <field name="price_reference"/>
                <field name="price_variance"/>
                <field name="price_variance_pct"/>
                <field name="price_exception"/>
                <field name="price_decision"/>
                <button name="action_accept_document_price" type="object" string="Accept document"/>
                <button name="action_keep_po_price" type="object" string="Keep PO"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_document_intake" model="ir.actions.act_window">
        <field name="name">Vendor documents</field>
        <field name="res_model">vendor.document.intake</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_apply': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No parsed vendor documents yet</p>
            <p>Point Parseur to POST https://YOUR-HOST/parseur/vendor/intake with the webhook token from Purchase settings.</p>
        </field>
    </record>

    <menuitem id="menu_vendor_document_intake"
              name="Parsed documents"
              parent="purchase.menu_purchase_root"
              action="action_vendor_document_intake"
              sequence="25"/>
</odoo>
