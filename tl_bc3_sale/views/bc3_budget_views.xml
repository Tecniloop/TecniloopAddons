<odoo>
    <record id="view_bc3_budget_form_inherit_sale" model="ir.ui.view">
        <field name="name">bc3.budget.form.inherit.sale</field>
        <field name="model">bc3.budget</field>
        <field name="inherit_id" ref="tl_bc3_budget.view_bc3_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_sale_order" string="Crear presupuesto de venta" type="object" class="btn-primary" invisible="state != 'ready'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_sale_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
                    <field name="sale_order_count" widget="statinfo" string="Presupuestos de venta"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Presupuestos de venta">
                    <field name="sale_order_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name" string="Presupuesto"/>
                            <field name="partner_id" string="Cliente"/>
                            <field name="date_order" string="Fecha"/>
                            <field name="amount_untaxed" string="Base imponible"/>
                            <field name="amount_total" string="Total"/>
                            <field name="state" string="Estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
