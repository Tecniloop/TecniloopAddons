<odoo>
    <record id="view_order_form_inherit_bc3" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bc3</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_fill_from_bc3_budget" string="Rellenar desde BC3" type="object" class="btn-secondary" invisible="not bc3_budget_id or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//sheet//div[@name='button_box']" position="inside">
                <button name="action_open_bc3_budget" type="object" class="oe_stat_button" icon="fa-list" invisible="not bc3_budget_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Presupuesto BC3</span>
                    </div>
                </button>
                <button name="action_open_bc3_file" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not bc3_file_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Fichero BC3</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="bc3_budget_id" string="Presupuesto BC3"/>
                <field name="bc3_file_id" string="Fichero BC3" readonly="1"/>
                <field name="bc3_generated_from_budget" string="Generado desde BC3" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="BC3" invisible="not bc3_budget_id">
                    <group string="Origen BC3">
                        <field name="bc3_budget_id" string="Presupuesto BC3" readonly="1"/>
                        <field name="bc3_file_id" string="Fichero BC3" readonly="1"/>
                        <field name="bc3_generated_from_budget" string="Generado desde BC3" readonly="1"/>
                    </group>
                    <field name="order_line" readonly="1" nolabel="1">
                        <list>
                            <field name="sequence"/>
                            <field name="bc3_code" string="Código BC3"/>
                            <field name="bc3_line_type" string="Tipo BC3"/>
                            <field name="name" string="Descripción"/>
                            <field name="product_uom_qty" string="Cantidad"/>
                            <field name="price_unit" string="Precio"/>
                            <field name="price_subtotal" string="Subtotal"/>
                            <field name="bc3_budget_line_id" string="Línea BC3"/>
                            <field name="bc3_sync_state" string="Estado sincronización"/>
                            <field name="bc3_certified_qty" string="Cantidad certificada"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='name']" position="after">
                <field name="bc3_code" string="Código BC3" optional="hide"/>
                <field name="bc3_line_type" string="Tipo BC3" optional="hide"/>
                <field name="bc3_sync_state" string="Estado sincronización" optional="hide"/>
                <field name="bc3_certified_qty" string="Cantidad certificada" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
