<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="main_menu_custom">
        <div class="o_stock_barcode_main_menu_container o_home_menu_background vh-100 w-100 d-flex flex-column">
            <div class="o_stock_barcode_main_menu position-absolute top-50 start-50 translate-middle bg-view p-4 w-75 h-54 rounded">
                <div>
                    <a href="#" class="o_stock_barcode_menu d-block float-start" t-on-click="() => this.home.toggle(true)"
                       style="color: #453e3e;">
                        <b><i class="oi oi-chevron-left"></i> Identifícate </b>
                    </a>
                </div>
                <br/>
                <br/>
                <div class="d-flex justify-content-center">
                    <span class="fw-bold fs-5 text-center">
                        Pon tu número PIN para iniciar las operaciones.<br/>
                        Si no lo sabes, consulta a tu supervisor.
                    </span>
                </div>
                <br/>
                <div class="d-flex justify-content-center">
                    <input type="password" t-model="state.manualInput"
                           class="o_numeric_input form-control text-center fs-4 fw-bold mb-2 w-50 p-3"
                           maxlength="6"
                           placeholder="••••••"/>
                </div>
                <div class="d-flex justify-content-center mt-2">
                    <div t-if="state.errorMessage" class="alert alert-danger w-50 text-center">
                        <t t-esc="state.errorMessage"/>
                    </div>
                </div>
                <br/>

                <!-- Teclado Numérico -->
                <div class="o_pos_keypad container">
                    <div class="row mb-2">
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('1')">1</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('2')">2</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('3')">3</button></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('4')">4</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('5')">5</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('6')">6</button></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('7')">7</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('8')">8</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('9')">9</button></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 d-grid"><button class="btn btn-dark fs-3" t-on-click="() => this._clearInput()">⌫</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-light fs-3" t-on-click="() => this._addDigit('0')">0</button></div>
                        <div class="col-4 d-grid"><button class="btn btn-primary fs-3" t-on-click="() => this._submitBarcode()">✔</button></div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>


