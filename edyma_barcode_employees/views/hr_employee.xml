<odoo>
    <record id="view_employee_form_aplication" model="ir.ui.view">
        <field name="name">hr.employee.form.aplication</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="application_code_barcode"/>
            </xpath>
        </field>
    </record>

</odoo>
