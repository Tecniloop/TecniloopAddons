<odoo>
    <record id="mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="employee_id"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="employee_id"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_filter_inherit" model="ir.ui.view">
        <field name="name">mrp.production.filter.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='date']" position="after">
                <filter string="Empleado" name="employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                <filter name="employee_id" string="Empleado" domain="[('employee_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
