<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiebdc_manufacturer_list" model="ir.ui.view">
        <field name="name">fiebdc.manufacturer.list</field>
        <field name="model">fiebdc.manufacturer</field>
        <field name="arch" type="xml">
            <list string="Fabricantes BC3">
                <field name="name"/>
                <field name="bc3_url"/>
                <field name="bc3_filename"/>
                <field name="allow_insecure_ssl"/>
                <field name="max_bc3_download_size_mb"/>
                <field name="max_related_file_size_mb"/>
                <field name="default_product_type"/>
                <field name="update_existing"/>
                <field name="last_import_date"/>
                <field name="last_import_batch_id"/>
            </list>
        </field>
    </record>

    <record id="view_fiebdc_manufacturer_form" model="ir.ui.view">
        <field name="name">fiebdc.manufacturer.form</field>
        <field name="model">fiebdc.manufacturer</field>
        <field name="arch" type="xml">
            <form string="Fabricante BC3">
                <header>
                    <button name="action_preview" type="object" string="Vista previa" class="btn-secondary"/>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_last_import_batch"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="not last_import_batch_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ultima</span>
                                <span class="o_stat_text">importacion</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                            <field name="bc3_url" placeholder="https://fabricante.example/catalogo.bc3, .zip o .rar"/>
                            <field name="bc3_filename" placeholder="Opcional: catalogo.bc3"/>
                            <field name="allow_insecure_ssl"/>
                            <field name="max_bc3_download_size_mb"/>
                            <field name="max_related_file_size_mb"/>
                        </group>
                        <group>
                            <field name="last_import_date" readonly="1"/>
                            <field name="last_import_batch_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Opciones de importacion">
                            <group string="Import Options" col="4">
                                <field name="update_existing"/>
                                <field name="default_product_type"/>
                                <field name="track_inventory" invisible="default_product_type != 'consu'"/>
                                <field name="import_type_4"/>
                                <field name="import_type_5"/>
                                <field name="import_images"/>
                                <field name="set_first_image"/>
                                <field name="overwrite_image"/>
                                <field name="import_attachments"/>
                                <field name="skip_duplicate_attachments"/>
                                <field name="dry_run"/>
                                <field name="import_batch_size"/>
                            </group>
                        </page>
                        <page string="Vista previa">
                            <field name="preview_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <record id="action_fiebdc_manufacturer" model="ir.actions.act_window">
        <field name="name">Fabricantes BC3</field>
        <field name="res_model">fiebdc.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
