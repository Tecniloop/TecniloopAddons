<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiebdc_import_batch_list" model="ir.ui.view">
        <field name="name">fiebdc.import.batch.list</field>
        <field name="model">fiebdc.import.batch</field>
        <field name="arch" type="xml">
            <list string="FIEBDC Imports">
                <field name="create_date"/>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="bc3_filename"/>
                <field name="state"/>
                <field name="batch_size"/>
                <field name="processed_concepts"/>
                <field name="pending_concepts"/>
                <field name="importable_concepts"/>
                <field name="created_products"/>
                <field name="updated_products"/>
                <field name="attachments_created"/>
                <field name="warning_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_fiebdc_import_batch_form" model="ir.ui.view">
        <field name="name">fiebdc.import.batch.form</field>
        <field name="model">fiebdc.import.batch</field>
        <field name="arch" type="xml">
            <form string="FIEBDC Import">
                <header>
                    <button name="action_process_next_chunk" type="object" string="Procesar siguiente lote" class="btn-primary" invisible="state not in ('queued', 'partial', 'running')"/>
                    <button name="action_process_ten_chunks" type="object" string="Procesar 10 lotes" class="btn-secondary" invisible="state not in ('queued', 'partial', 'running')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,running,partial,done,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="manufacturer_id"/>
                            <field name="zip_filename"/>
                            <field name="bc3_url"/>
                            <field name="bc3_url_base"/>
                            <field name="bc3_filename"/>
                            <field name="bc3_encoding"/>
                            <field name="source_attachment_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="batch_size"/>
                            <field name="total_concepts"/>
                            <field name="importable_concepts"/>
                            <field name="processed_concepts"/>
                            <field name="pending_concepts"/>
                            <field name="created_products"/>
                            <field name="updated_products"/>
                            <field name="skipped_products"/>
                            <field name="attachments_created"/>
                            <field name="warning_count"/>
                            <field name="error_count"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lineas">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="state"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="attachment_count"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="level"/>
                                    <field name="bc3_code"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True"/>
            </form>
        </field>
    </record>

    <record id="action_fiebdc_import_batch" model="ir.actions.act_window">
        <field name="name">FIEBDC Import History</field>
        <field name="res_model">fiebdc.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
