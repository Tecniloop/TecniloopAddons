msgstr ""
"Project-Id-Version: Odoo Server 19.0\n"
"PO-Revision-Date: 2026-08-11 00:00+0000\n"
"Last-Translator: Ecmr DeCA contributors\n"
"Language-Team: Spanish\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "DeCA PAdES Signer"
msgstr "Firmante PAdES del DeCA"
msgid "DeCA signature profile"
msgstr "Perfil de firma del DeCA"
msgid "PAdES B-B"
msgstr "PAdES B-B"
msgid "PAdES B-T with trusted timestamp"
msgstr "PAdES B-T con sello de tiempo de confianza"
msgid "DeCA timestamp authority URL"
msgstr "URL de la autoridad de sellado de tiempo del DeCA"
msgid "Required contractual signatures"
msgstr "Firmas contractuales requeridas"
msgid "Contractual shipper"
msgstr "Cargador contractual"
msgid "Effective carrier"
msgstr "Transportista efectivo"
msgid "Contractual shipper and effective carrier"
msgstr "Cargador contractual y transportista efectivo"
msgid "Shipper signing company"
msgstr "Compañía firmante del cargador"
msgid "Carrier signing company"
msgstr "Compañía firmante del transportista"
msgid "PAdES profile"
msgstr "Perfil PAdES"
msgid "Timestamp authority"
msgstr "Autoridad de sellado de tiempo"
msgid "Only an authorized DeCA PAdES Signer may issue this document."
msgstr "Solo un firmante PAdES del DeCA autorizado puede emitir este documento."
msgid "Select at least one required signature party."
msgstr "Seleccione al menos una parte cuya firma sea requerida."
msgid "Configure one distinct signing company for every required party."
msgstr "Configure una compañía firmante distinta para cada parte requerida."
msgid "You may only use certificates of companies available in your current multi-company access."
msgstr "Solo puede usar certificados de compañías disponibles en su acceso multicompañía actual."
msgid "Configure an RFC 3161 timestamp authority URL for PAdES B-T."
msgstr "Configure una URL de autoridad de sellado de tiempo RFC 3161 para PAdES B-T."
msgid "The final PDF does not contain every required PAdES signature."
msgstr "El PDF final no contiene todas las firmas PAdES requeridas."
msgid "A contractual partner record is required for the %(role)s signature."
msgstr "Se requiere un contacto contractual para la firma de %(role)s."
msgid "B-T requires an RFC 3161 trusted timestamp service."
msgstr "B-T requiere un servicio de sellado de tiempo de confianza RFC 3161."
msgid "Contractual PDF signatures"
msgstr "Firmas contractuales del PDF"
msgid "DeCA PAdES"
msgstr "DeCA PAdES"
msgid "HTTPS endpoint of the RFC 3161 timestamp authority used for PAdES B-T."
msgstr "Punto de acceso HTTPS de la autoridad de sellado de tiempo RFC 3161 usada para PAdES B-T."
msgid "Odoo company whose active AEAT certificate signs for the contractual shipper. Its commercial partner must match the shipper."
msgstr "Compañía de Odoo cuyo certificado AEAT activo firma por el cargador contractual. Su contacto comercial debe coincidir con el cargador."
msgid "Odoo company whose active AEAT certificate signs for the effective carrier. Its commercial partner must match the carrier."
msgstr "Compañía de Odoo cuyo certificado AEAT activo firma por el transportista efectivo. Su contacto comercial debe coincidir con el transportista."
msgid "PAdES B-T embeds an RFC 3161 timestamp. Certificate trust, identity, revocation and AdES/QES legal qualification still require an independent validation policy."
msgstr "PAdES B-T incorpora un sello de tiempo RFC 3161. La confianza, identidad, revocación y cualificación jurídica AdES/QES del certificado aún requieren una política de validación independiente."
msgid "PAdES signing failed for %(company)s. No DeCA version was sealed."
msgstr "Falló la firma PAdES de %(company)s. No se selló ninguna versión del DeCA."
msgid "Required when the selected profile is PAdES B-T."
msgstr "Obligatoria cuando el perfil seleccionado es PAdES B-T."
msgid "Select the parties whose PAdES signatures must be embedded before the contractual DeCA version is sealed."
msgstr "Seleccione las partes cuyas firmas PAdES deben incorporarse antes de sellar la versión contractual del DeCA."
msgid "Signing company %(company)s does not match the contractual partner assigned to role %(role)s."
msgstr "La compañía firmante %(company)s no coincide con el contacto contractual asignado al rol %(role)s."
msgid "The %(role)s PAdES signature cannot be validated."
msgstr "No se puede validar la firma PAdES de %(role)s."
msgid "The %(role)s PAdES signature is not intact."
msgstr "La firma PAdES de %(role)s no está íntegra."
msgid "The active AEAT certificate files for %(company)s are not available on this Odoo worker."
msgstr "Los archivos del certificado AEAT activo de %(company)s no están disponibles en este proceso de Odoo."
msgid "The active AEAT certificate for %(company)s cannot be loaded by the PAdES engine."
msgstr "El motor PAdES no puede cargar el certificado AEAT activo de %(company)s."
msgid "The active AEAT certificate for %(company)s contains no usable signing key."
msgstr "El certificado AEAT activo de %(company)s no contiene una clave de firma utilizable."
msgid "The final PDF is missing the %(role)s signature."
msgstr "Falta la firma de %(role)s en el PDF final."
msgid "Distinct contractual parties cannot use the same signing certificate."
msgstr "Partes contractuales distintas no pueden usar el mismo certificado de firma."
msgid "Contractual issue embeds PAdES signatures before the final hash is calculated. Certificate possession alone does not prove AdES/QES qualification or authority to represent a party."
msgstr "La emisión contractual incorpora las firmas PAdES antes de calcular el hash final. La mera posesión del certificado no acredita la cualificación AdES/QES ni la facultad de representar a una parte."
msgid "The %(role)s PAdES B-T signature has no valid embedded RFC 3161 timestamp."
msgstr "La firma PAdES B-T de %(role)s no contiene un sello de tiempo RFC 3161 válido."
msgid "l10n_es_deca_ades requires Odoo 19 on Python 3.12 or newer. Use an external signing service on older Python runtimes."
msgstr "l10n_es_deca_ades requiere Odoo 19 sobre Python 3.12 o posterior. Use un servicio de firma externo en versiones anteriores de Python."
msgid "l10n_es_deca_ades requires pyHanko 0.24.x to remain compatible with the official Odoo 19 dependency pins."
msgstr "l10n_es_deca_ades requiere pyHanko 0.24.x para mantener la compatibilidad con las versiones de dependencias oficiales de Odoo 19."

msgid "Administrative only (no signature)"
msgstr "Solo administrativa (sin firma)"
msgid "Administrative and contractual (PAdES required)"
msgstr "Administrativa y contractual (PAdES obligatoria)"
msgid "Default DeCA purpose"
msgstr "Finalidad predeterminada del DeCA"
msgid "Default DeCA signature parties"
msgstr "Partes firmantes predeterminadas del DeCA"
msgid "Default shipper signing company"
msgstr "Compañía firmante predeterminada del cargador"
msgid "Default carrier signing company"
msgstr "Compañía firmante predeterminada del transportista"
msgid "Default document purpose"
msgstr "Finalidad predeterminada del documento"
msgid "Default contractual signers"
msgstr "Firmantes contractuales predeterminados"
msgid "Applied to new DeCA drafts for this operational company. Administrative drafts are not signed. Contractual drafts must be signed according to the default party policy before they can be issued."
msgstr "Se aplica a los nuevos borradores DeCA de esta compañía operativa. Los borradores administrativos no se firman. Los contractuales deben firmarse según la política predeterminada antes de emitirse."
msgid "Parties preselected on new DeCA drafts. This policy is enforced only when the document purpose is administrative and contractual."
msgstr "Partes preseleccionadas en los nuevos borradores DeCA. Esta política solo se aplica cuando la finalidad del documento es administrativa y contractual."
msgid "Company preselected to sign for the contractual shipper. Its commercial partner must match the shipper on the DeCA."
msgstr "Compañía preseleccionada para firmar por el cargador contractual. Su contacto comercial debe coincidir con el cargador del DeCA."
msgid "Company preselected to sign for the effective carrier. Its commercial partner must match the carrier on the DeCA."
msgstr "Compañía preseleccionada para firmar por el transportista efectivo. Su contacto comercial debe coincidir con el transportista del DeCA."
msgid "Administrative drafts are not signed. Contractual drafts require PAdES before issue. The default applies only to newly created drafts."
msgstr "Los borradores administrativos no se firman. Los contractuales requieren PAdES antes de emitirse. El valor predeterminado solo se aplica a borradores nuevos."
msgid "Preselect the parties and signing companies copied to every new draft. Operators may change them before issue."
msgstr "Preseleccione las partes y compañías firmantes que se copiarán a cada borrador nuevo. Los operadores pueden cambiarlas antes de la emisión."
