        <record id="email_template_sale_order_queue_error_user_id" model="mail.template">
            <field name="name">Enviar correo al comercial cuando hay una Incidencia</field>
            <field name="model_id" ref="sale.model_sale_order"/> 
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{object.user_id.email}}</field>
            <field name="subject">Incidencia en la creación de la Oferta/Pedido.</field>
            <field name="auto_delete">False</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <p>Hola <t t-out="object.user_id.name"/></p>
                        <p>
                            La oferta <t t-out="object.name"></t> 
                            del cliente <t t-out="object.partner_id.name"></t> 
                            a generado una Incidencia al ser procesada a la cola de a3ERP.
                            <p>Incidencia:
                                <p>
                                    <b><t t-out="object.a3erp_error_simple"></t></b>
                                </p>
                            </p>
                        </p>
                        <p>Por favor, revise la oferta.</p>
                        <br/>
                        Gracias,
                        <br/>
                        Administrador.
                    </div>
                </div>
            </field>
        </record>
    </data>
