<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">        
        <!-- SCHEDULED ACTION PARA AUTENTICACION-->
        <record id="ir_cron_authenticate" model="ir.cron">
            <field name="name">Web Service: Iniciar Sesion</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model.authentication_webservice()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">110</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')" />
            <field name="interval_type">minutes</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">1</field>
            <field name="active">True</field>
        </record>

        <!-- ACTION PARA ESTADO COLA GENERAL-->
        <record id="ir_cron_queue_state" model="ir.cron">
            <field name="name">Global: Consultar Estado Cola Peticiones</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="binding_model_id" ref="base.model_res_company" />
            <field name="state">code</field>
            <field name="code">
res_partners = env['res.partner'].search([('queue_state','in',('PENDIENTE','ERROR'))])
sale_orders = env['sale.order'].search([('queue_state','in',('PENDIENTE','ERROR'))])
purchase_orders = env['purchase.order'].search([('queue_state','in',('PENDIENTE','ERROR'))])
product_templates = env['product.template'].search([('queue_state','in',('PENDIENTE','ERROR'))])

for contact in res_partners:
    model.get_cola_state(contact)

for sale in sale_orders:
    model.get_cola_state(sale)

for purchase in purchase_orders:
    model.get_cola_state(purchase)

for product in product_templates:
    model.get_cola_state(product)
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
            <field name="interval_type">minutes</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">2</field>
        </record>
    </data>
    <record id="a3erp_res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.a3erp.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Conn. a3ERP" string="Conn. a3ERP" name="tl_conn_a3erp" groups="base.group_system">
                    <block title="Valores WebService" name="a3erp_conexion_container">
                        <setting id="a3erp_fields_url" string="URL" help="URL para conectar con el Web Service.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_url" required="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="a3erp_fields_company" string="ID Empresa" help="ID de la empresa de A3.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_company_id" required="1"/>
                                </div>  
                            </div>
                        </setting>
                        <setting id="a3erp_fields" string="Usuario y Contraseña" help="Usuario y contraseña para la conexión.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_user" required="1"/>                                
                                </div>
                                <div class="row mt16">
                                    <field name="a3erp_password" password="True" required="1"/>
                                </div>
                            </div>
                            <div class="mt16" groups="base.group_system">
                                <button name="authentication_webservice" type="object" 
                                invisible="not a3erp_user or not a3erp_password or not a3erp_url"
                                string="Iniciar Sesion" class="btn-primary"/>
                            </div>
                        </setting>
                        <setting id="a3erp_fields" string="Token" help="Token que se genera con la autenticación. Valido durante 2 horas.">
                            <field name="a3erp_token"/>
                        </setting>
                    </block>
                    <block title="Valores por Defecto" name="a3erp_default_values">
                        <setting id="a3erp_default_note" string="Artículo Nota" help="Artículo nota por defecto en las lineas de a3ERP.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_note_product_id" required="0"/>
                                </div>  
                            </div>
                        </setting>
                        <setting id="a3erp_default_section" string="Artículo Seccion" help="Artículo seccion por defecto en las lineas de a3ERP.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_section_product_id" required="0"/>
                                </div>  
                            </div>
                        </setting>
                        <setting id="a3erp_default_section_collap" string="Artículo Seccion Colapsado" help="Artículo opcional que se enviara cuando una seccion sea de tipo colapsado. Solo para casos especiales.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="a3erp_section_collapsed_product_id" required="0"/>
                                </div>  
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="a3erp_conn_action" model="ir.actions.act_window">
        <field name="name">a3ERP Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="a3erp_res_config_settings_view_form_inherit"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'tl_conn_a3erp', 'bin_size': False}</field>
    </record>
        
    <menuitem id="a3erp_settings_menu" name="Configuración" parent="tl_conn_a3erp.a3erp_base_menu" action="a3erp_conn_action" sequence="25" groups="tl_conn_a3erp.group_a3erp"/>
    
</odoo>
