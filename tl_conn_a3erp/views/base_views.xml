<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">        
        <!-- SCHEDULED ACTION PARA PROCESAR LOGS DE TARIFAS-->
        <record id="ir_cron_proces_logs_tarifas" model="ir.cron">
            <field name="name">Procesar RepLogs Tarifas</field>
            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="state">code</field>
            <field name="code">
values = env['a3erp.descuentos.af'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_descuentos_af(values)

values = env['a3erp.tarifas'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_tarifas(values)

values = env['a3erp.precios.esp'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_precios_esp(values)

values = env['a3erp.descuentos.ac'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_descuentos_ac(values)

values = env['a3erp.descuentos.ff'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_descuentos_ff(values)
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:00:00')" />
            <field name="interval_type">hours</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">1</field>
            <field name="active">True</field>
        </record>
    </data>
        <record id="product_pricelist_form_view_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.form</field>
            <field name="model">product.pricelist</field>
             <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">              
                <xpath expr="//notebook" position="inside">
                    <page string="Información a3ERP" name="informacion_a3erp">
                        <group>
                            <group string="Información">
                                <field name="partner_id" invisible="a3erp_pricelist_type in ('standard','descuentos_fam')" />
                                <field name="a3erp_pricelist_code" readonly="1" invisible="a3erp_pricelist_type in ('descuentos_ac','precios_esp')"/>
                                <field name="last_date_update" />
                            </group>
                            <group string="Tipo de Tarifa">
                                <field name="a3erp_pricelist_type" widget="radio" />
                                <!-- <field name="a3erp_discount_fam_type" invisible="a3erp_pricelist_type != 'descuentos_fam'" widget="radio" /> -->
                            </group>
                        </group>
                    </page>                    
                </xpath>                
            </field>
        </record>
    <data noupdate="1">
        <!-- SCHEDULED ACTION PARA PROCESAR LOGS DE FAMILIAS-->
        <record id="ir_cron_proces_logs_category" model="ir.cron">
            <field name="name">Procesar RepLogs Familias</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="state">code</field>
            <field name="code">
values = env['a3erp.familias'].search([('procesado','=', False),('fichero','=','Estadis')])
if values:
    model.process_replogs_familias(values)

# Eliminar las familias que no son de productos
values_to_delete = env['a3erp.familias'].search([('fichero','!=','Estadis')])
if values_to_delete:
    values_to_delete.unlink()
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:05:00')" />
            <field name="interval_type">days</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">1</field>
            <field name="active">True</field>
        </record>
    </data> 
        <record id="product_category_form_view_inherit" model="ir.ui.view">
            <field name="name">product.category.form</field>
            <field name="model">product.category</field>
             <field name="inherit_id" ref="product.product_category_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']" position="after">
                    <h3>
                        <label for="a3erp_category_code" string="Codigo Categoria a3ERP"/>
                        <field name="a3erp_category_code" readonly="1"/>
                    </h3>
                    <label for="last_date_update" string="Fecha Última Actualización"/>
                    <field name="last_date_update" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_tax_form_inherit" model="ir.ui.view">
            <field name="name">account.tax.form</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form" />
            <field name="arch" type="xml">
                <field name="active" position="after">
                    <field name="a3erp_iva_code" readonly="1"/>
                    <field name="last_date_update" readonly="1"/>
                </field>
            </field>
        </record>
        <data noupdate="1">
            <!-- SCHEDULED ACTION PARA PROCESAR DOCUMENTOS DE PAGO-->
            <record id="ir_cron_proces_logs_docupago" model="ir.cron">
                <field name="name">Procesar RepLogs Documentos Pago</field>
                <field name="model_id" ref="account_payment_mode.model_account_payment_mode"/>
                <field name="state">code</field>
                <field name="code">
values = env['a3erp.docupago'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_payment_mode(values)
                </field>
                <field name="user_id" ref="base.user_root"/>
                <field name="interval_number">1</field>
                <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:15:00')" />
                <field name="interval_type">days</field>
                <!-- <field name="numbercall">-1</field> -->
                <field name="priority">1</field>
                <field name="active">True</field>
            </record>
        </data> 
        <record id="account_payment_mode_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.mode</field>
            <field name="model">account.payment.mode</field>
            <field name="inherit_id" ref="account_payment_mode.account_payment_mode_form" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="a3erp_payment_mode_code" readonly="1"/>
                    <field name="last_date_update" readonly="1"/>
                </field>
            </field>
        </record>
        <data noupdate="1">
            <!-- SCHEDULED ACTION PARA PROCESAR FORMAS DE PAGO-->
            <record id="ir_cron_proces_logs_formapago" model="ir.cron">
                <field name="name">Procesar RepLogs Formas Pago</field>
                <field name="model_id" ref="account.model_account_payment_term"/>
                <field name="state">code</field>
                <field name="code">
values = env['a3erp.formapago'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_payment_term(values)
                </field>
                <field name="user_id" ref="base.user_root"/>
                <field name="interval_number">1</field>
                <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:20:00')" />
                <field name="interval_type">days</field>
                <!-- <field name="numbercall">-1</field> -->
                <field name="priority">1</field>
                <field name="active">True</field>
            </record>
        </data> 
        <record id="view_payment_term_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.term</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet/group[1]/field[@name='company_id']" position="before">
                    <field name="a3erp_payment_term_code" readonly="1"/>
                    <field name="last_date_update" readonly="1"/>
                </xpath>
            </field>
        </record>
        
        <!--CONTABILIDAD ANALITICA
        <record id="account_analytic_distribution_model_form_view_inherit" model="ir.ui.view">
            <field name="name">account.analytic.distribution.model.form</field>
            <field name="model">account.analytic.distribution.model</field>
            <field name="inherit_id" ref="analytic.account_analytic_distribution_model_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//group/group[1]/group[1]" position="inside">
                    <field name="last_date_update" readonly="1"/>
                </xpath>
            </field>
        </record>-->
        <data noupdate="1">
            <!-- SCHEDULED ACTION PARA PROCESAR CENTROS DE COSTE-->
            <record id="ir_cron_proces_logs_centrosc" model="ir.cron">
                <field name="name">Procesar RepLogs Centros Coste</field>
                <field name="model_id" ref="analytic.model_account_analytic_account"/>
                <field name="state">code</field>
                <field name="code">
values = env['a3erp.centrosc'].search([('procesado','=', False)])
if values:
    model.process_rep_logs_analytic_account(values)
                </field>
                <field name="user_id" ref="base.user_root"/>
                <field name="interval_number">2</field>
                <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:00:00')" />
                <field name="interval_type">days</field>
                <!-- <field name="numbercall">-1</field> -->
                <field name="priority">1</field>
                <field name="active">True</field>
            </record>
        </data>
        <record id="view_account_analytic_account_form_inherit" model="ir.ui.view">
            <field name="name">account.analytic.account.form</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="last_date_update" readonly="1"/>
                </field>
            </field>
        </record>
        
    
</odoo>