<odoo>
    <data noupdate="1">
        <!-- SCHEDULED ACTION PARA PROCESAR LOGS DE CARACTERISTICAS-->
        <record id="ir_cron_proces_logs_cargos" model="ir.cron">
            <field name="name">Procesar RepLogs Cargos</field>
            <field name="model_id" ref="tl_conn_a3erp.model_res_cargos" />
            <field name="state">code</field>
            <field name="code">
values = env['a3erp.cargos'].search([('procesado','=', False)])
if values:
    model.process_replogs_cargos(values)
            </field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">2</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 23:45:00')" />
            <field name="interval_type">days</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">1</field>
            <field name="active">True</field>
        </record>
    </data> 
    <record id="res_cargos_action" model="ir.actions.act_window">
        <field name="name">Cargos</field>
        <field name="res_model">res.cargos</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="context">{'search_default_tip_carac': 1, 'search_default_num_carac': 1}</field> -->
    </record>  

    <record id="res_cargos_form_view" model="ir.ui.view">
        <field name="name">res.cargos.form.view</field>
        <field name="model">res.cargos</field>
        <field name="arch" type="xml">
            <form string="Cargos" create="true" edit="true">
                <sheet>
                    <group>
                        <group>
                            <field name="id_cargo" readonly="1"/>
                            <field name="cod_cargo" readonly="1"/>
                            <field name="desc_cargo" />
                            <field name="observaciones" />
                            <field name="last_date_update" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_cargos_tree_view" model="ir.ui.view">
        <field name="name">res.cargos.view.tree</field>
        <field name="model">res.cargos</field>
        <field name="arch" type="xml">
            <list string="" create="False">
                <field name="id_cargo" />
                <field name="cod_cargo" />
                <field name="desc_cargo" />
                <field name="observaciones" />
                <field name="company_id" />
            </list>
        </field>
    </record>
    
    <record id="res_cargos_search_view" model="ir.ui.view">
        <field name="name">res.cargos.search</field>
        <field name="model">res.cargos</field>
        <field name="arch" type="xml">
            <search>
                <field name="cod_cargo"/>
                <field name="desc_cargo"/>
            </search>
        </field>
    </record>  

    
    <menuitem name="Cargos" id="res_cargos" parent="a3erp_auxiliar" action="res_cargos_action" sequence="5"/>
</odoo>
