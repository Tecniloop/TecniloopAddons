<odoo>
    <data noupdate="1">
     <!-- SCHEDULED ACTION PARA IMPORTAR REP LOGS TRADUCCIONES -->
     <record id="ir_cron_get_logs_idioma" model="ir.cron">
        <field name="name">Importar RepLogs Traducciones</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_idioma"/>
        <field name="state">code</field>
        <field name="code">model.get_rep_logs_idioma()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 22:15:00')" />
        <field name="interval_type">days</field>
        <!--<field name="numbercall">-1</field>-->
        <field name="priority">2</field>
        <field name="active">True</field>
    </record>

    <!-- SERVER ACTION PARA IMPORTAR TRAUCCIONES -->
    <record id="server_action_import_traducciones" model="ir.actions.server">
        <field name="name">a3ERP: Importar Direcciones entrega</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_idioma" />
        <field name="state">code</field>
        <field name="code">model.getall_traducciones()</field>
    </record>
    </data>
    <record id="a3erp_idioma_action" model="ir.actions.act_window">
        <field name="name">Traducciones</field>
        <field name="res_model">a3erp.idioma</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1, 'search_default_codart': 1}</field>
    </record>  

    <record id="a3erp_idioma_form_view" model="ir.ui.view">
        <field name="name">a3erp.idioma.form.view</field>
        <field name="model">a3erp.idioma</field>
        <field name="arch" type="xml">
            <form string="Traducciones" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="codart" readonly="1"/>
                            <field name="descart" readonly="1"/>
                            <field name="texto" readonly="1"/>
                            <field name="codidioma" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_idioma_tree_view" model="ir.ui.view">
        <field name="name">a3erp.idioma.view.tree</field>
        <field name="model">a3erp.idioma</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="codart" optional="show"/>
                <field name="descart" optional="show"/>
                <field name="texto" optional="show"/>
                <field name="codidioma" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_idioma_search_view" model="ir.ui.view">
        <field name="name">a3erp.idioma.search</field>
        <field name="model">a3erp.idioma</field>
        <field name="arch" type="xml">
            <search>
                <field name="codart"/>
                <field name="descart"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Articulo" name="codart" context="{'group_by': 'codart'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  

    <menuitem name="Traducciones" id="a3erp_idioma" parent="a3erp_base_productos" action="a3erp_idioma_action" sequence="5"/>
    <!-- <menuitem name="Traducciones" id="import_a3erp_traducciones" parent="a3erp_importar"
        action="server_action_import_traducciones" sequence="26" /> -->
</odoo>