<odoo>
    <data noupdate="1">
        <!-- SCHEDULED ACTION LOGS PRODUCTOS -->
        <record id="ir_cron_get_logs_productos" model="ir.cron">
            <field name="name">Importar RepLogs Productos</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_productos"/>
            <field name="state">code</field>
            <field name="code">model.get_rep_logs_productos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
            <field name="interval_type">days</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">2</field>
            <field name="active">True</field>
        </record>     

        <!-- SERVER ACTION PARA IMPORTAR PRODUCTOS -->
        <record id="server_action_import_productos" model="ir.actions.server">
            <field name="name">a3ERP: Importar Productos</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_productos" />
            <field name="state">code</field>
            <field name="code">model.getall_products()</field>
        </record>
        
        <record id="a3erp_productos_action" model="ir.actions.act_window">
            <field name="name">Productos</field>
            <field name="res_model">a3erp.productos</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_movimiento': 1}</field>
        </record>  
    </data> 

    <record id="a3erp_productos_form_view" model="ir.ui.view">
        <field name="name">a3erp.productos.form.view</field>
        <field name="model">a3erp.productos</field>
        <field name="arch" type="xml">
            <form string="Productos" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                            <field name="bloqueado" readonly="1"/>
                            <field name="obsoleto" readonly="1"/>
                            <field name="codart" readonly="1"/>
                            <field name="descart" readonly="1"/>
                            <field name="artpro" readonly="1"/>
                            <field name="texto" readonly="1"/>
                            <field name="prccoste" readonly="1"/>
                            <field name="prcventa" readonly="1"/>
                            <field name="margen" readonly="1"/>
                            <field name="codfamest" readonly="1"/>
                            <field name="tipiva" readonly="1"/>
                        </group>
                        <group>
                            <field name="apen_mesprifac" readonly="1"/>
                            <field name="apen_codartcont" readonly="1"/>
                            <field name="analitica_1" readonly="1"/>
                            <field name="analitica_2" readonly="1"/>
                            <field name="analitica_3" readonly="1"/>
                            <field name="afecta_stock" readonly="1"/>
                            <field name="hay_num_serie" readonly="1"/>
                            <field name="imagen" readonly="1"/>
                        </group>
                        <group string="CARACTERISTICAS">
                            <field name="car1" readonly="1"/>
                            <field name="car2" readonly="1"/>
                            <field name="car3" readonly="1"/>
                            <field name="car4" readonly="1"/>
                            <field name="car5" readonly="1"/>
                            <field name="car6" readonly="1"/>
                            <field name="car7" readonly="1"/>
                            <field name="car8" readonly="1"/>
                            <field name="car9" readonly="1"/>
                            <field name="car10" readonly="1"/>
                        </group>
                        <group string="PARAMETRIZABLES">
                            <field name="param1" readonly="1" />
                            <field name="param2" readonly="1" />
                            <field name="param3" readonly="1" />
                            <field name="param4" readonly="1" />
                            <field name="param5" readonly="1" />
                            <field name="param6" readonly="1" />
                            <field name="param7" readonly="1" />
                            <field name="param8" readonly="1" />
                            <field name="param9" readonly="1" />
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <record id="a3erp_productos_tree_view" model="ir.ui.view">
        <field name="name">a3erp.productos.view.tree</field>
        <field name="model">a3erp.productos</field>
        <field name="arch" type="xml">
            <list string="" create="false"
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="bloqueado" optional="show"/>
                <field name="codart" optional="show"/>
                <field name="descart" optional="show"/>
                <field name="artpro" optional="show"/>
                <field name="texto" optional="hide"/>
                <field name="prccoste" optional="show"/>
                <field name="prcventa" optional="show"/>
                <field name="margen" optional="show"/>
                <field name="codfamest" optional="show"/>
                <field name="tipiva" optional="show"/>
                <field name="car1" optional="hide"/>
                <field name="car2" optional="hide"/>
                <field name="car3" optional="hide"/>
                <field name="car4" optional="hide"/>
                <field name="car5" optional="hide"/>
                <field name="apen_mesprifac" optional="show"/>
                <field name="apen_codartcont" optional="show"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="a3erp_productos_search_view" model="ir.ui.view">
        <field name="name">a3erp.productos.search</field>
        <field name="model">a3erp.productos</field>
        <field name="arch" type="xml">
            <search>
                <field name="codart"/>
                <field name="descart"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Producto" name="codart" context="{'group_by': 'codart'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  
        
    <menuitem name="Productos" id="a3erp_base_productos" parent="a3erp_replogs" sequence="10"/>
    <menuitem name="Productos" id="a3erp_productos" parent="a3erp_base_productos" action="a3erp_productos_action" sequence="1"/>
    <!-- <menuitem name="Productos" id="import_a3erp_productos" parent="a3erp_importar"
        action="server_action_import_productos" sequence="25" /> -->

</odoo>