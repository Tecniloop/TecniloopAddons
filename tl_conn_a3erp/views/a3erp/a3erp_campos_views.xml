<odoo>
    
    <record id="a3erp_campos_action" model="ir.actions.act_window">
        <field name="name">Campos</field>
        <field name="res_model">a3erp.campos</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_table_name': 1}</field>
    </record>  

    <record id="a3erp_product_form_view" model="ir.ui.view">
        <field name="name">a3erp.campos.view.form</field>
        <field name="model">a3erp.campos</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                            <field name="mandatory_field" widget="boolean_toggle"/>
                            <field name="table_name" required="1"/>
                            <field name="line_field_use" invisible="table_name != 'lineofer'" />
                            <field name="odoo_field_name" required="not default_value or field_use in ('a3erp-odoo',False)"/>
                            <field name="mapped_name" invisible="field_use in ('odoo-a3erp')" required="not default_value and field_use in ('a3erp-odoo',False)"/>
                            <field name="a3erp_field_name" required="not default_value or field_use in ('odoo-a3erp',False)"/>
                            <field name="default_value"/>
                        </group>
                        <group>
                            <field name="field_use"/>
                            <field name="relational_table"/>
                            <field name="table_code" required="relational_table"/>
                        </group>
                        <group>
                            <field name="company_id"/>                            
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>   

    <record id="a3erp_product_tree_view" model="ir.ui.view">
        <field name="name">a3erp.campos.view.tree</field>
        <field name="model">a3erp.campos</field>
        <field name="arch" type="xml">
            <list string="" create="true">
                <field name="sequence" widget="handle"/>
                <field name="mandatory_field" widget="boolean_toggle"/>
                <field name="table_name"/>
                <field name="odoo_field_name"/>
                <field name="mapped_name"/>
                <field name="a3erp_field_name"/>
                <field name="default_value"/>
                <field name="field_use"/>
                <field name="relational_table"/>
                <field name="table_code"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>   
    
    <record id="a3erp_product_search_view" model="ir.ui.view">
        <field name="name">a3erp.campos.search</field>
        <field name="model">a3erp.campos</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="odoo_field_name" string="Campo de Odoo"/>
                <field name="a3erp_field_name" string="Campo de a3ERP"/>
                <filter name="active" string="Activo" domain="[('active','=', True)]"/>
                <filter name="active" string="Archivado" domain="[('active','=', False)]"/>
                <separator/>
                <filter name="CLIENTES" string="Clientes" domain="[('table_name','=','clientes')]"/>
                <filter name="DIRENT" string="Direcciones Entrega" domain="[('table_name','=','dirent')]"/>
                <filter name="PROVEEDORES" string="Proveed" domain="[('table_name','=','proveed')]"/>
                <filter name="CONTACTOS" string="Contactos" domain="[('table_name','=','contactos')]"/>
                <filter name="REFPRO" string="Refpro" domain="[('table_name','=','refpro')]"/>
                <filter name="IDIOMA" string="Idioma" domain="[('table_name','=','idioma')]"/>
                <filter name="PRODUCTOS" string="Productos" domain="[('table_name','=','productos')]"/>
                <filter name="FAMILIAESTADISTICA" string="Familias Est." domain="[('table_name','=','familiaest')]"/>
                <filter name="CABEOFEV" string="Cabecera Oferta" domain="[('table_name','=','cabeofev')]"/>
                <filter name="CABEPEDV" string="Cabecera Pedido" domain="[('table_name','=','cabepedv')]"/>
                <filter name="LINEOFER" string="Lineofer" domain="[('table_name','=','lineofer')]"/>
                <filter name="TARIFAS" string="Tarifas" domain="[('table_name','=','tarifas')]"/>
                <filter name="PRECIOSESP" string="Precios Especiales" domain="[('table_name','=','precios_esp')]"/>
                <filter name="DESCUENTOSAC" string="Descuentos AC" domain="[('table_name','=','descuentos_ac')]"/>
                <filter name="DESCUENTOSFAM" string="Descuentos AF" domain="[('table_name','=','descuentos_fam')]"/>
                <filter name="DESCUENTOSCF" string="Descuentos CF" domain="[('table_name','=','descuentos_cf')]"/>
                <filter name="DIRECCIONESENT" string="Direcciones entrega" domain="[('table_name','=','dirent')]"/>
                <filter name="CARACTERISTICAS" string="Caracteristicas" domain="[('table_name','=','caracteristicas')]"/>
                <filter name="DOCUPAGO" string="Documentos de Pago" domain="[('table_name','=','docupago')]"/>
                <filter name="FORMAPAG" string="Formas de Pago" domain="[('table_name','=','formapag')]"/>
                <filter name="CARGOS" string="Cargos" domain="[('table_name','=','cargos')]"/>
                <filter name="ALARMAS" string="Alarmas" domain="[('table_name','=','alarmas')]"/>
                <filter name="CENTROSC" string="Centros de Coste" domain="[('table_name','=','centrosc')]"/>
                <filter name="OPCIONALES" string="Prod. Opcionales" domain="[('table_name','=','opcionales')]"/>
                <filter name="IDIOMA" string="Traducciones" domain="[('table_name','=','idioma')]"/>
                <group>
                    <filter string="Tabla" name="table_name" context="{'group_by': 'table_name'}"/>
                </group>                
            </search>
        </field>
    </record>    
        
    <menuitem name="Mapeado Campos" id="a3erp_campos" parent="a3erp_base_menu" action="a3erp_campos_action" sequence="10" groups="tl_conn_a3erp.group_a3erp"/>
</odoo>
