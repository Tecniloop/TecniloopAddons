<odoo>
    <data noupdate="1">
    <!-- SCHEDULED ACTION LOGS FAMILIAS -->
    <record id="ir_cron_get_logs_familias" model="ir.cron">
        <field name="name">Importar RepLogs Familias Estadisticas</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_familias"/>
        <field name="state">code</field>
        <field name="code">model.get_rep_logs_familias()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">2</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 22:05:00')" />
        <field name="interval_type">days</field>
        <!--<field name="numbercall">-1</field>-->
        <field name="priority">2</field>
        <field name="active">True</field>
    </record>

    <!-- SERVER ACTION PARA IMPORTAR FAMILIAS -->
    <record id="server_action_import_a3erp_familias" model="ir.actions.server">
        <field name="name">a3ERP: Importar Familias</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_familias" />
        <field name="state">code</field>
        <field name="code">model.getall_familias()</field>
    </record>
    </data> 
    <record id="a3erp_familias_action" model="ir.actions.act_window">
        <field name="name">Familias Estadisticas</field>
        <field name="res_model">a3erp.familias</field>
        <field name="view_mode">list,form</field>
    </record>  

    <record id="a3erp_familias_form_view" model="ir.ui.view">
        <field name="name">a3erp.familias.form.view</field>
        <field name="model">a3erp.familias</field>
        <field name="arch" type="xml">
            <form string="Familias Estadisticas" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="codigo" readonly="1"/>
                            <field name="nombre" readonly="1"/>           
                            <field name="fichero" readonly="1"/>           
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <record id="a3erp_familias_tree_view" model="ir.ui.view">
        <field name="name">a3erp.familias.view.tree</field>
        <field name="model">a3erp.familias</field>
        <field name="arch" type="xml">
            <list string="" create="false"
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="codigo" optional="show"/>
                <field name="nombre" optional="show"/>      
                <field name="fichero" optional="show"/>      
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="a3erp_familias_search_view" model="ir.ui.view">
        <field name="name">a3erp.familias.search</field>
        <field name="model">a3erp.familias</field>
        <field name="arch" type="xml">
            <search>
                <field name="codigo"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Familia" name="codigo" context="{'group_by': 'codigo'}"/>
                    <filter string="Fichero" name="fichero" context="{'group_by': 'fichero'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  
    
    <menuitem name="Familias" id="a3erp_base_familias" parent="a3erp_replogs" sequence="10"/>
    <menuitem name="Familias" id="a3erp_familias" parent="a3erp_base_familias" action="a3erp_familias_action" sequence="1"/>
    <!-- <menuitem name="Familias Estadisticas" id="import_a3erp_familias" parent="a3erp_importar"
        action="server_action_import_a3erp_familias" sequence="24" /> -->
</odoo>