<odoo>
    <data noupdate="1">
        <!-- SCHEDULED ACTION IMPORTAR REP LOGS CLIENTES-->
        <record id="ir_cron_get_logs_clientes" model="ir.cron">
            <field name="name">Importar RepLogs Clientes</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_clientes"/>
            <field name="state">code</field>
            <field name="code">model.get_rep_logs_clientes()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:00:00')" />
            <field name="interval_type">hours</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">1</field>
            <field name="active">True</field>
        </record>

        <!-- SERVER ACTION PARA IMPORTAR CLIENTES -->
        <record id="server_action_import_clientes" model="ir.actions.server">
            <field name="name">a3ERP: Importar Clientes</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_clientes" />
            <field name="state">code</field>
            <field name="code">model.getall_clientes()</field>
        </record>
    </data>
    <record id="a3erp_cliente_action" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">a3erp.clientes</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1}</field>
    </record>  

    <record id="a3erp_clientes_form_view" model="ir.ui.view">
        <field name="name">a3erp.clientes.form.view</field>
        <field name="model">a3erp.clientes</field>
        <field name="arch" type="xml">
            <form string="Clientes" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                            <field name="obsoleto" readonly="1"/>
                            <field name="codcli" readonly="1"/>
                            <field name="nomcli" readonly="1"/>
                            <field name="dircli1" readonly="1"/>
                            <field name="codpais" readonly="1"/>
                            <field name="nifcli" readonly="1"/>
                            <field name="codprovi" readonly="1"/>
                            <field name="pobcli" readonly="1"/>
                            <field name="dtocli" readonly="1"/>
                        </group>
                        <group>
                            <field name="telcli" readonly="1"/>
                            <field name="telcli2" readonly="1"/>
                            <field name="e_mail" readonly="1"/>
                            <field name="codidioma" readonly="1"/>
                            <field name="paginaweb" readonly="1"/>
                            <field name="cod_rep" readonly="1"/>
                            <field name="docpag" readonly="1"/>
                            <field name="forpag" readonly="1"/>
                            <field name="tarifa" readonly="1"/>
                            <field name="famclidesc" readonly="1"/>
                            <field name="exento_canon" readonly="1"/>
                        </group>
                        <group string="CARACTERISTICAS">
                            <field name="car1" readonly="1"/>
                            <field name="car2" readonly="1"/>
                            <field name="car3" readonly="1"/>
                            <field name="car4" readonly="1"/>
                            <field name="car5" readonly="1"/>
                            <field name="car6" readonly="1"/>
                            <field name="car7" readonly="1"/>
                            <field name="car8" readonly="1"/>
                            <field name="car9" readonly="1"/>
                            <field name="car10" readonly="1"/>
                            <field name="car1_org" readonly="1"/>
                            <field name="car2_org" readonly="1"/>
                            <field name="car3_org" readonly="1"/>
                            <field name="car4_org" readonly="1"/>
                            <field name="car5_org" readonly="1"/>
                            <field name="car6_org" readonly="1"/>
                            <field name="car7_org" readonly="1"/>
                            <field name="car8_org" readonly="1"/>
                            <field name="car9_org" readonly="1"/>
                            <field name="car10_org" readonly="1"/>
                        </group>
                        <group string="PARAMETRIZABLES">
                            <field name="param1" readonly="1" />
                            <field name="param2" readonly="1" />
                            <field name="param3" readonly="1" />
                            <field name="param4" readonly="1" />
                            <field name="param5" readonly="1" />
                            <field name="param6" readonly="1" />
                            <field name="param7" readonly="1" />
                            <field name="param8" readonly="1" />
                            <field name="param9" readonly="1" />
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_clientes_tree_view" model="ir.ui.view">
        <field name="name">a3erp.clientes.view.tree</field>
        <field name="model">a3erp.clientes</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="bloqueado" optional="show"/>
                <field name="codcli" optional="show"/>
                <field name="nomcli" optional="show"/>
                <field name="dircli1" optional="show"/>
                <field name="codpais" optional="show"/>
                <field name="nifcli" optional="show"/>
                <field name="codprovi" optional="show"/>
                <field name="pobcli" optional="show"/>
                <field name="dtocli" optional="show"/>
                <field name="telcli" optional="show"/>
                <field name="telcli2" optional="hide"/>
                <field name="e_mail" optional="show"/>
                <field name="codidioma" optional="show"/>
                <field name="paginaweb" optional="hide"/>
                <field name="cod_rep" optional="hide"/>
                <field name="docpag" optional="show"/>
                <field name="forpag" optional="show"/>
                <field name="tarifa" optional="show"/>
                <field name="famclidesc" optional="show"/>
                <field name="car1" optional="hide"/>
                <field name="car2" optional="hide"/>
                <field name="car3" optional="hide"/>
                <field name="car4" optional="hide"/>
                <field name="car5" optional="hide"/>
                <field name="car1_org" optional="hide"/>
                <field name="car2_org" optional="hide"/>
                <field name="car3_org" optional="hide"/>
                <field name="car4_org" optional="hide"/>
                <field name="car5_org" optional="hide"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_a3erp_clientes_search" model="ir.ui.view">
        <field name="name">a3erp.clientes.search</field>
        <field name="model">a3erp.clientes</field>
        <field name="arch" type="xml">
            <search>
                <field name="codcli"/>
                <field name="nomcli"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Cliente" name="nomcli" context="{'group_by': 'nomcli'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="a3erp_cliente_action">
        <field name="name">Clientes</field>
        <field name="res_model">a3erp.clientes</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1}</field>
    </record>  

    <menuitem name="Clientes" id="a3erp_clientes" parent="a3erp_replogs" action="a3erp_cliente_action" sequence="1"/>
        <!-- <menuitem name="Clientes" id="import_a3erp_clientes" parent="a3erp_importar"
            action="server_action_import_clientes" sequence="33" /> -->
    
</odoo>