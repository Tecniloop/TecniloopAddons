    <!-- SERVER ACTION PARA IMPORTAR TARIFAS -->
    <record id="server_action_import_tarifas" model="ir.actions.server">
        <field name="name">a3ERP: Importar Tarifas</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_tarifas" />
        <field name="state">code</field>
        <field name="code">model.getall_tarifav()</field>
    </record>
    </data>
    <record id="a3erp_tarifas_action" model="ir.actions.act_window">
        <field name="name">Tarifas</field>
        <field name="res_model">a3erp.tarifas</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1, 'search_default_tarifa': 1}</field>
    </record>  

    <record id="a3erp_tarifas_form_view" model="ir.ui.view">
        <field name="name">a3erp.tarifas.form.view</field>
        <field name="model">a3erp.tarifas</field>
        <field name="arch" type="xml">
            <form string="Tarifas" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="tarifa" readonly="1"/>
                            <field name="desctarifa" readonly="1"/>
                            <field name="codart" readonly="1"/>
                            <field name="precio" readonly="1"/>
                            <field name="unidades" readonly="1"/>
                            <field name="codmon" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_tarifas_tree_view" model="ir.ui.view">
        <field name="name">a3erp.tarifas.view.tree</field>
        <field name="model">a3erp.tarifas</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="tarifa" optional="show"/>
                <field name="desctarifa" optional="show"/>
                <field name="codart" optional="show"/>
                <field name="precio" optional="show"/>
                <field name="unidades" optional="show"/>
                <field name="codmon" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_tarifas_search_view" model="ir.ui.view">
        <field name="name">a3erp.tarifas.search</field>
        <field name="model">a3erp.tarifas</field>
        <field name="arch" type="xml">
            <search>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Tarifa" name="tarifa" context="{'group_by': 'tarifa'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  

