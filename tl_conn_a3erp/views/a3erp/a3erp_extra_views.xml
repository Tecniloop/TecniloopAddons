            <field name="priority">2</field>
            <field name="active">True</field>
        </record>

        <!-- SERVER ACTION PARA IMPORTAR PRODUCTOS OPCIONALES- -->
        <record id="server_action_import_opcionales" model="ir.actions.server">
            <field name="name">a3ERP: Importar Productos opcionales</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_opcionales" />
            <field name="state">code</field>
            <field name="code">model.getall_opcionales()</field>
        </record>
    </data> 
    <record id="a3erp_opcionales_action" model="ir.actions.act_window">
        <field name="name">Productos Opcionales</field>
        <field name="res_model">a3erp.opcionales</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_cod_categoria': 1}</field>
    </record>

    <record id="a3erp_opcionales_form_view" model="ir.ui.view">
        <field name="name">a3erp.opcionales.form.view</field>
        <field name="model">a3erp.opcionales</field>
        <field name="arch" type="xml">
            <form string="Productos Opcionales" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1" />
                            <field name="error" readonly="1" />
                            <field name="movimiento" readonly="1" />
                            <field name="fecha" readonly="1" />
                            <field name="cod_categoria" readonly="1" />
                            <field name="cod_art_opcional" readonly="1" />
                        </group>
                        <group>
                            <field name="company_id" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="a3erp_opcionales_tree_view" model="ir.ui.view">
        <field name="name">a3erp.opcionales.view.tree</field>
        <field name="model">a3erp.opcionales</field>
        <field name="arch" type="xml">
            <list string="" create="False"
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide" />
                <field name="procesado" optional="hide" />
                <field name="movimiento" optional="show" />
                <field name="fecha" optional="show" />
                <field name="cod_categoria" optional="show" />
                <field name="cod_art_opcional" optional="show" />
                <field name="company_id" optional="show" />
            </list>
        </field>
    </record>

    <record id="a3erp_opcionales_search_view" model="ir.ui.view">
        <field name="name">a3erp.opcionales.search</field>
        <field name="model">a3erp.opcionales</field>
        <field name="arch" type="xml">
            <search>
                <field name="cod_categoria"/>
                <field name="cod_art_opcional"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]" />
                <group>
                    <filter string="Categoria" name="cod_categoria" context="{'group_by': 'cod_categoria'}" />
                </group>
            </search>
        </field>
    </record>
    
    <!-- <menuitem name="Productos Opcionales" id="import_a3erp_opcionales" parent="a3erp_importar"
        action="server_action_import_opcionales" sequence="75" /> -->
    <menuitem name="Productos Opcionales" id="a3erp_opcionales" parent="a3erp_extras"
        action="a3erp_opcionales_action" sequence="1" />
</odoo>