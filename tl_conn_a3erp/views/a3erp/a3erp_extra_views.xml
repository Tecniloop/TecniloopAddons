<odoo>
    <data noupdate="1">
        <!-- ALARMAS-->
        <!-- SCHEDULED ACTION IMPORTAR REP LOGS Alarmas-->
        <record id="ir_cron_get_logs_alarmas" model="ir.cron">
            <field name="name">Importar RepLogs Alarmas</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_alarmas"/>
            <field name="state">code</field>
            <field name="code">model.get_rep_logs_alarmas()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">2</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 21:30:00')" />
            <field name="interval_type">days</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">2</field>
            <field name="active">True</field>
        </record>

        <!-- SERVER ACTION PARA IMPORTAR ALARMAS -->
        <record id="server_action_import_alarmas" model="ir.actions.server">
            <field name="name">a3ERP: Importar Alarmas</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_alarmas" />
            <field name="state">code</field>
            <field name="code">model.getall_alarmas()</field>
        </record>
    </data> 
    <record id="a3erp_alarmas_action" model="ir.actions.act_window">
        <field name="name">Alarmas</field>
        <field name="res_model">a3erp.alarmas</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1}</field>
    </record>

    <record id="a3erp_alarmas_form_view" model="ir.ui.view">
        <field name="name">a3erp.alarmas.form.view</field>
        <field name="model">a3erp.alarmas</field>
        <field name="arch" type="xml">
            <form string="Alarmas" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1" />
                            <field name="error" readonly="1" />
                            <field name="movimiento" readonly="1" />
                            <field name="fecha" readonly="1" />
                            <field name="codcli" readonly="1" />
                            <field name="codartv" readonly="1" />
                            <field name="alarmaofe" readonly="1" />
                        </group>
                        <group>
                            <field name="company_id" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="a3erp_alarmas_tree_view" model="ir.ui.view">
        <field name="name">a3erp.alarmas.view.tree</field>
        <field name="model">a3erp.alarmas</field>
        <field name="arch" type="xml">
            <list string="" create="False"
                default_order="codcli desc, codartv"
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide" />
                <field name="procesado" optional="hide" />
                <field name="movimiento" optional="show" />
                <field name="fecha" optional="show" />
                <field name="codcli" optional="show" />
                <field name="codartv" optional="show" />
                <field name="alarmaofe" optional="show" />
            </list>
        </field>
    </record>

    <record id="a3erp_alarmas_search_view" model="ir.ui.view">
        <field name="name">a3erp.alarmas.search</field>
        <field name="model">a3erp.alarmas</field>
        <field name="arch" type="xml">
            <search>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]" />
                <group>
                    <!-- <filter string="Codigo" name="codigo" context="{'group_by': 'codigo'}" /> -->
                    <filter string="Movimiento" name="movimiento"
                        context="{'group_by': 'movimiento'}" />
                </group>
            </search>
        </field>
    </record>

    <menuitem name="Alarmas" id="a3erp_alarmas" parent="a3erp_extras"
        action="a3erp_alarmas_action" sequence="60" />
    <!-- <menuitem name="Alarmas" id="import_a3erp_alarmas" parent="a3erp_importar"
