<odoo>
    <data noupdate="1">
      <!-- SCHEDULED ACTION PARA ELIMINAR LOGS-->
      <record id="ir_cron_delete_replogs" model="ir.cron">
        <field name="name">Eliminar RepLogs</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_replogs" />
        <field name="state">code</field>
        <field name="code">
#Eliminar REPLOGS procesados. Cada 3 Dias
model.delete_mail_messages()
model.delete_replogs()
        </field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">3</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 22:30:00')" />
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="priority">5</field>
    </record>
    </data> 
  <!--MENU CON EL QUE ACCEDEMOS A LA APP-->
  <menuitem id="a3erp_base_menu" name="a3ERP" sequence="1" web_icon="tl_conn_a3erp,static/img/icon.png"/>
  <!-- SUBMENUS-->
  <menuitem id="a3erp_replogs" name="A3erp RepLogs " sequence="1" parent="a3erp_base_menu" />
  <menuitem id="a3erp_auxiliar" name="Auxiliar" parent="a3erp_base_menu" sequence="15"/>
  <!--<menuitem id="a3erp_importar" name="Importación" parent="a3erp_base_menu" sequence="16" groups="tl_conn_a3erp.group_a3erp"/>-->
</odoo>