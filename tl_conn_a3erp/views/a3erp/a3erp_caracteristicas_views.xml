<odoo>
    <data noupdate="1">
        <!-- SCHEDULED ACTION PARA IMPORTAR REP LOGS Caracteristicas -->
        <record id="ir_cron_get_logs_caracteristicas" model="ir.cron">
            <field name="name">Importar RepLogs Caracteristicas</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_caracteristicas"/>
            <field name="state">code</field>
            <field name="code">model.get_rep_logs_caracteristicas()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 21:00:00')" />
            <field name="interval_type">days</field>
            <!--<field name="numbercall">-1</field>-->
            <field name="priority">2</field>
            <field name="active">True</field>
        </record>

        <!-- SERVER ACTION PARA IMPORTAR Caracteristicas -->
        <record id="server_action_import_caracteristicas" model="ir.actions.server">
            <field name="name">a3ERP: Importar Caracteristicas</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="tl_conn_a3erp.model_a3erp_caracteristicas" />
            <!-- <field name="binding_model_id" ref="tl_conn_a3erp.model_a3erp_caracteristicas" /> -->
            <field name="state">code</field>
            <field name="code">model.getall_caracteristicas()</field>
        </record>
    </data>
    <record id="a3erp_caracteristicas_action" model="ir.actions.act_window">
        <field name="name">Caracteristicas</field>
        <field name="res_model">a3erp.caracteristicas</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1, 'search_default_codcar': 1}</field>
    </record>  

    <record id="a3erp_caracteristicas_form_view" model="ir.ui.view">
        <field name="name">a3erp.caracteristicas.form.view</field>
        <field name="model">a3erp.caracteristicas</field>
        <field name="arch" type="xml">
            <form string="Caracteristicas" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="codcar" readonly="1"/>
                            <field name="desccar" readonly="1"/>
                            <field name="numcar" readonly="1"/>
                            <field name="tipcar" readonly="1"/>
                            <field name="codart_canon" invisible="tipcar != 'A' or numcar != 2" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_caracteristicas_tree_view" model="ir.ui.view">
        <field name="name">a3erp.caracteristicas.view.tree</field>
        <field name="model">a3erp.caracteristicas</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="codcar" optional="show"/>
                <field name="desccar" optional="show"/>
                <field name="numcar" optional="show"/>
                <field name="tipcar" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_caracteristicas_search_view" model="ir.ui.view">
        <field name="name">a3erp.caracteristicas.search</field>
        <field name="model">a3erp.caracteristicas</field>
        <field name="arch" type="xml">
            <search>
                <field name="codcar"/>
                <field name="desccar"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Caracteristica" name="codcar" context="{'group_by': 'codcar'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  
    
    <menuitem name="Extras" id="a3erp_extras" parent="a3erp_replogs" sequence="15"/>
    <menuitem name="Caracteristicas" id="a3erp_caracteristicas" parent="a3erp_extras" action="a3erp_caracteristicas_action" sequence="1"/>
    <!-- <menuitem name="Caracteristicas" id="import_a3erp_caracteristicas" parent="a3erp_importar"
        action="server_action_import_caracteristicas" sequence="1" /> -->
</odoo>