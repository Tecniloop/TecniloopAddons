<odoo>
    <data noupdate="1">
     <!-- SCHEDULED ACTION PARA IMPORTAR REP LOGS PROVEEDORES -->
     <record id="ir_cron_get_logs_proveed" model="ir.cron">
        <field name="name">Importar RepLogs Proveedores</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_proveed"/>
        <field name="state">code</field>
        <field name="code">model.get_rep_logs_proveed()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">4</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 15:00:00')" />
        <field name="interval_type">hours</field>
        <!--<field name="numbercall">-1</field>-->
        <field name="priority">2</field>
        <field name="active">True</field>
    </record>

    <!-- SERVER ACTION PARA IMPORTAR PROVEEDORES -->
    <record id="server_action_import_proveed" model="ir.actions.server">
        <field name="name">a3ERP: Importar Proveedores</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_proveed" />
        <field name="state">code</field>
        <field name="code">model.getall_proveed()</field>
    </record>
    </data>
    <record id="a3erp_proveed_action" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">a3erp.proveed</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_movimiento': 1, 'search_default_nompro': 1}</field>
    </record>  

    <record id="a3erp_proveed_form_view" model="ir.ui.view">
        <field name="name">a3erp.proveed.form.view</field>
        <field name="model">a3erp.proveed</field>
        <field name="arch" type="xml">
            <form string="Proveedores" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="codpro" readonly="1"/>
                            <field name="alias" readonly="1"/>
                            <field name="nifpro" readonly="1"/>
                            <field name="nompro" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_proveed_tree_view" model="ir.ui.view">
        <field name="name">a3erp.proveed.view.tree</field>
        <field name="model">a3erp.proveed</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="codpro" optional="show"/>
                <field name="alias" optional="show"/>
                <field name="nifpro" optional="show"/>
                <field name="nompro" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_proveed_search_view" model="ir.ui.view">
        <field name="name">a3erp.proveed.search</field>
        <field name="model">a3erp.proveed</field>
        <field name="arch" type="xml">
            <search>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Proveedor" name="nompro" context="{'group_by': 'nompro'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  

    <menuitem name="Proveedores" id="a3erp_proveed" parent="a3erp_replogs" action="a3erp_proveed_action" sequence="3"/>

    <!-- <menuitem name="Proveedores" id="import_a3erp_proveed" parent="a3erp_importar"
        action="server_action_import_proveed" sequence="34" /> -->
</odoo>