    <record id="a3erp_refpro_action" model="ir.actions.act_window">
        <field name="name">Referencias Proveedor</field>
        <field name="res_model">a3erp.refpro</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_codart': 1,'search_default_movimiento': 1}</field>
    </record>  


    <record id="a3erp_refpro_form_view" model="ir.ui.view">
        <field name="name">a3erp.refpro.form.view</field>
        <field name="model">a3erp.refpro</field>
        <field name="arch" type="xml">
            <form string="Referencias Proveedor" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group>
                            <field name="codpro" readonly="1"/>
                            <field name="codart" readonly="1"/>
                            <field name="referencia" readonly="1"/>                            
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <record id="a3erp_refpro_tree_view" model="ir.ui.view">
        <field name="name">a3erp.refpro.view.tree</field>
        <field name="model">a3erp.refpro</field>
        <field name="arch" type="xml">
            <list string="" create="false"
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="codpro" optional="show"/>
                <field name="codart" optional="show"/>
                <field name="referencia" optional="show"/>               
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="a3erp_refpro_search_view" model="ir.ui.view">
        <field name="name">a3erp.refpro.search</field>
        <field name="model">a3erp.refpro</field>
        <field name="arch" type="xml">
            <search>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Producto" name="codart" context="{'group_by': 'codart'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  
        
    <menuitem name="Referencias Proveedor" id="a3erp_refpro" parent="a3erp_base_productos" action="a3erp_refpro_action" sequence="10"/>
</odoo>