<odoo>
    <data noupdate="1">
     <!-- SCHEDULED ACTION IMPORTAR REP LOGS DIRECCIONES ENTREGA-->
     <record id="ir_cron_get_logs_dirent" model="ir.cron">
        <field name="name">Importar RepLogs Direcciones Entrega</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_dirent"/>
        <field name="state">code</field>
        <field name="code">model.get_rep_logs_dirent()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 21:20:00')" />
        <field name="interval_type">days</field>
        <!--<field name="numbercall">-1</field>-->
        <field name="priority">1</field>
        <field name="active">True</field>
    </record>

    <!-- SERVER ACTION PARA IMPORTAR DIRENTS -->
    <record id="server_action_import_dirent" model="ir.actions.server">
        <field name="name">a3ERP: Importar Direcciones entrega</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_dirent" />
        <!-- <field name="binding_model_id" ref="tl_conn_a3erp.model_a3erp_dirent" /> -->
        <field name="state">code</field>
        <field name="code">model.getall_dirent()</field>
    </record>
    </data>
    <record id="a3erp_dirent_action" model="ir.actions.act_window">
        <field name="name">Direcciones Entrega</field>
        <field name="res_model">a3erp.dirent</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_iddirent': 1,'search_default_movimiento': 1}</field>
    </record>  

    <record id="a3erp_dirents_form_view" model="ir.ui.view">
        <field name="name">a3erp.dirent.form.view</field>
        <field name="model">a3erp.dirent</field>
        <field name="arch" type="xml">
            <form string="Direcciones" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="procesado" readonly="1"/>
                            <field name="error" readonly="0"/>
                            <field name="movimiento" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                            <field name="iddirent" readonly="1"/>
                            <field name="noment" readonly="1"/>
                            <field name="codcli" readonly="1"/>
                            <field name="codpais" readonly="1"/>
                            <field name="codprovi" readonly="1"/>
                        </group>
                        <group>
                            <field name="dirent1" readonly="1"/>
                            <field name="dirent2" readonly="1"/>
                            <field name="dtoent" readonly="1"/>
                            <field name="pobent" readonly="1"/>
                            <field name="telent1" readonly="1"/>
                            <field name="telent2" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="obsoleto" readonly="1"/>
                            <field name="defecto" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="a3erp_dirents_tree_view" model="ir.ui.view">
        <field name="name">a3erp.dirent.view.tree</field>
        <field name="model">a3erp.dirent</field>
        <field name="arch" type="xml">
            <list string="" create="False" 
                decoration-success="procesado == True"
                decoration-danger="error == True"
                decoration-warning="procesado == False and error == False">
                <field name="error" optional="hide"/>
                <field name="procesado" optional="hide"/>
                <field name="movimiento" optional="show"/>
                <field name="fecha" optional="show"/>
                <field name="iddirent" optional="show"/>
                <field name="noment" optional="show"/>
                <field name="codcli" optional="show"/>
                <field name="codpais" optional="show"/>
                <field name="codprovi" optional="show"/>
                <field name="dirent1" optional="show"/>
                <field name="dirent2" optional="show"/>
                <field name="dtoent" optional="show"/>
                <field name="pobent" optional="show"/>
                <field name="telent1" optional="show"/>
                <field name="telent2" optional="show"/>
                <field name="email" optional="show"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_dirents_search_view" model="ir.ui.view">
        <field name="name">a3erp.dirent.search</field>
        <field name="model">a3erp.dirent</field>
        <field name="arch" type="xml">
            <search>
                <field name="iddirent"/>
                <field name="noment"/>
                <field name="codcli"/>
                <filter name="procesado" string="No Procesado" domain="[('procesado','=', False)]"/>
                <group>
                    <filter string="Direccion" name="iddirent" context="{'group_by': 'iddirent'}"/>
                    <filter string="Movimiento" name="movimiento" context="{'group_by': 'movimiento'}"/>
                </group>                
            </search>
        </field>
    </record>  

    <menuitem name="Direcciones Entrega" id="a3erp_dirents" parent="a3erp_replogs" action="a3erp_dirent_action" sequence="5"/>
    <!-- <menuitem name="Direcciones Entrega" id="import_a3erp_dirents" parent="a3erp_importar"
        action="server_action_import_dirent" sequence="35" /> -->
</odoo>