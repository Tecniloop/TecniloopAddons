<odoo>
    
    <data noupdate="1">
    <!-- SCHEDULED ACTION PARA ELIMINAR LOGS-->
    <record id="ir_cron_delete_logs" model="ir.cron">
        <field name="name">Eliminar Logs</field>
        <field name="model_id" ref="tl_conn_a3erp.model_a3erp_logs" />
        <field name="state">code</field>
        <field name="code">
#Eliminar logs de hace 3 dias
model.delete_logs()
        </field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">3</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:00:00')" />
        <field name="interval_type">days</field>
        <!--<field name="numbercall">-1</field>-->
        <field name="priority">5</field>
    </record>

    <record id="a3erp_logs_action" model="ir.actions.act_window">
        <field name="name">a3ERP Logs</field>
        <field name="res_model">a3erp.logs</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_model_name': 1, 'search_default_type': 1}</field>
    </record>
    </data> 
    <record id="a3erp_logs_form_view" model="ir.ui.view">
        <field name="name">a3ERP Logs</field>
        <field name="model">a3erp.logs</field>
        <field name="arch" type="xml">
            <form string="a3ERP Logs">
                <sheet>
                    <group>
                        <field name="create_date" />
                        <field name="type" />
                        <field name="petition_name" />
                        <field name="model_name" />
                        <field name="register_id" />
                        <field name="register_name" />
                        <field name="message" />
                        <field name="company_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="a3erp_logs_tree_view" model="ir.ui.view">
        <field name="name">a3erp.logs</field>
        <field name="model">a3erp.logs</field>
        <field name="arch" type="xml">
            <list string="" create="false">
                <field name="create_date" />
                <field name="type" />
                <field name="petition_name" />
                <field name="model_name" />
                <field name="register_id" />
                <field name="register_name" />
                <field name="message" />
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>
    
    <record id="a3erp_logs_search_view" model="ir.ui.view">
        <field name="name">a3erp.logs.search</field>
        <field name="model">a3erp.logs</field>
        <field name="arch" type="xml">
            <search>
                <group>
                    <filter string="Tipo" name="type" context="{'group_by': 'type'}"/>
                    <filter string="Modelo" name="model_name" context="{'group_by': 'model_name'}"/>
                </group>                
            </search>
        </field>
    </record>

    <menuitem name="Logs" id="a3erp_logs" parent="a3erp_base_menu" action="a3erp_logs_action" sequence="20" groups="tl_conn_a3erp.group_a3erp"/>
</odoo>