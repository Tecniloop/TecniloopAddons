<odoo>
    <data>
        <record id="view_a3erp_send_confirm_wizard" model="ir.ui.view">
            <field name="name">a3erp.send.confirm.wizard.form</field>
            <field name="model">a3erp.send.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirmación">
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                        <button name="action_cancel" string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>