<odoo>
    <data>
        <record id="product_stock_wizard" model="ir.ui.view">
            <field name="name">Wizard stock del producto</field>
            <field name="model">product.stock.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Mensaje">
                    <group>
                        <group>
                            <field name="real_stock" readonly="1"/>
                            <label for="sold_units" string="Ventas"/>
                            <div class="address_format">
                                <field name="sold_units" readonly="1" style="width: 20%"/>
                                <label for="date_next_sale" string="Próxima entrega: " style="width: 20%"/>
                                <field name="date_next_sale" readonly="1" style="width: 33%"/>
                            </div>
                            <label for="purchase_units" string="Compras"/>
                            <div class="address_format">
                                <field name="purchase_units" readonly="1" style="width: 20%"/>
                                <label for="date_next_purchase" string="Próxima entrega: " style="width: 20%"/>
                                <field name="date_next_purchase" readonly="1" style="width: 33%"/>
                            </div>
                            <field name="forecast_stock" readonly="1"/>
                        </group>
                    </group>    
                    <group string="Información Adicional" class="oe_title">
                        <div>
                            <field name="description" readonly="1"/>
                        </div>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Confirmar" class="oe_highlight"/>
                    </footer>                                    
                </form>
            </field>
    </record>
    </data>
</odoo>
