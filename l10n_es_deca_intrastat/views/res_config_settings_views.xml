<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_deca_intrastat" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.deca.intrastat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_es_deca.res_config_settings_view_form_deca" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='deca_setting_container']" position="inside">
                <setting
          id="deca_goods_nature_source"
          string="DeCA goods nature"
          help="Applies to new DeCA drafts. Documents already issued keep their sealed text."
        >
                    <field name="deca_goods_nature_source" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
