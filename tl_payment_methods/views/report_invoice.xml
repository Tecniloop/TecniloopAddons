<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_invoice_payment_terms_show_one"
              inherit_id="account.report_invoice_document">

        <!-- Mostrar vencimientos aunque solo haya una cuota -->
        <xpath expr="//t[@t-foreach='payment_term_details' and @t-as='term' and contains(@t-if, 'len(payment_term_details)')]"
               position="attributes">
            <attribute name="t-if">payment_term_details</attribute>
        </xpath>

        <!-- Eliminar el campo Due Date -->
        <xpath expr="//div[@name='due_date']" position="replace"/>

    </template>

</odoo>
