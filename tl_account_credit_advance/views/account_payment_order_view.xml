<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_order_form_credit_advance" model="ir.ui.view">
        <field name="name">account.payment.order.form.credit.advance</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_order_form" />
        <field name="arch" type="xml">
            <button name="action_uploaded_cancel" position="before">
                <button
                    name="action_credit_advance_funding"
                    type="object"
                    string="Register Bank Advance"
                    class="oe_highlight"
                    invisible="not credit_advance or state != 'uploaded' or advance_move_id"
                />
                <button
                    name="action_credit_advance_settle"
                    type="object"
                    string="Settle Matured Effects"
                    invisible="credit_advance_state not in ('advanced', 'partial')"
                />
            </button>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    name="action_view_advance_move"
                    type="object"
                    icon="fa-university"
                    invisible="not advance_move_id"
                    string="Advance Entry"
                />
            </xpath>
            <field name="description" position="after">
                <field name="credit_advance" invisible="1" />
                <field
                    name="credit_advance_line_id"
                    invisible="not credit_advance"
                    readonly="state != 'draft'"
                    required="credit_advance"
                />
                <field
                    name="credit_advance_state"
                    invisible="not credit_advance"
                    widget="badge"
                    decoration-info="credit_advance_state == 'advanced'"
                    decoration-warning="credit_advance_state == 'partial'"
                    decoration-success="credit_advance_state == 'closed'"
                />
            </field>
            <notebook position="inside">
                <page
                    name="credit_advance"
                    string="Bank Advance"
                    invisible="not credit_advance or not advance_move_id"
                >
                    <group>
                        <group name="advance-left">
                            <field name="advance_date" />
                            <field name="advance_move_id" />
                        </group>
                        <group name="advance-right">
                            <field name="total_company_currency" string="Nominal" />
                            <field name="advance_interest" />
                            <field name="advance_commission" />
                            <field name="advance_other_expenses" />
                            <field name="advance_net_amount" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="account_payment_order_tree_credit_advance" model="ir.ui.view">
        <field name="name">account.payment.order.list.credit.advance</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_order_tree" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="credit_advance_line_id" optional="hide" />
                <field name="credit_advance_state" optional="hide" widget="badge" />
            </field>
        </field>
    </record>

    <record id="account_payment_order_search_credit_advance" model="ir.ui.view">
        <field name="name">account.payment.order.search.credit.advance</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_order_search" />
        <field name="arch" type="xml">
            <filter name="uploaded" position="after">
                <separator />
                <filter
                    name="credit_advance"
                    string="Credit Advance"
                    domain="[('credit_advance', '=', True)]"
                />
                <filter
                    name="pending_advance"
                    string="Pending Advance"
                    domain="[('credit_advance', '=', True), ('advance_move_id', '=', False), ('state', '=', 'uploaded')]"
                />
            </filter>
        </field>
    </record>

    <record id="credit_advance_order_action" model="ir.actions.act_window">
        <field name="name">Financed Remittances</field>
        <field name="res_model">account.payment.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('credit_advance', '=', True)]</field>
        <field name="context">{'default_payment_type': 'inbound'}</field>
    </record>
</odoo>
