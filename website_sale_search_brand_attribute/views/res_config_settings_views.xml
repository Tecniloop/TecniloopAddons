<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.website.sale.search.brand.attribute</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info']" position="after">
                <block title="Product Search" id="website_sale_search_brand_attribute">
                    <setting string="Extra product search fields" help="Choose additional fields that website and shop search should match.">
                        <div class="content-group">
                            <field name="website_search_brand_name"/> Brand name<br/>
                            <field name="website_search_brand_description"/> Brand description<br/>
                            <field name="website_search_attribute_values"/> Attribute values<br/>
                            <field name="website_search_attribute_names"/> Attribute names<br/>
                            <field name="website_search_variant_attribute_values"/> Variant-level attribute values<br/>
                            <field name="website_search_product_tags"/> Product tags<br/>
                            <field name="website_search_website_categories"/> Website categories<br/>
                            <field name="website_search_parent_website_categories"/> Parent website categories<br/>
                        </div>
                    </setting>
                    <setting string="Only visible attributes" help="Ignore attributes hidden from the website when searching attributes.">
                        <field name="website_search_visible_attributes_only"/>
                    </setting>
                    <setting string="Prioritize extra matches" help="Move products matching brand, attributes, tags or categories higher in shop result pages.">
                        <field name="website_search_prioritize_extra_matches"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
