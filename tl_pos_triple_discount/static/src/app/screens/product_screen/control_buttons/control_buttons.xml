<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tl_pos_triple_discount.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="before">
            <button t-if="this.currentOrder?.getSelectedOrderline()" t-att-class="buttonClass" t-on-click="() => this.onClickTripleDiscount()">
                <i class="fa fa-tags me-1" role="img" aria-label="Triple discount" title="Triple discount"/> Triple desc.
            </button>
        </xpath>
    </t>
</templates>
