<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="es_disable_base_autocomplete_on_shop" inherit_id="website_sale.search" name="Disable Base Autocomplete on Shop Search">
        <xpath expr="//t[@t-set='search_type']" position="after">
            <t t-set="limit" t-value="'0'"/>
        </xpath>
    </template>

    <template id="es_search_box" inherit_id="website.website_search_box_input" name="ES Search Box">
        <xpath expr="//input[@name='search']" position="attributes">
            <attribute name="data-es-search">1</attribute>
        </xpath>
        <xpath expr="//form" position="inside">
            <div class="es-search-suggestions" style="display:none;"></div>
        </xpath>
    </template>

    <template id="es_search_filters" inherit_id="website_sale.products" name="ES Search Filters">
        <xpath expr="//div[@id='products_grid']/div[hasclass('products_header')]" position="after">
            <div id="es-search-filters" class="es-search-filters mb-3">
                <div class="es-filter-row">
                    <input id="es-min-price" class="form-control form-control-sm" type="number" min="0" step="0.01" placeholder="Min Price"/>
                    <input id="es-max-price" class="form-control form-control-sm" type="number" min="0" step="0.01" placeholder="Max Price"/>
                    <input id="es-attrs" class="form-control form-control-sm" type="text" placeholder="Attributes (comma separated)"/>
                    <input id="es-brand" class="form-control form-control-sm" type="text" placeholder="Brand"/>
                </div>
                <div id="es-facets" class="es-facets mt-2"></div>
            </div>
        </xpath>
    </template>
</odoo>
