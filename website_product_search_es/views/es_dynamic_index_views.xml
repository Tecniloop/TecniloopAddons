<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_es_index_config_tree" model="ir.ui.view">
        <field name="name">es.index.config.tree</field>
        <field name="model">es.index.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="index_name"/>
                <field name="active"/>
                <field name="auto_sync"/>
                <field name="use_for_website_search"/>
                <field name="last_indexed_on"/>
                <field name="last_indexed_count"/>
            </list>
        </field>
    </record>

    <record id="view_es_index_config_form" model="ir.ui.view">
        <field name="name">es.index.config.form</field>
        <field name="model">es.index.config</field>
        <field name="arch" type="xml">
            <form string="Dynamic ES Index Config">
                <header>
                    <button name="action_test_domain" type="object" string="Test Domain" class="btn-secondary"/>
                    <button name="action_preview_payload" type="object" string="Preview Payload" class="btn-secondary"/>
                    <button name="action_index_now" type="object" string="Index Now" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="model_name" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="model_id"/>
                            <field name="index_name"/>
                        </group>
                        <group>
                            <field name="auto_sync"/>
                            <field name="use_for_website_search"/>
                            <field name="enable_badges" invisible="model_name != 'product.template'"/>
                            <field name="batch_size"/>
                            <field name="last_indexed_on" readonly="1"/>
                            <field name="last_indexed_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Badge Rules" invisible="model_name != 'product.template'">
                        <group>
                            <field name="badge_bestseller_top_n"/>
                            <field name="badge_bestseller_days"/>
                            <field name="badge_new_arrival_days"/>
                        </group>
                        <group>
                            <field name="badge_trending_top_n"/>
                            <field name="badge_trending_days"/>
                            <field name="badge_trending_click_weight"/>
                            <field name="badge_trending_sales_weight"/>
                        </group>
                    </group>
                    <group>
                        <field name="domain"/>
                        <field name="last_error" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Field Mapping">
                            <field name="line_ids" context="{'default_config_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="model_id" invisible="1"/>
                                    <field name="field_id" options="{'no_create': True}"/>
                                    <field name="es_field_name"/>
                                    <field name="is_searchable"/>
                                    <field name="search_boost" invisible="not is_searchable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_es_index_config_search" model="ir.ui.view">
        <field name="name">es.index.config.search</field>
        <field name="model">es.index.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="index_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Auto Sync" name="auto_sync" domain="[('auto_sync', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_es_index_config" model="ir.actions.act_window">
        <field name="name">Dynamic ES Indexing</field>
        <field name="res_model">es.index.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_es_index_config_search"/>
    </record>

    <menuitem
        id="menu_es_index_config"
        name="Dynamic ES Indexing"
        parent="website.menu_website_global_configuration"
        action="action_es_index_config"
        sequence="90"
        groups="base.group_system"/>
</odoo>
