        <template id="inherit_website_sale_o_wsale_offcanvas"
            inherit_id="website_sale.o_wsale_offcanvas">
            <xpath expr="//form[@t-if='opt_wsale_attributes or opt_wsale_attributes_top']/t"
                position="after">
                <div class="accordion-item">
                    <h2 id="o_wsale_offcanvas_orderby_header" class="accordion-header mb-0">
                        <button
                            class="o_wsale_offcanvas_title accordion-button border-top rounded-0 collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#o_wsale_offcanvas_brands"
                            aria-expanded="false"
                            aria-controls="o_wsale_offcanvas_brands">
                            <b>Brands</b>
                        </button>
                    </h2>
                    <div id="o_wsale_offcanvas_brands"
                        class="accordion-collapse collapse"
                        aria-labelledby="o_wsale_offcanvas_orderby_header">
                        <div class="accordion-body pt-0">
                            <div class="list-group list-group-flush">
                                <a t-foreach="brand_rec" t-as="b" role="menuitem">
                                    <label>
                                        <input type="checkbox" name="attrib_brand"
                                            class="form-check-input"
                                            t-att-id="'%s-%s' % (b.id,b.id)"
                                            t-att-value="'%s-%s' % (b.id,b.id)"
                                            t-att-checked="'checked' if b.id in brand_set else None" />
                                        <span style="font-weight: normal" t-field="b.name" />
                                    </label>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>

        <template id="wk_horizontal_brands" name="Brand list" inherit_id="website_sale.products"
            active="True">
            <xpath expr="//div[hasclass('products_pager')]" position="after">
                <div class="horizontal_category">
                    <div class="row">
                        <div class="col-md-12">
                            <center>
                                <ul class="list-inline nav nav-pills justify-content-center">
                                    <t t-set="wk_brands"
                                        t-value="brand_set and website.get_wk_brands(brand_set)" />
                                    <li class="horizontal_category_unlink_list">
                                        <ul class="list-inline nav nav-pills justify-content-center"
                                            t-if='wk_brands'>
                                            <t t-foreach="wk_brands" t-as="b">
                                                <li
                                                    t-att-class="'active mr8 mb8' if b.id == int(brand or 0) else ' mr8 mb8'">
                                                    <a href="/shop" class="btn btn-primary wk_brand"
                                                        t-att-data-wk_brand='b.id'>
                                                        <t t-esc="b.name" />
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </li>
                                            </t>
                                        </ul>
                                    </li>
                                </ul>
                            </center>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>

        <template id="products_attributes" inherit_id="website_sale.products_attributes"
            name="Product Brand's Filters" active="True" customize_show="True">
            <xpath expr="//form//input[@name='search']" position="after">
                <div class="mb-3" t-if="brand_rec">
                        <h6 class="mb-3">
                            <button
                                class="accordion-button px-0 bg-transparent shadow-none"
                                type="button"
                                data-bs-toggle="collapse"
                                t-attf-data-bs-target="#o_wsale_brands"
                                t-attf-aria-controls="o_wsale_brands"
                                aria-expanded="true">
                                <b>Marcas</b>
                            </button>
                        </h6>
                        <select id="attrib_brand" name="attrib_brand" class="form-select" onchange="this.form.submit()">
                        <option value="">Todas</option>
                        <t t-foreach="brand_rec" t-as="b">
                            <option t-att-value="b.id" t-att-selected="'selected' if b.id in brand_set else None">
                                <t t-esc="b.name"/>
                            </option>
                        </t>
                        </select>
                </div>
            </xpath>
        </template>

