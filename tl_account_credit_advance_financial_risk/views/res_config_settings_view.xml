<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_credit_advance" model="ir.ui.view">
        <field name="name">res.config.settings.form.credit.advance.risk</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_financial_risk.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='partner_financial_risk_setting_container']"
                position="inside"
            >
                <setting
                    id="credit_advance_unpaid_warn"
                    string="Unpaid credit advance effects"
                    help="Show the financial risk wizard when posting an invoice for a customer that has effects charged back by the bank, even if their risk limits are not exceeded."
                >
                    <field name="credit_advance_unpaid_warn" />
                    <div
                        class="content-group mt16"
                        invisible="not credit_advance_unpaid_warn"
                    >
                        <label
                            for="credit_advance_unpaid_threshold"
                            string="Warn above"
                        />
                        <field
                            name="credit_advance_unpaid_threshold"
                            class="oe_inline"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
