<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="credit_advance_risk_pivot_view" model="ir.ui.view">
        <field name="name">account.payment.credit.advance.risk.pivot</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <pivot string="Credit Advance Risk">
                <field name="partner_id" type="row" />
                <field name="credit_advance_line_id" type="col" />
                <field name="credit_advance_amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="credit_advance_risk_tree_view" model="ir.ui.view">
        <field name="name">account.payment.credit.advance.risk.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name" />
                <field name="partner_id" />
                <field name="credit_advance_line_id" />
                <field name="payment_order_id" />
                <field name="credit_advance_maturity_date" />
                <field name="credit_advance_amount" sum="Nominal" />
                <field
                    name="credit_advance_state"
                    widget="badge"
                    decoration-info="credit_advance_state == 'advanced'"
                    decoration-danger="credit_advance_state == 'unpaid'"
                />
                <field name="company_currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="credit_advance_risk_search_view" model="ir.ui.view">
        <field name="name">account.payment.credit.advance.risk.search</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="credit_advance_line_id" />
                <filter
                    name="credit_advance_live"
                    string="Assigned and Advanced"
                    domain="[('credit_advance_state', 'in', ('assigned', 'advanced'))]"
                />
                <filter
                    name="credit_advance_unpaid"
                    string="Charged Back"
                    domain="[('credit_advance_state', '=', 'unpaid')]"
                />
                <separator />
                <filter
                    name="credit_advance_overdue"
                    string="Overdue"
                    domain="[('credit_advance_state', 'in', ('assigned', 'advanced')), ('credit_advance_maturity_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <group name="groupby">
                    <filter
                        name="group_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_line"
                        string="Credit Advance Line"
                        context="{'group_by': 'credit_advance_line_id'}"
                    />
                    <filter
                        name="group_state"
                        string="Effect Status"
                        context="{'group_by': 'credit_advance_state'}"
                    />
                    <filter
                        name="group_maturity"
                        string="Maturity Date"
                        context="{'group_by': 'credit_advance_maturity_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="credit_advance_risk_pivot_action" model="ir.actions.act_window">
        <field name="name">Risk by Credit Advance Line</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('credit_advance_line_id', '!=', False)]</field>
        <field name="search_view_id" ref="credit_advance_risk_search_view" />
        <field name="context">{'search_default_credit_advance_live': 1}</field>
    </record>

    <record
        id="credit_advance_risk_pivot_action_pivot_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="credit_advance_risk_pivot_view" />
        <field name="act_window_id" ref="credit_advance_risk_pivot_action" />
    </record>

    <record
        id="credit_advance_risk_pivot_action_tree_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence">2</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="credit_advance_risk_tree_view" />
        <field name="act_window_id" ref="credit_advance_risk_pivot_action" />
    </record>

    <menuitem
        id="credit_advance_risk_menu"
        action="credit_advance_risk_pivot_action"
        parent="tl_account_credit_advance.credit_advance_menu"
        sequence="25"
    />
</odoo>
