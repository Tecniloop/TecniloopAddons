<odoo>

    <record id="tl_suenlace_default_mapping_wizard_view_form" model="ir.ui.view">
        <field name="name">tl.suenlace.default.mapping.wizard.form</field>
        <field name="model">tl.suenlace.default.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar mapeos predeterminados SUENLACE">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="load_tax_mappings"/>
                    <field name="load_fiscal_position_mappings"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Solo se crean los casos habituales que puedan relacionarse
                    de forma inequívoca con los impuestos y posiciones fiscales
                    existentes. Los mapeos manuales no se modifican.
                </div>
                <footer>
                    <button name="action_load"
                            string="Cargar mapeos"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="tl_suenlace_default_mapping_wizard_action" model="ir.actions.act_window">
        <field name="name">Cargar mapeos predeterminados</field>
        <field name="res_model">tl.suenlace.default.mapping.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
