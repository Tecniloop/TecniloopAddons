<odoo>
    <record id="tl_suenlace_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.suenlace</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Importación SUENLACE"
                       name="tl_suenlace_import_settings">
                    <setting id="tl_suenlace_company_code_setting"
                             string="Código de empresa SUENLACE"
                             help="Código de cinco dígitos de las posiciones 2 a 6 del DAT. Se valida antes de crear cuentas, partners o asientos.">
                        <field name="suenlace_company_code" placeholder="00001"/>
                    </setting>
                    <setting id="tl_suenlace_background_mode_setting"
                             string="Procesar en segundo plano"
                             help="Evita el timeout HTTP dividiendo el parseo y la creación de documentos en lotes ejecutados por el cron nativo de Odoo.">
                        <field name="suenlace_background_mode"/>
                        <div class="content-group" invisible="not suenlace_background_mode">
                            <div class="row mt16">
                                <label for="suenlace_batch_size" class="col-lg-5 o_light_label" string="Documentos por lote"/>
                                <field name="suenlace_batch_size" class="oe_inline"/>
                            </div>
                            <div class="row mt16">
                                <label for="suenlace_parse_batch_size" class="col-lg-5 o_light_label" string="Registros por lote de parseo"/>
                                <field name="suenlace_parse_batch_size" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="tl_suenlace_associate_partners_setting"
                             string="Asociar terceros en asientos"
                             help="Asigna partner_id a asientos tipo 0 y a facturas importadas como asiento literal. Las facturas Odoo siempre identifican su tercero.">
                        <field name="suenlace_associate_partners"/>
                    </setting>
                    <setting id="tl_suenlace_skip_vat_validation_setting"
                             string="Omitir validación del NIF de Odoo"
                             help="Permite importar terceros con un NIF que Odoo considere inválido. Solo se omite la validación durante esta importación SUENLACE; no se desactiva globalmente.">
                        <field name="suenlace_skip_vat_validation"/>
                    </setting>
                    <setting id="tl_suenlace_associate_taxes_setting"
                             string="Interpretar impuestos y crear facturas"
                             help="Desactivado importa todos los documentos como asientos y conserva las cuentas del DAT. Activado crea facturas Odoo para registros 1/2+9 e interpreta los impuestos configurados.">
                        <field name="suenlace_associate_taxes"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
