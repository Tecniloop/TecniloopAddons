<odoo>
    <record id="tl_suenlace_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.suenlace</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Importación SUENLACE"
                       name="tl_suenlace_import_settings">
                    <setting id="tl_suenlace_associate_partners_setting"
                             string="Asociar terceros en asientos"
                             help="Asigna partner_id a asientos tipo 0 y a facturas importadas como asiento literal. Las facturas Odoo siempre identifican su tercero.">
                        <field name="suenlace_associate_partners"/>
                    </setting>
                    <setting id="tl_suenlace_associate_taxes_setting"
                             string="Interpretar impuestos y crear facturas"
                             help="Desactivado importa todos los documentos como asientos y conserva las cuentas del DAT. Activado crea facturas Odoo para registros 1/2+9 e interpreta los impuestos configurados.">
                        <field name="suenlace_associate_taxes"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
