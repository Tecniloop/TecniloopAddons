<odoo>

    <!-- Listado simple para mail.message -->
    <record id="view_mail_message_list_tl_partner" model="ir.ui.view">
        <field name="name">mail.message.tree.tl.partner</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
        <list string="Mensajes del cliente" create="0" edit="0"
              decoration-warning="is_internal_note == True">
            <field name="is_internal_note" invisible="1"/>
            <field name="message_category" string="Tipo" decoration-warning="is_internal_note == True" widget="badge"/>
            <field name="date" string="Fecha"/>
            <field name="body" string="Mensaje"/>
            <field name="author_id" string="Autor"/>
            <field name="subject" string="Asunto"/>
            <field name="record_name" string="Documento"/>
            <field name="model_name" string="Tipo de documento" optional="hide"/>
        </list>
        </field>
    </record>

    <record id="view_mail_message_search_tl_partner" model="ir.ui.view">
        <field name="name">mail.message.search.tl.partner</field>
        <field name="model">mail.message</field>
        <field name="arch" type="xml">
        <search string="Buscar mensajes">
            <field name="subject"/>
            <field name="author_id"/>
            <filter string="Comentarios" name="comment" domain="[('message_type','=','comment')]"/>
            <filter string="Email" name="email" domain="[('message_type','=','email')]"/>
            <filter string="Notas internas" name="note" domain="[('subtype_id.internal','=',True)]"/>
            <group expand="0" string="Agrupar por">
            <filter string="Documento (modelo)" name="group_model" context="{'group_by':'model'}"/>
            <filter string="Autor" name="group_author" context="{'group_by':'author_id'}"/>
            <filter string="Día" name="group_date" context="{'group_by':'date:day'}"/>
            </group>
        </search>
        </field>
    </record>

    <record id="action_tl_partner_messages" model="ir.actions.act_window">
        <field name="name">Mensajes del cliente</field>
        <field name="res_model">mail.message</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mail_message_list_tl_partner"/>
        <field name="search_view_id" ref="view_mail_message_search_tl_partner"/>
        <field name="context">{}</field>
    </record>

</odoo>