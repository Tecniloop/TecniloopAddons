<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_product_social_sharing_website_form" model="ir.ui.view">
        <field name="name">sh.product.social.sharing.website.form</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="before">
                <group string="Product Social Sharing">
                    <group>
                        <field name="sh_prod_social_is_prod_social_sharing"/>
                        <field
                            name="sh_prod_social_sharing_style"
                            invisible="not sh_prod_social_is_prod_social_sharing"
                        />
                    </group>
                    <group invisible="not sh_prod_social_is_prod_social_sharing">
                        <field name="sh_prod_social_sharing_facebook"/>
                        <field name="sh_prod_social_sharing_twitter"/>
                        <field name="sh_prod_social_sharing_linkedin"/>
                        <field name="sh_prod_social_sharing_whatsapp"/>
                        <field name="sh_prod_social_sharing_email"/>
                        <field name="sh_prod_social_sharing_pinterest"/>
                        <field name="sh_prod_social_sharing_reddit"/>
                        <field name="sh_prod_social_sharing_hacker_news"/>
                        <field name="sh_prod_social_sharing_digg"/>
                        <field name="sh_prod_social_sharing_tumblr"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
