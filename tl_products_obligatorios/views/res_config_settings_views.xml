<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.productos.obligatorios</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="15" />
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">

                    <app data-string="Sales orders" string="Sales orders" name="products_obligatorios">
                        <block title="Sales orders" name="products_obligatorios">
                            <setting string="Configuraciones base" help="Configuraciones base" id="productos_obligatorios_settings">

                                <div class="row mt10 o_settings_container">
                                    <div class="col-6 col-lg-12 o_setting_box">
                                        <div class="text-muted content-group mt16">
                                            <field name="activate_obliagtori_products" class="oe_inline" style="border-right: solid 1px light-gray"/>
                                            <label for="activate_obliagtori_products" string="Activar Obligatoriedad Opionales Ventas" class="col o_light_label o_setting_right_pane" />
                                        </div>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>

                </xpath>
            </field>
        </record>

        <record id="products_obligatorios_config_settings_action" model="ir.actions.act_window">
            <field name="name">Productos Obligatorios Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'tl_products_obligatorios', 'bin_size': False}</field>
        </record>

        
    </data>
</odoo>