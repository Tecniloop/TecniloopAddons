<odoo>

    <!-- Form view for "model" -->
    <record id="tl_default_address_form_view_inherit" model="ir.ui.view">
        <field name="name">view.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <!-- DIRECCIONES DE FACTURACION PERMITIDAS-->
            <field name="partner_invoice_id" position="before">
                <field name="allowed_invoice_addresses" invisible="1"/>
            </field>
            <!--DOMINIO DE LA DIRECCION DE FACTURACION-->
            <field name="partner_invoice_id" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_invoice_addresses)]</attribute>                
            </field>      

            <!-- CAMPOS INFORMATIVOS-->
            <field name="partner_shipping_id" position="before">
                <field name="allowed_delivery_addresses" invisible="1"/>
            </field>
            <!--DOMINIO DE LA DIRECCION-->
            <field name="partner_shipping_id" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_delivery_addresses)]</attribute>                
            </field>

        </field>      
        
    </record> 
    
</odoo>