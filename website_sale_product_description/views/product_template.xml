<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <!-- ODOO 19 COMPAT PATCH: originally anchored on group[@name='shop'],
                 which was renamed/restructured to group[@name='extra_info']
                 (displayed as "Ecommerce Shop") in website_sale's product
                 form starting with the v17/v18 product form rework. No
                 other change vs. the official 17.0 release. -->
            <xpath expr="//group[@name='extra_info']" position="after">
                <group name="public_description" string="Description for e-Commerce">
                    <field
                        name="public_description"
                        nolabel="1"
                        colspan="2"
                        widget="html"
                        placeholder="This description will be shown on e-commerce frontend"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
