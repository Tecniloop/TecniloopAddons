<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="read_access_project_task_group" model="dms.access.group">
        <field name="name">Project Task DMS Access</field>
        <field name="group_ids" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_create" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="field_template_project_task" model="dms.field.template">
        <field name="name">Project Task</field>
        <field name="storage_id" ref="dms.storage_demo" />
        <field name="model_id" ref="project.model_project_task" />
        <field name="group_ids" eval="[(4, ref('read_access_project_task_group'))]" />
        <field name="directory_format_name">{{object.display_name}} (task)</field>
    </record>
</odoo>
