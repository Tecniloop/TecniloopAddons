<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//t[@t-call='website_sale.variants']" position="replace">
            <t t-set="combination" t-value="combination_info['combination']"/>
            <t t-if="combination and partner.is_wholesale" t-call="website_sale_b2b.matrix"/>
            <t t-if="combination and not partner.is_wholesale" t-call="website_sale.variants">
                <t t-set="ul_class" t-valuef="flex-column" />
                <t t-set="parent_combination" t-value="None" />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('row')][2]/div[1]" position="attributes">
            <attribute name="t-attf-class">col-lg-#{'4' if combination and partner.is_wholesale else image_cols[0]} mt-lg-4 o_wsale_product_images position-relative</attribute>
        </xpath>
        <xpath expr="//div[hasclass('row')][2]/div[2]" position="attributes">
            <attribute name="t-attf-class">col-lg-#{'8' if combination and partner.is_wholesale else image_cols[1]} mt-md-4</attribute>
        </xpath>
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="t-attf-class">{{'d-none' if partner.is_wholesale else 'btn btn-primary btn-lg js_check_product a-submit d-block d-sm-inline-block'}}</attribute>
        </xpath>
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <div class="d-flex justify-content-between mt-5" t-if="partner.is_wholesale">
                <div>
                    <a role="button" href="/shop" class="btn btn-secondary mb32">
                        <span class="fa fa-chevron-left" />
                        <span>Continue<span class="d-none d-md-inline"> Shopping</span></span>
                    </a>
                </div>
                <div class="d-flex flex-column">
                    <a class="btn btn-primary float-end" role="button" href="/shop/cart">
                        <span>Go to Cart</span>
                        <span class="fa fa-chevron-right"/>
                    </a>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Single Product -->
    <template id="product_quantity" inherit_id="website_sale.product_quantity">
        <xpath expr="//div[@contenteditable='false']" position="attributes">
            <!-- To execute auto add -->
            <attribute name="t-attf-class">
                {{'oe_cart' if partner.is_wholesale else ''}} {{'d-none' if combination and partner.is_wholesale else 'css_quantity input-group'}}
                {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} me-2 mb-2 align-middle #{'input-group-lg' if ctaSizeBig else ''}
            </attribute>
        </xpath>
        <xpath expr="//input[hasclass('quantity')]" position="attributes">
            <!-- To execute auto add -->
            <attribute name="t-attf-class">form-control quantity text-center {{'js_quantity' if partner.is_wholesale else ''}}</attribute>
            <attribute name="t-att-data-product-id">product.product_variant_id.id</attribute>
            <attribute name="t-attf-value">{{product.get_qty_order_line() if not combination and partner.is_wholesale else '1'}}</attribute>
            <attribute name="t-attf-data-min">{{'0' if partner.is_wholesale else '1'}}</attribute>
        </xpath>
    </template>

    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//form[@action='/shop/cart/update']" position="attributes">
            <attribute name="t-attf-class">oe_product_cart d-flex {{'' if partner.is_wholesale else 'h-100'}}</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="after">
            <div t-if="partner.is_wholesale" class="css_quantity oe_cart input-group py-3 justify-content-center" style="max-height:70px;">
                <!-- Single products -->
                <t t-if="len(product.product_variant_ids) == 1">
                    <a t-attf-href="#" class="btn btn-link js_add_cart_json d-none d-md-inline-block" aria-label="Remove one" title="Remove one">
                        <i class="fa fa-minus"></i>
                    </a>
                    <t t-set="variant" t-value="product.product_variant_id"/>
                    <t t-set="line" t-value="sale_order.order_line.filtered(lambda line: line.product_id.id == variant.id)"/>
                    <input type="text" class="js_quantity form-control quantity" t-att-data-line-id="line.id if line else ''"
                           t-att-data-product-id="variant.id"
                           t-attf-value="{{str(int(int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty))}}"/>
                    <a t-attf-href="#" class="btn btn-link float_left js_add_cart_json d-none d-md-inline-block" aria-label="Add one" title="Add one">
                        <i class="fa fa-plus"></i>
                    </a>
                </t>
                <t t-else="">
                    <div>
                        <a href="#" role="button" t-att-data-product-id="product.id" t-attf-class="btn btn-secondary d-none #{'d-lg-block' if layout_mode == 'list' else ''} a-submit js_open_product_matrix o_list_view">
                            <span class="fa fa-table"/>
                        </a>
                    </div>
                    <div>
                        <a t-att-href="product_href" role="button" t-att-data-product-id="product.id" t-attf-class="btn btn-secondary d-block #{'d-lg-none' if layout_mode == 'list' else ''} o_kanban_view">
                            <span class="fa fa-table"/>
                        </a>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>