<odoo>
    <record id="view_bc3_budget_catalog_insert_wizard_form" model="ir.ui.view">
        <field name="name">bc3.budget.catalog.insert.wizard.form</field>
        <field name="model">bc3.budget.catalog.insert.wizard</field>
        <field name="arch" type="xml">
            <form string="Insertar desde banco de precios">
                <group>
                    <field name="mode"/>
                    <field name="budget_id"/>
                    <field name="parent_id" invisible="mode == 'replace'"/>
                    <field name="replace_line_id" invisible="mode != 'replace'"/>
                    <field name="catalog_file_id" options="{'no_create': True}"/>
                    <field name="concept_id" options="{'no_create': True}"/>
                </group>
                <group string="Datos del concepto seleccionado" invisible="not concept_id">
                    <field name="concept_category"/>
                    <field name="concept_unit_name"/>
                    <field name="concept_price_unit"/>
                </group>
                <group>
                    <field name="quantity" invisible="concept_category in ['chapter'] or mode == 'replace'"/>
                    <field name="sequence" invisible="mode == 'replace'"/>
                    <field name="copy_measurements" invisible="mode != 'insert'"/>
                    <field name="keep_measurements" invisible="mode != 'replace'"/>
                </group>
                <group string="Texto" invisible="not concept_text">
                    <field name="concept_text" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
