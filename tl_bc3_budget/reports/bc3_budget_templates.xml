<odoo>
    <template id="report_bc3_budget_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <style>
                        @page { size: A4 landscape; margin: 8mm 6mm; }
                        .bc3-budget-report {
                            font-family: Calibri, Arial, sans-serif;
                            font-size: 8px;
                            color: #000000;
                        }
                        .bc3-budget-report h1 {
                            font-size: 10px;
                            font-weight: bold;
                            margin: 0 0 12px 0;
                        }
                        .bc3-budget-report h2 {
                            font-size: 14px;
                            font-weight: bold;
                            margin: 0 0 6px 0;
                        }
                        .bc3-budget-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                        }
                        .bc3-budget-table th {
                            font-size: 8px;
                            font-style: italic;
                            font-weight: bold;
                            padding: 2px 2px;
                            border-bottom: 3px solid #000000;
                            vertical-align: bottom;
                        }
                        .bc3-budget-table td {
                            font-size: 8px;
                            padding: 2px 2px;
                            vertical-align: top;
                            border-bottom: 1px solid #E6E6E6;
                        }
                        .bc3-num { text-align: right; white-space: nowrap; }
                        .bc3-code { text-align: right; white-space: nowrap; font-weight: bold; }
                        .bc3-nature { white-space: nowrap; }
                        .bc3-summary { font-weight: normal; }
                        .bc3-description td {
                            border-bottom: none;
                            color: #111111;
                            line-height: 1.25;
                        }
                        .bc3-chapter td {
                            border-top: 3px solid #000000;
                            border-bottom: 3px solid #000000;
                            font-weight: bold;
                            background-color: #D9D9D9;
                        }
                        .bc3-chapter .bc3-total-cell,
                        .bc3-work .bc3-total-cell,
                        .bc3-total-row .bc3-total-cell {
                            background-color: #000000;
                            color: #FFFFFF;
                        }
                        .bc3-work td {
                            border-top: 3px solid #000000;
                        }
                        .bc3-measure td {
                            border-bottom: none;
                        }
                        .bc3-total-row td {
                            border-bottom: 3px solid #000000;
                            font-weight: bold;
                        }
                        .bc3-footer-total {
                            margin-top: 10px;
                            width: 35%;
                            margin-left: auto;
                            border-collapse: collapse;
                            font-size: 9px;
                        }
                        .bc3-footer-total td {
                            padding: 3px 5px;
                            border-bottom: 1px solid #999999;
                        }
                        .bc3-footer-total .label { font-weight: bold; }
                    </style>
                    <div class="bc3-budget-report">
                        <h1><span t-esc="doc._report_title()"/></h1>
                        <h2>Presupuesto</h2>
                        <table class="bc3-budget-table">
                            <colgroup>
                                <col style="width: 8%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 3%;"/>
                                <col style="width: 37%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 4%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 6%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nat</th>
                                    <th>Ud</th>
                                    <th>Resumen</th>
                                    <th>Comentario</th>
                                    <th class="bc3-num">N</th>
                                    <th class="bc3-num">Longitud</th>
                                    <th class="bc3-num">Anchura</th>
                                    <th class="bc3-num">Altura</th>
                                    <th class="bc3-num">Parcial</th>
                                    <th class="bc3-num">CanPres</th>
                                    <th class="bc3-num">PrPres</th>
                                    <th class="bc3-num">ImpPres</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc._report_print_lines()" t-as="line">
                                    <tr t-att-class="'bc3-chapter' if line.line_type == 'chapter' else 'bc3-work'">
                                        <td class="bc3-code"><span t-esc="line.code"/></td>
                                        <td class="bc3-nature"><span t-esc="line._report_nature()"/></td>
                                        <td><span t-esc="line.unit_name or ''"/></td>
                                        <td class="bc3-summary"><span t-esc="line.name"/></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td class="bc3-num bc3-total-cell"><span t-esc="doc._report_format_measure(line.quantity, False)"/></td>
                                        <td class="bc3-num bc3-total-cell"><span t-esc="doc._report_format_amount(line.price_unit if line.line_type == 'work_unit' else line.amount_total)"/></td>
                                        <td class="bc3-num bc3-total-cell"><span t-esc="doc._report_format_amount(line.amount_total)"/></td>
                                    </tr>
                                    <t t-if="line.line_type == 'work_unit'">
                                        <tr t-if="line.text" class="bc3-description">
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td colspan="7"><span t-esc="line.text"/></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                        <t t-foreach="line.budget_measurement_line_ids.sorted(key=lambda m: (m.sequence, m.id))" t-as="mline">
                                            <tr class="bc3-measure">
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td><span t-esc="mline.comment or ''"/></td>
                                                <td class="bc3-num"><span t-esc="doc._report_format_measure(mline.units)"/></td>
                                                <td class="bc3-num"><span t-esc="doc._report_format_measure(mline.length)"/></td>
                                                <td class="bc3-num"><span t-esc="doc._report_format_measure(mline.width)"/></td>
                                                <td class="bc3-num"><span t-esc="doc._report_format_measure(mline.height)"/></td>
                                                <td class="bc3-num"><span t-esc="doc._report_format_measure(mline.subtotal)"/></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        </t>
                                        <tr class="bc3-total-row">
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td class="bc3-code"><span t-esc="line.code"/></td>
                                            <td class="bc3-num bc3-total-cell"><span t-esc="doc._report_format_measure(line.quantity, False)"/></td>
                                            <td class="bc3-num"><span t-esc="doc._report_format_amount(line.price_unit)"/></td>
                                            <td class="bc3-num"><span t-esc="doc._report_format_amount(line.amount_total)"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                        <table class="bc3-footer-total">
                            <tr>
                                <td class="label">Total presupuesto</td>
                                <td class="bc3-num"><span t-esc="doc._report_format_amount(doc.amount_total)"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
