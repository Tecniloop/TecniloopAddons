<odoo>
    <record id="view_bc3_file_form_inherit_budget" model="ir.ui.view">
        <field name="name">bc3.file.form.inherit.budget</field>
        <field name="model">bc3.file</field>
        <field name="inherit_id" ref="tl_bc3_base.view_bc3_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_budget" string="Crear presupuesto" type="object" class="btn-secondary" invisible="state != 'parsed'"/>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button name="action_open_budgets" type="object" class="oe_stat_button" icon="fa-list">
                        <field name="budget_count" widget="statinfo" string="Presupuestos"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//group[field[@name='record_count']]" position="after">
                <group string="Presupuestos vinculados">
                    <field name="budget_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="chapter_count"/>
                            <field name="work_unit_count"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
