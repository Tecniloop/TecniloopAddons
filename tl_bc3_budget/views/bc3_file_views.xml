<odoo>
    <record id="view_bc3_file_form_inherit_budget" model="ir.ui.view">
        <field name="name">bc3.file.form.inherit.budget</field>
        <field name="model">bc3.file</field>
        <field name="inherit_id" ref="tl_bc3_base.view_bc3_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_budget" string="Crear presupuesto" type="object" class="btn-secondary" invisible="state != 'parsed' or info_type == '1'"/>
                <button name="action_mark_as_price_bank" string="Marcar como banco de precios" type="object" class="btn-secondary" invisible="info_type == '1'"/>
                <button name="action_refresh_price_bank_stats" string="Actualizar estadísticas" type="object" class="btn-secondary" invisible="info_type != '1'"/>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="before">
                <div name="button_box" class="oe_button_box">
                    <button name="action_open_budgets" type="object" class="oe_stat_button" icon="fa-list">
                        <field name="budget_count" widget="statinfo" string="Presupuestos"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='encoding']" position="after">
                <field name="is_manual_price_bank" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Edición manual del banco" invisible="info_type != '1'">
                    <group>
                        <p class="text-muted">Cree aquí conceptos reutilizables del banco. Después defina su análisis de precio en la tabla de descomposición.</p>
                    </group>
                    <notebook>
                        <page string="Conceptos editables">
                            <field name="concept_ids" context="{'default_file_id': id}">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="category"/>
                                    <field name="unit_name"/>
                                    <field name="name"/>
                                    <field name="price_unit"/>
                                    <field name="text" optional="hide"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="file_id" readonly="1"/>
                                                <field name="code"/>
                                                <field name="category"/>
                                                <field name="unit_name"/>
                                                <field name="uom_id"/>
                                                <field name="price_unit"/>
                                            </group>
                                            <group>
                                                <field name="concept_type"/>
                                                <field name="price_date_raw"/>
                                                <field name="normalized_code" readonly="1"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Texto">
                                                <field name="name"/>
                                                <field name="text"/>
                                            </page>
                                            <page string="Alias">
                                                <field name="alias_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="normalized_code"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Descomposición editable">
                            <field name="decomposition_line_ids" context="{'default_file_id': id}">
                                <list editable="bottom">
                                    <field name="file_id" column_invisible="1"/>
                                    <field name="sequence"/>
                                    <field name="parent_concept_id" domain="[('file_id', '=', file_id)]"/>
                                    <field name="child_concept_id" domain="[('file_id', '=', file_id)]"/>
                                    <field name="parent_code" optional="hide"/>
                                    <field name="child_code" optional="hide"/>
                                    <field name="factor"/>
                                    <field name="performance"/>
                                    <field name="quantity"/>
                                    <field name="percent_codes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
            <xpath expr="//group[field[@name='record_count']]" position="after">
                <group string="Presupuestos vinculados">
                    <field name="budget_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="chapter_count"/>
                            <field name="work_unit_count"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
