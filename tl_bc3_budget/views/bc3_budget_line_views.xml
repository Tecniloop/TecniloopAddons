<odoo>
    <record id="view_bc3_budget_line_list" model="ir.ui.view">
        <field name="name">bc3.budget.line.list</field>
        <field name="model">bc3.budget.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="budget_id"/>
                <field name="parent_id"/>
                <field name="position_path"/>
                <field name="code"/>
                <field name="line_type"/>
                <field name="unit_name"/>
                <field name="name"/>
                <field name="factor"/>
                <field name="performance"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_budget_line_form" model="ir.ui.view">
        <field name="name">bc3.budget.line.form</field>
        <field name="model">bc3.budget.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_update_quantity_from_measurements" string="Actualizar cantidad desde mediciones" type="object" class="btn-secondary"/>
                    <button name="action_open_measurements" string="Mediciones" type="object" class="btn-secondary"/>
                    <button name="action_open_insert_from_catalog" string="Insertar inferior desde banco" type="object" class="btn-secondary" invisible="line_type not in ['root', 'chapter', 'work_unit']"/>
                    <button name="action_open_replace_from_catalog" string="Sustituir desde banco" type="object" class="btn-secondary" invisible="line_type in ['root']"/>
                    <button name="action_update_apu_from_catalog" string="Actualizar APU desde banco" type="object" class="btn-secondary" invisible="not concept_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="parent_id"/>
                            <field name="code"/>
                            <field name="line_type"/>
                            <field name="position_path"/>
                        </group>
                        <group>
                            <field name="unit_name"/>
                            <field name="uom_id"/>
                            <field name="factor"/>
                            <field name="performance"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="text"/>
                    </group>
                    <notebook>
                        <page string="Mediciones editables">
                            <field name="budget_measurement_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="line_type"/>
                                    <field name="comment"/>
                                    <field name="units"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="subtotal"/>
                                    <field name="label"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bc3_budget_measurement_line_list" model="ir.ui.view">
        <field name="name">bc3.budget.measurement.line.list</field>
        <field name="model">bc3.budget.measurement.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="budget_id"/>
                <field name="budget_line_id"/>
                <field name="sequence"/>
                <field name="line_type"/>
                <field name="comment"/>
                <field name="units"/>
                <field name="length"/>
                <field name="width"/>
                <field name="height"/>
                <field name="subtotal"/>
                <field name="label"/>
            </list>
        </field>
    </record>
    <record id="action_bc3_budget_line" model="ir.actions.act_window">
        <field name="name">Líneas de presupuesto BC3</field>
        <field name="res_model">bc3.budget.line</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_bc3_budget_measurement_line" model="ir.actions.act_window">
        <field name="name">Mediciones de presupuesto BC3</field>
        <field name="res_model">bc3.budget.measurement.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
