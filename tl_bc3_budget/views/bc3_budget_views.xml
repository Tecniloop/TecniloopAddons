<odoo>
    <record id="view_bc3_budget_list" model="ir.ui.view">
        <field name="name">bc3.budget.list</field>
        <field name="model">bc3.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="file_id"/>
                <field name="chapter_count"/>
                <field name="work_unit_count"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_budget_form" model="ir.ui.view">
        <field name="name">bc3.budget.form</field>
        <field name="model">bc3.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rebuild_lines" string="Reconstruir líneas" type="object" class="btn-secondary"/>
                    <button name="action_update_quantities_from_measurements" string="Actualizar cantidades desde mediciones" type="object" class="btn-secondary"/>
                    <button name="action_open_insert_from_catalog" string="Insertar desde banco" type="object" class="btn-secondary" invisible="not line_ids"/>
                    <button name="action_export_bc3" string="Exportar BC3" type="object" class="btn-primary" invisible="not line_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,locked"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_origin_file" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_text">Fichero BC3</span></div>
                        </button>
                        <button name="action_open_catalog_files" type="object" class="oe_stat_button" icon="fa-book" invisible="catalog_count == 0">
                            <field name="catalog_count" widget="statinfo" string="Referencias"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Origen">
                            <field name="file_id"/>
                            <field name="root_concept_id"/>
                            <field name="catalog_file_ids" widget="many2many_tags" context="{'default_info_type': '1', 'default_state': 'parsed', 'default_source_type': 'upload', 'default_is_manual_price_bank': True, 'bc3_manual_price_bank': True}"/>
                            <field name="chapter_count"/>
                            <field name="work_unit_count"/>
                            <field name="amount_total"/>
                        </group>
                        <group string="Coeficientes">
                            <field name="currency_code"/>
                            <field name="ci_percent"/>
                            <field name="gg_percent"/>
                            <field name="bi_percent"/>
                            <field name="baja_percent"/>
                            <field name="iva_percent"/>
                        </group>
                    </group>
                    <group string="Última exportación" invisible="not export_file">
                        <field name="export_filename"/>
                        <field name="export_date"/>
                        <field name="export_file" filename="export_filename"/>
                    </group>
                    <notebook>
                        <page string="Líneas de presupuesto">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="level"/>
                                    <field name="position_path"/>
                                    <field name="parent_id"/>
                                    <field name="code"/>
                                    <field name="line_type"/>
                                    <field name="unit_name"/>
                                    <field name="name"/>
                                    <field name="factor"/>
                                    <field name="performance"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount_total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Edición detallada">
                            <field name="line_ids" mode="list,form">
                                <list>
                                    <field name="code"/>
                                    <field name="line_type"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="amount_total"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_update_quantity_from_measurements" string="Actualizar cantidad desde mediciones" type="object" class="btn-secondary"/>
                                        <button name="action_open_measurements" string="Abrir mediciones" type="object" class="btn-secondary"/>
                                        <button name="action_open_insert_from_catalog" string="Insertar inferior desde banco" type="object" class="btn-secondary" invisible="line_type not in ['root', 'chapter', 'work_unit']"/>
                                        <button name="action_open_replace_from_catalog" string="Sustituir desde banco" type="object" class="btn-secondary" invisible="line_type in ['root']"/>
                                        <button name="action_update_apu_from_catalog" string="Actualizar APU desde banco" type="object" class="btn-secondary" invisible="not concept_id"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="parent_id"/>
                                                <field name="code"/>
                                                <field name="line_type"/>
                                                <field name="unit_name"/>
                                                <field name="uom_id"/>
                                            </group>
                                            <group>
                                                <field name="factor"/>
                                                <field name="performance"/>
                                                <field name="quantity"/>
                                                <field name="price_unit"/>
                                                <field name="amount_total"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="name"/>
                                            <field name="text"/>
                                        </group>
                                        <notebook>
                                            <page string="Mediciones editables">
                                                <field name="budget_measurement_line_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence"/>
                                                        <field name="line_type"/>
                                                        <field name="comment"/>
                                                        <field name="units"/>
                                                        <field name="length"/>
                                                        <field name="width"/>
                                                        <field name="height"/>
                                                        <field name="subtotal"/>
                                                        <field name="label"/>
                                                    </list>
                                                </field>
                                            </page>
                                            <page string="Mediciones origen">
                                                <field name="measurement_line_ids" readonly="1">
                                                    <list>
                                                        <field name="parent_code"/>
                                                        <field name="child_code"/>
                                                        <field name="position_path"/>
                                                        <field name="measurement_total"/>
                                                        <field name="comment"/>
                                                        <field name="units"/>
                                                        <field name="length"/>
                                                        <field name="width"/>
                                                        <field name="height"/>
                                                        <field name="subtotal"/>
                                                    </list>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bc3_budget" model="ir.actions.act_window">
        <field name="name">Presupuestos BC3</field>
        <field name="res_model">bc3.budget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
