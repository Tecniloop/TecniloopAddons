<odoo>
    <record id="view_bc3_concept_form_inherit_pre&#115;to_tools" model="ir.ui.view">
        <field name="name">bc3.concept.form.inherit.reference.tools</field>
        <field name="model">bc3.concept</field>
        <field name="inherit_id" ref="tl_bc3_base.view_bc3_concept_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_duplicate_wizard" type="object" string="Duplicar" class="btn-secondary"/>
                    <button name="action_open_rename_wizard" type="object" string="Renombrar" class="btn-secondary"/>
                    <button name="action_open_attachments" type="object" string="Adjuntos" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="price_locked"/>
                <field name="is_locked"/>
                <field name="is_inactive"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Medición por defecto">
                    <group>
                        <field name="default_measure_formula"/>
                        <field name="measure_header_comment"/>
                        <field name="measure_header_units"/>
                        <field name="measure_header_length"/>
                        <field name="measure_header_width"/>
                        <field name="measure_header_height"/>
                    </group>
                </page>
                <page string="Precios alternativos">
                    <field name="price_line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="zone"/>
                            <field name="currency_id"/>
                            <field name="price_unit"/>
                            <field name="date"/>
                            <field name="active"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_bc3_concept_price_line_list" model="ir.ui.view">
        <field name="name">bc3.concept.price.line.list</field>
        <field name="model">bc3.concept.price.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="concept_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="zone"/>
                <field name="currency_id"/>
                <field name="price_unit"/>
                <field name="date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bc3_budget_form_inherit_pre&#115;to_tools" model="ir.ui.view">
        <field name="name">bc3.budget.form.inherit.reference.tools</field>
        <field name="model">bc3.budget</field>
        <field name="inherit_id" ref="tl_bc3_budget.view_bc3_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_insert_by_code" string="Insertar por código" type="object" class="btn-secondary"/>
                <button name="action_open_substitute_list" string="Sustituir por lista" type="object" class="btn-secondary"/>
                <button name="action_open_price_operate" string="Operar precios" type="object" class="btn-secondary"/>
            </xpath>
            <xpath expr="//field[@name='budget_measurement_line_ids']/list/field[@name='height']" position="after">
                <field name="formula" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_bc3_budget_line_form_inherit_pre&#115;to_tools" model="ir.ui.view">
        <field name="name">bc3.budget.line.form.inherit.reference.tools</field>
        <field name="model">bc3.budget.line</field>
        <field name="inherit_id" ref="tl_bc3_budget.view_bc3_budget_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_insert_by_code" string="Insertar por código" type="object" class="btn-secondary" invisible="line_type not in ['root', 'chapter', 'work_unit']"/>
                <button name="action_duplicate_line" string="Duplicar línea" type="object" class="btn-secondary" invisible="line_type == 'root'"/>
                <button name="action_open_update_from_bank" string="Actualizar desde banco" type="object" class="btn-secondary" invisible="line_type == 'root'"/>
                <button name="action_unlock_price" string="Desbloquear precio" type="object" class="btn-secondary" invisible="not price_locked"/>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="price_locked"/>
                <field name="is_locked"/>
                <field name="is_inactive"/>
            </xpath>
            <xpath expr="//field[@name='text']" position="after">
                <group string="Medición por defecto">
                    <field name="measurement_formula"/>
                    <field name="measure_header_comment"/>
                    <field name="measure_header_units"/>
                    <field name="measure_header_length"/>
                    <field name="measure_header_width"/>
                    <field name="measure_header_height"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='budget_measurement_line_ids']/list/field[@name='height']" position="after">
                <field name="formula" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_bc3_budget_measurement_line_list_inherit_pre&#115;to_tools" model="ir.ui.view">
        <field name="name">bc3.budget.measurement.line.list.inherit.reference.tools</field>
        <field name="model">bc3.budget.measurement.line</field>
        <field name="inherit_id" ref="tl_bc3_budget.view_bc3_budget_measurement_line_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='height']" position="after">
                <field name="formula" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_bc3_concept_price_line" model="ir.actions.act_window">
        <field name="name">Precios alternativos BC3</field>
        <field name="res_model">bc3.concept.price.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bc3_file_form_inherit_pre&#115;to_price_tools" model="ir.ui.view">
        <field name="name">bc3.file.form.inherit.reference.price.tools</field>
        <field name="model">bc3.file</field>
        <field name="inherit_id" ref="tl_bc3_base.view_bc3_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_bank_price_operate" string="Operar precios" type="object" class="btn-secondary" invisible="info_type != '1'"/>
            </xpath>
        </field>
    </record>
</odoo>
