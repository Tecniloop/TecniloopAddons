<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.parseur</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']/setting[@id='show_margins']" position="after">
                <setting string="Margen % Global" help="Margen que se aplicara al precio de compra para calcular el precio de Venta al crear el Pedido de Venta.">
                    <field name="sale_global_margin" widget="percentage"/>
                </setting>
            </xpath>
            <xpath expr="//block[@name='integration']" position="inside">
                <setting string="Parseur" help="Centros de coste que SOLO generan pedido de compra.">
                    <field name="analytic_skip_sale_ids" widget="many2many_tags"/>
                </setting>
                <setting string="Parseur" help="Centros de coste que obligan a Nivel 2 y Nivel 3">
                    <field name="force_analytic_ids" widget="many2many_tags"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
