<odoo>
  <data>
    <record id="view_parseur_order_tree" model="ir.ui.view">
        <field name="name">parseur.order.tree</field>
        <field name="model">parseur.order</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="create_date"/>
                <field name="state" 
                    decoration-success="state == 'facturado'" 
                    decoration-warning="state == 'pendiente'"  
                    decoration-info="state == 'aprobado'" 
                    decoration-danger="state == 'rechazado'" />
                <field name="user_id" required="1" widget="many2one_avatar_user"/>
                <field name="partner_name"/>
                <field name="client_order_ref"/>
                <field name="partner_vat"/>
                <field name="date_order"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record id="view_parseur_order_form" model="ir.ui.view">
        <field name="name">parseur.order.form</field>
        <field name="model">parseur.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button 
                        name="action_select_partner"
                        string="Crear Pedidos Asociados"
                        type="object"
                        class="btn-primary"
                        invisible="purchase_id or not is_manager"
                    />                    
                    <field name="is_manager" invisible="1"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="partner_name"/>
                            <field name="partner_vat"/>
                            <field name="date_order"/>
                            <field name="partner_ref"/>
                            <field name="client_order_ref"/>
                            <field name="origin"/>         
                            <field name="portes"/>         
                            <field name="temperaturas"/>         
                        </group>
                        <group>
                            <field name="analytic_account1_id" required="1" options="{'no_create': True}"/>
                            <field name="analytic_account2_id" required="require_analytic_23 == True" invisible="0" options="{'no_create': True}"/>
                            <field name="analytic_account3_id" required="require_analytic_23 == True" invisible="0" options="{'no_create': True}"/>
                            <field name="order_id" readonly="0"/>                    
                            <field name="purchase_id" readonly="1"/>      
                            <field name="user_id" required="1" widget="many2one_avatar_user"/>      
                        </group>                        
                        <group/>
                        <group string="Documento Procesado">
                            <field name="original_link" readonly="1"/>      
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>         
                    </group>  
                    <notebook>
                        <page string="Líneas">
                            <field name="order_lines">
                                <list editable="bottom"
                                    decoration-success="product_id"
                                    decoration-danger="not product_id">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="product_code"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="discount"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer " colspan="3" name="totals_fields">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="JSON Recibido">
                            <field name="json" readonly="1"/>
                        </page>
                        <page string="Logs de Errores">
                            <field name="error_log" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_parseur_order_search" model="ir.ui.view">
        <field name="name">parseur.order.search</field>
        <field name="model">parseur.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_name"/>
                <field name="client_order_ref"/>
                <field name="partner_vat"/>
                <field name="date_order"/>
                <filter string="Mis Documentos" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>                
                <group>
                    <filter name="state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="user" string="Asignado" context="{'group_by': 'user_id'}"/>
                    <filter name="partner_vat" string="Proveedor" context="{'group_by': 'partner_vat'}"/>
                    <filter name="client_order_ref" string="Pedido de Venta" context="{'group_by': 'client_order_ref'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_parseur_order">
        <field name="name">Albaranes</field>
        <field name="res_model">parseur.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_parseur_order_tree"/>
        <field name="context">{'search_default_my_records': 1}</field>
    </record>

  </data>
</odoo>
