<odoo>
    <record id="view_bc3_measurement_line_list" model="ir.ui.view">
        <field name="name">bc3.measurement.line.list</field>
        <field name="model">bc3.measurement.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="file_id"/>
                <field name="parent_code"/>
                <field name="child_code"/>
                <field name="position_path"/>
                <field name="measurement_total"/>
                <field name="comment"/>
                <field name="units"/>
                <field name="length"/>
                <field name="width"/>
                <field name="height"/>
                <field name="subtotal"/>
            </list>
        </field>
    </record>
    <record id="action_bc3_measurement_line" model="ir.actions.act_window">
        <field name="name">BC3 Measurements</field>
        <field name="res_model">bc3.measurement.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
