<odoo>
    <record id="view_bc3_concept_list" model="ir.ui.view">
        <field name="name">bc3.concept.list</field>
        <field name="model">bc3.concept</field>
        <field name="arch" type="xml">
            <list>
                <field name="file_id"/>
                <field name="code"/>
                <field name="category"/>
                <field name="unit_name"/>
                <field name="name"/>
                <field name="price_unit"/>
                <field name="media_ref_count" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_concept_form" model="ir.ui.view">
        <field name="name">bc3.concept.form</field>
        <field name="model">bc3.concept</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="file_id"/>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="unit_name"/>
                        <field name="uom_id"/>
                        <field name="price_unit"/>
                    </group>
                    <notebook>
                        <page string="General">
                            <group>
                                <field name="name"/>
                                <field name="text"/>
                                <field name="technical_json"/>
                            </group>
                        </page>
                        <page string="Alias">
                            <field name="alias_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="normalized_code"/>
                                </list>
                            </field>
                        </page>
                        <page string="Referencias de medios">
                            <field name="media_ref_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source"/>
                                    <field name="filename"/>
                                    <field name="is_image"/>
                                    <field name="type_code"/>
                                    <field name="description"/>
                                    <field name="url_ext"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bc3_concept" model="ir.actions.act_window">
        <field name="name">Conceptos BC3</field>
        <field name="res_model">bc3.concept</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
