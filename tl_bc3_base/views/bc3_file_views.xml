<odoo>
    <record id="view_bc3_file_list" model="ir.ui.view">
        <field name="name">bc3.file.list</field>
        <field name="model">bc3.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="info_type"/>
                <field name="program"/>
                <field name="version"/>
                <field name="concept_count"/>
                <field name="decomposition_count"/>
                <field name="measurement_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_file_form" model="ir.ui.view">
        <field name="name">bc3.file.form</field>
        <field name="model">bc3.file</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_parse" string="Parse" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,parsed,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="data_file" filename="filename"/>
                            <field name="filename"/>
                            <field name="info_type"/>
                            <field name="certification_number" invisible="info_type != '3'"/>
                            <field name="certification_date" invisible="info_type != '3'"/>
                        </group>
                        <group>
                            <field name="property_file"/>
                            <field name="version"/>
                            <field name="program"/>
                            <field name="charset"/>
                            <field name="encoding"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment"/>
                        <field name="url_base"/>
                    </group>
                    <group>
                        <field name="record_count"/>
                        <field name="concept_count"/>
                        <field name="decomposition_count"/>
                        <field name="measurement_count"/>
                    </group>
                    <notebook>
                        <page string="Concepts">
                            <field name="concept_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="category"/>
                                    <field name="unit_name"/>
                                    <field name="name"/>
                                    <field name="price_unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decomposition">
                            <field name="decomposition_line_ids" readonly="1">
                                <list>
                                    <field name="parent_code"/>
                                    <field name="sequence"/>
                                    <field name="child_code"/>
                                    <field name="factor"/>
                                    <field name="performance"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Measurements">
                            <field name="measurement_line_ids" readonly="1">
                                <list>
                                    <field name="parent_code"/>
                                    <field name="child_code"/>
                                    <field name="position_path"/>
                                    <field name="measurement_total"/>
                                    <field name="comment"/>
                                    <field name="units"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical">
                            <field name="raw_k"/>
                            <field name="warning_message"/>
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bc3_file" model="ir.actions.act_window">
        <field name="name">BC3 Files</field>
        <field name="res_model">bc3.file</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
