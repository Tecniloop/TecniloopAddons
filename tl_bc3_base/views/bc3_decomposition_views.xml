<odoo>
    <record id="view_bc3_decomposition_line_list" model="ir.ui.view">
        <field name="name">bc3.decomposition.line.list</field>
        <field name="model">bc3.decomposition.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="file_id"/>
                <field name="parent_code"/>
                <field name="sequence"/>
                <field name="child_code"/>
                <field name="factor"/>
                <field name="performance"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>
    <record id="action_bc3_decomposition_line" model="ir.actions.act_window">
        <field name="name">Descomposiciones BC3</field>
        <field name="res_model">bc3.decomposition.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
