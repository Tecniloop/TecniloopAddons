<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_tl_piko" model="ir.module.category">
        <field name="name">Importación por scraping</field>
        <field name="sequence">40</field>
    </record>

    <!-- Odoo 19: las categorías de grupo viven en res.groups.privilege -->
    <record id="privilege_tl_piko" model="res.groups.privilege">
        <field name="name">Importación por scraping</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_tl_piko"/>
    </record>

    <record id="group_tl_piko_manager" model="res.groups">
        <field name="name">Gestor de importaciones</field>
        <field name="privilege_id" ref="privilege_tl_piko"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_tl_piko_source_company" model="ir.rule">
        <field name="name">tl.piko.source multi-compañía</field>
        <field name="model_id" ref="model_tl_piko_source"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
