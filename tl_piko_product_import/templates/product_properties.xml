<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las propiedades no se muestran solas en la tienda: el bloque de
         especificaciones de website_sale renderiza líneas de atributo y nada
         más. Esta plantilla añade una tabla con las propiedades del producto
         justo debajo.

         ANCLAJE: `product_full_spec`, la tabla de especificaciones que aporta
         `website_sale_comparison`. Las propiedades quedan pegadas debajo, que
         es donde el usuario espera encontrarlas.

         Esto convierte a website_sale_comparison en dependencia REAL: sin él
         ese id no existe y la herencia falla. Por eso está en `depends`.

         `priority=99` para que esta vista se aplique DESPUÉS de la de
         website_sale_comparison; con la prioridad por defecto (16) el orden lo
         decidiría el id de la vista, que depende del orden de instalación.

         Descartado `product_attributes_simple` (el bloque de specs del core):
         website_sale_comparison lo REEMPLAZA, así que desaparece del arch
         combinado y la herencia falla con "no puede ser localizado".

         Descartado también `product_full_description`: es un contenedor con
         `t-field="product.website_description"` y lo que se inserte dentro lo
         sobrescribe el valor del campo.

         El xpath usa `//*[@id=...]`, no `//div[@id=...]`: atarlo a la etiqueta
         rompe la vista si el core cambia el `div` por un `section`. -->
    <template id="product_piko_properties" inherit_id="website_sale.product"
              priority="99" name="PIKO: especificaciones adicionales">
        <xpath expr="//*[@id='product_full_spec']" position="after">
            <div t-if="product.product_properties"
                 id="tl_piko_product_properties"
                 class="o_wsale_product_details_content_section o_wsale_product_details_content_section_specs mb-4">
                <table class="table table-sm text-muted">
                    <tbody>
                        <tr t-foreach="product.product_properties" t-as="prop">
                            <t t-if="prop.get('value') not in (False, None, '')">
                                <th class="pe-4 fw-normal text-muted">
                                    <span t-esc="prop.get('string') or prop.get('name')"/>
                                </th>
                                <td>
                                    <span t-esc="prop.get('value')"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
