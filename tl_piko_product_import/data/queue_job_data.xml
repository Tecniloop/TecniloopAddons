<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Canal con capacidad 1: los jobs de esta fuente se ejecutan de uno en
         uno. Es la forma limpia de ser cortés con el servidor de origen, en
         lugar de depender solo del retardo entre peticiones. -->
    <record id="channel_piko" model="queue.job.channel">
        <field name="name">piko</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
        <field name="capacity">1</field>
    </record>

    <record id="job_function_discover_page" model="queue.job.function">
        <field name="model_id" ref="model_tl_piko_source"/>
        <field name="method">_job_discover_page</field>
        <field name="channel_id" ref="channel_piko"/>
    </record>

    <record id="job_function_process_line" model="queue.job.function">
        <field name="model_id" ref="model_tl_piko_product"/>
        <field name="method">_job_process_line</field>
        <field name="channel_id" ref="channel_piko"/>
    </record>
</odoo>
