<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La ejecución la lleva queue_job; los crons son solo planificación y
         mantenimiento. -->
    <record id="ir_cron_tl_piko_sync" model="ir.cron">
        <field name="name">PIKO Import: sincronización planificada</field>
        <field name="model_id" ref="model_tl_piko_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_scheduled_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>

    <!-- Red de seguridad: si el jobrunner se cae con jobs en vuelo, esas
         líneas se quedarían en 'queued' para siempre. -->
    <record id="ir_cron_tl_piko_requeue" model="ir.cron">
        <field name="name">PIKO Import: reencolar líneas huérfanas</field>
        <field name="model_id" ref="model_tl_piko_source"/>
        <field name="state">code</field>
        <field name="code">model._cron_requeue_stuck()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_tl_piko_gc" model="ir.cron">
        <field name="name">PIKO Import: limpiar líneas antiguas</field>
        <field name="model_id" ref="model_tl_piko_product"/>
        <field name="state">code</field>
        <field name="code">model._gc_lines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
