<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tl_piko_attribute_rule_list" model="ir.ui.view">
        <field name="name">tl.piko.attribute.rule.list</field>
        <field name="model">tl.piko.attribute.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="attribute_id"/>
                <field name="field_source"/>
                <field name="spec_label" optional="show"/>
                <field name="regex"/>
                <field name="value_mode"/>
                <field name="value_name"/>
                <field name="capture_group" optional="hide"/>
                <field name="multi" optional="hide"/>
                <field name="match_position" optional="hide"/>
                <field name="stop_after_match" optional="hide"/>
                <field name="source_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tl_piko_attribute_rule_form" model="ir.ui.view">
        <field name="name">tl.piko.attribute.rule.form</field>
        <field name="model">tl.piko.attribute.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="p.ej. Época"/></h1>
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="source_id" placeholder="Todas las fuentes"/>
                            <field name="field_source"/>
                            <field name="spec_label" invisible="field_source != 'spec'"
                                   required="field_source == 'spec'"
                                   placeholder="Type of current"/>
                            <field name="regex" invisible="value_mode == 'value'"
                                   required="value_mode != 'value'"/>
                            <field name="case_sensitive"/>
                            <field name="multi"/>
                        </group>
                        <group string="Destino">
                            <field name="attribute_id"/>
                            <field name="value_mode" widget="radio"/>
                            <field name="value_name" invisible="value_mode != 'fixed'"
                                   required="value_mode == 'fixed'"/>
                            <field name="capture_group" invisible="value_mode != 'capture'"/>
                            <field name="match_position" invisible="multi"/>
                            <field name="stop_after_match"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="value_mapping" invisible="value_mode == 'fixed'"
                           placeholder="capturado = Valor final"/>
                    <div class="alert alert-info" role="alert">
                        El atributo se fuerza a <b>no_variant</b>: estas reglas nunca
                        generan variantes de producto, solo características informativas
                        y filtrables.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tl_piko_attribute_rule" model="ir.actions.act_window">
        <field name="name">Reglas de características</field>
        <field name="res_model">tl.piko.attribute.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
