<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de lista: Productos -> seleccionar -> Acciones -->
    <record id="action_refresh_piko_description" model="ir.actions.server">
        <field name="name">Rectificar descripción web (PIKO)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_tl_piko_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_tl_piko_refresh_description()</field>
    </record>

    <record id="job_function_refresh_description" model="queue.job.function">
        <field name="model_id" ref="model_tl_piko_product"/>
        <field name="method">_job_refresh_description</field>
        <field name="channel_id" ref="channel_piko_lines"/>
    </record>
</odoo>
