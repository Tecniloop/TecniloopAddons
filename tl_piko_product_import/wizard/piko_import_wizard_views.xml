<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tl_piko_import_wizard_form" model="ir.ui.view">
        <field name="name">tl.piko.import.wizard.form</field>
        <field name="model">tl.piko.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar por URL">
                <group>
                    <field name="source_id"/>
                    <field name="run_now"/>
                </group>
                <field name="urls" placeholder="https://www.piko-shop.de/de/artikel/...-49592.html"/>
                <footer>
                    <button name="action_run" type="object" string="Importar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tl_piko_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar por URL</field>
        <field name="res_model">tl.piko.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
