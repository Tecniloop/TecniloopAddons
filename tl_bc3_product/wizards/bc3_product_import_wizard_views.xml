<odoo>
    <record id="view_bc3_product_import_wizard_form" model="ir.ui.view">
        <field name="name">bc3.product.import.wizard.form</field>
        <field name="model">bc3.product.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group string="Origen">
                    <field name="source_type"/>
                    <field name="file_id" invisible="source_type != 'existing'" required="source_type == 'existing'"/>
                    <field name="data_file" filename="filename" invisible="source_type != 'upload'" required="source_type == 'upload'"/>
                    <field name="filename" invisible="source_type != 'upload'"/>
                    <field name="source_url" invisible="source_type != 'url'" required="source_type == 'url'" placeholder="https://fabricante.example/catalogo.bc3, .zip o .rar"/>
                    <field name="allow_insecure_ssl" invisible="source_type != 'url'"/>
                    <field name="max_download_size_mb" invisible="source_type != 'url'"/>
                    <field name="server_path" invisible="source_type != 'server_path'" required="source_type == 'server_path'"/>
                    <field name="bc3_filename" invisible="source_type not in ('url', 'upload', 'server_path')"/>
                </group>
                <group string="Marca / fabricante">
                    <field name="brand_id"/>
                    <field name="brand_name"/>
                    <field name="create_brand"/>
                </group>
                <group string="Productos">
                    <field name="import_work_units"/>
                    <field name="import_resources"/>
                    <field name="import_other"/>
                    <field name="include_zero_price"/>
                    <field name="update_existing"/>
                    <field name="publish_on_website"/>
                    <field name="default_product_type"/>
                    <field name="track_inventory"/>
                    <field name="batch_size"/>
                    <field name="process_first_chunk"/>
                </group>
                <group string="Categorías del sitio web">
                    <field name="create_website_categories"/>
                    <field name="website_parent_categ_id" invisible="not create_website_categories"/>
                    <field name="replace_website_categories" invisible="not create_website_categories"/>
                </group>
                <group string="Medios ecommerce">
                    <field name="import_images"/>
                    <field name="set_first_image" invisible="not import_images"/>
                    <field name="overwrite_image" invisible="not import_images"/>
                    <field name="media_zip_file" filename="media_zip_filename" invisible="not import_images"/>
                    <field name="media_zip_filename" invisible="1"/>
                    <field name="media_server_path" invisible="not import_images"/>
                    <field name="max_related_file_size_mb" invisible="not import_images"/>
                </group>
                <field name="preview_html" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_preview" string="Previsualizar" type="object" class="btn-secondary"/>
                    <button name="action_import" string="Crear lote de importación" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bc3_product_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar productos BC3</field>
        <field name="res_model">bc3.product.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
