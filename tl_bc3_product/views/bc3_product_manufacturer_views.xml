<odoo>
    <record id="view_bc3_product_manufacturer_list" model="ir.ui.view">
        <field name="name">bc3.product.manufacturer.list</field>
        <field name="model">bc3.product.manufacturer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="bc3_url"/>
                <field name="file_id"/>
                <field name="last_import_batch_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_bc3_product_manufacturer_form" model="ir.ui.view">
        <field name="name">bc3.product.manufacturer.form</field>
        <field name="model">bc3.product.manufacturer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button name="action_open_last_import_batch" string="Last Import" type="object" invisible="not last_import_batch_id"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Source">
                            <field name="active"/>
                            <field name="brand_id"/>
                            <field name="bc3_url"/>
                            <field name="bc3_filename"/>
                            <field name="allow_insecure_ssl"/>
                            <field name="max_bc3_download_size_mb"/>
                            <field name="max_related_file_size_mb"/>
                            <field name="media_server_path"/>
                        </group>
                        <group string="Import">
                            <field name="update_existing"/>
                            <field name="default_product_type"/>
                            <field name="track_inventory"/>
                            <field name="import_work_units"/>
                            <field name="import_resources"/>
                            <field name="import_other"/>
                            <field name="include_zero_price"/>
                            <field name="import_batch_size"/>
                            <field name="process_first_chunk"/>
                        </group>
                    </group>
                    <group string="Website / eCommerce">
                        <field name="create_website_categories"/>
                        <field name="website_parent_categ_id" invisible="not create_website_categories"/>
                        <field name="replace_website_categories" invisible="not create_website_categories"/>
                        <field name="publish_on_website"/>
                        <field name="import_images"/>
                        <field name="set_first_image" invisible="not import_images"/>
                        <field name="overwrite_image" invisible="not import_images"/>
                    </group>
                    <group string="Last Import">
                        <field name="file_id"/>
                        <field name="last_import_batch_id"/>
                        <field name="last_import_date"/>
                    </group>
                    <field name="preview_html" readonly="1" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bc3_product_manufacturer" model="ir.actions.act_window">
        <field name="name">BC3 Manufacturer URLs</field>
        <field name="res_model">bc3.product.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
