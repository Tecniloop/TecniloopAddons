msgid "Start transport"
msgstr "Iniciar transporte"
#. module: l10n_es_deca
msgid "Create revision"
msgstr "Crear revisión"
#. module: l10n_es_deca
msgid "Download current PDF"
msgstr "Descargar PDF vigente"
#. module: l10n_es_deca
msgid "Create / open DeCA"
msgstr "Crear / abrir DeCA"
#. module: l10n_es_deca
msgid "Create DeCA documents"
msgstr "Crear documentos DeCA"
#. module: l10n_es_deca
msgid "Legal data"
msgstr "Datos legales"
#. module: l10n_es_deca
msgid "Shipment"
msgstr "Envío"
#. module: l10n_es_deca
msgid "Vehicle and driver"
msgstr "Vehículo y conductor"
#. module: l10n_es_deca
msgid "Versions"
msgstr "Versiones"
#. module: l10n_es_deca
msgid "Delivery evidence"
msgstr "Evidencias de entrega"
#. module: l10n_es_deca
msgid "Technical verification"
msgstr "Verificación técnica"
#. module: l10n_es_deca
msgid "Electronic copy on mobile device"
msgstr "Copia electrónica en dispositivo móvil"
#. module: l10n_es_deca
msgid "Independent QR"
msgstr "QR independiente"
#. module: l10n_es_deca
msgid "Printed copy"
msgstr "Copia impresa"
#. module: l10n_es_deca
msgid "Create traced DeCA revision"
msgstr "Crear revisión trazada del DeCA"
#. module: l10n_es_deca
msgid "Seal new version"
msgstr "Sellar nueva versión"
#. module: l10n_es_deca
msgid "Stock values are initial suggestions. Review every legal field before sealing the PDF."
msgstr "Los valores de inventario son sugerencias iniciales. Revise todos los campos legales antes de sellar el PDF."
#. module: l10n_es_deca
msgid "A DeCA must be linked to a stock transfer."
msgstr "El DeCA debe estar vinculado a una transferencia de inventario."
#. module: l10n_es_deca
msgid "Record delivery of the current PDF/QR to the driver first."
msgstr "Registre primero la entrega al conductor del PDF o QR vigente."
#. module: l10n_es_deca
msgid "Only one DeCA document can be linked to a stock transfer."
msgstr "Solo puede vincularse un documento DeCA a cada transferencia de inventario."
#. module: l10n_es_deca
msgid "The DeCA PDF post-processing hook returned an invalid PDF."
msgstr "El punto de extensión de posprocesado del PDF DeCA devolvió un PDF no válido."
#. module: l10n_es_deca
msgid "Reset to draft"
msgstr "Restablecer a borrador"
#. module: l10n_es_deca
msgid "Only a cancelled DeCA without issued versions can be reopened."
msgstr "Solo puede reabrirse un DeCA cancelado que no tenga versiones emitidas."
#. module: l10n_es_deca
msgid "Administrative only"
msgstr "Solo administrativa"
#. module: l10n_es_deca
msgid "Administrative and contractual"
msgstr "Administrativa y contractual"
#. module: l10n_es_deca
msgid "Document purpose"
msgstr "Finalidad del documento"
#. module: l10n_es_deca
msgid "Not required"
msgstr "No requerida"
#. module: l10n_es_deca
msgid "Pending"
msgstr "Pendiente"
#. module: l10n_es_deca
msgid "Complete"
msgstr "Completa"
#. module: l10n_es_deca
msgid "Electronic-signature evidence"
msgstr "Evidencias de firma electrónica"
#. module: l10n_es_deca
msgid "Contractual use requires an installed and configured electronic-signature addon. Administrative DeCA issuance remains available without signatures."
msgstr "El uso contractual requiere un módulo de firma electrónica instalado y configurado. La emisión administrativa del DeCA sigue disponible sin firmas."
#. module: l10n_es_deca
msgid "The contractual DeCA did not produce the required electronic-signature evidence."
msgstr "El DeCA contractual no generó las evidencias de firma electrónica requeridas."
