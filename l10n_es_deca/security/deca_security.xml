<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_deca" model="ir.module.category">
        <field name="name">DeCA Transport Control</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_deca" model="res.groups.privilege">
        <field name="name">DeCA Transport Control</field>
        <field name="category_id" ref="module_category_deca" />
    </record>

    <record id="group_deca_user" model="res.groups">
        <field name="name">DeCA User</field>
        <field name="privilege_id" ref="privilege_deca" />
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]" />
    </record>

    <record id="group_deca_manager" model="res.groups">
        <field name="name">DeCA Manager</field>
        <field name="privilege_id" ref="privilege_deca" />
        <field name="implied_ids" eval="[(4, ref('group_deca_user'))]" />
    </record>

    <record id="rule_deca_document_company" model="ir.rule">
        <field name="name">DeCA document multi-company</field>
        <field name="model_id" ref="model_l10n_es_deca_document" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_deca_user'))]" />
    </record>

    <record id="rule_deca_version_company" model="ir.rule">
        <field name="name">DeCA version multi-company</field>
        <field name="model_id" ref="model_l10n_es_deca_version" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_deca_user'))]" />
    </record>

    <record id="rule_deca_delivery_company" model="ir.rule">
        <field name="name">DeCA delivery evidence multi-company</field>
        <field name="model_id" ref="model_l10n_es_deca_delivery_log" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_deca_user'))]" />
    </record>
</odoo>
