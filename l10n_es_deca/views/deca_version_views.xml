<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_deca_version_list" model="ir.ui.view">
        <field name="name">l10n.es.deca.version.list</field>
        <field name="model">l10n.es.deca.version</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="document_id" />
                <field name="version_number" />
                <field name="created_at" />
                <field name="change_reason" />
                <field name="pdf_size" />
                <field name="pdf_sha256" />
                <field name="signature_status" />
                <field name="signature_count" />
                <field name="public_until" />
                <button
          name="action_download"
          type="object"
          string="Download"
          icon="fa-download"
        />
            </list>
        </field>
    </record>

    <record id="view_deca_version_form" model="ir.ui.view">
        <field name="name">l10n.es.deca.version.form</field>
        <field name="model">l10n.es.deca.version</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header><button
            name="action_download"
            type="object"
            string="Download PDF"
            class="btn-primary"
          /></header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group>
                            <field name="document_id" />
                            <field name="version_number" />
                            <field name="previous_version_id" />
                            <field name="change_reason" />
                            <field name="created_at" />
                            <field name="modified_at" />
                            <field name="purpose" />
                            <field name="signature_status" />
                            <field name="signature_count" />
                            <field name="signature_profile" />
                        </group>
                        <group>
                            <field name="public_url" widget="url" />
                            <field name="public_until" />
                            <field name="pdf_size" />
                            <field name="pdf_sha256" />
                            <field name="previous_chain_hash" />
                            <field name="chain_hash" />
                        </group>
                    </group>
                    <notebook>
                        <page string="PDF"><field
                name="pdf_data"
                filename="pdf_filename"
                widget="pdf_viewer"
              /></page>
                        <page string="Frozen structured data"><field
                name="data_snapshot"
                widget="json"
              /></page>
                        <page string="Electronic-signature evidence" invisible="signature_status == 'not_required'"><field
                name="signature_evidence"
                widget="json"
              /></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_deca_version" model="ir.actions.act_window">
        <field name="name">Sealed DeCA versions</field>
        <field name="res_model">l10n.es.deca.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
