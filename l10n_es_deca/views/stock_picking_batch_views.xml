<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_picking_batch_form_deca" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.deca</field>
        <field name="model">stock.picking.batch</field>
        <field
      name="inherit_id"
      ref="stock_picking_batch.stock_picking_batch_form"
    />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
          name="action_create_deca_documents"
          type="object"
          string="Create DeCA documents"
          groups="l10n_es_deca.group_deca_user"
          invisible="state == 'done' or not picking_ids"
        />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          name="action_view_deca_documents"
          type="object"
          class="oe_stat_button"
          icon="fa-file-pdf-o"
          groups="l10n_es_deca.group_deca_user"
          invisible="deca_document_count == 0"
        >
                    <field
            name="deca_document_count"
            widget="statinfo"
            string="DeCA"
          />
                </button>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field
          name="deca_document_id"
          groups="l10n_es_deca.group_deca_user"
          invisible="not deca_document_id"
        />
            </xpath>
        </field>
    </record>
</odoo>
