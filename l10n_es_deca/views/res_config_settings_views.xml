<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_deca" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.deca</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//div[hasclass('app_settings_block')][@data-key='stock']"
        position="inside"
      >
                <block
          title="DeCA"
          id="deca_setting_container"
          groups="l10n_es_deca.group_deca_manager"
        >
                    <setting
            id="deca_public_base_url"
            string="DeCA public URL"
            help="HTTPS URL used to build each DeCA's public download link and QR code"
          >
                        <field
              name="l10n_es_deca_public_base_url"
              placeholder="https://deca.example.com"
            />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
