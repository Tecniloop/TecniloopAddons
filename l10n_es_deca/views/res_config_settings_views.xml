<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_deca" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.deca</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
          class="app_settings_block"
          data-string="DeCA"
          string="DeCA"
          data-key="l10n_es_deca"
          groups="l10n_es_deca.group_deca_manager"
        >
                    <h2>DeCA</h2>
                    <div class="row mt16 o_settings_container" id="deca_setting_container">
                        <div
              class="col-12 col-lg-6 o_setting_box"
              id="deca_public_base_url"
            >
                            <div class="o_setting_right_pane">
                                <label for="l10n_es_deca_public_base_url" string="DeCA public URL" />
                                <div class="text-muted">
                                    HTTPS URL used to build each DeCA's public download link and QR code
                                </div>
                                <div class="content-group">
                                    <field
                    name="l10n_es_deca_public_base_url"
                    placeholder="https://deca.example.com"
                  />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
