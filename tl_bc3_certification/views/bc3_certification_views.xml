<odoo>
    <record id="view_bc3_certification_list" model="ir.ui.view">
        <field name="name">bc3.certification.list</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="budget_id"/>
                <field name="certification_number"/>
                <field name="certification_date"/>
                <field name="gross_amount_origin" sum="Total gross"/>
                <field name="current_base_amount" sum="Tax base"/>
                <field name="tax_amount" sum="Taxes"/>
                <field name="total_amount" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bc3_certification_search" model="ir.ui.view">
        <field name="name">bc3.certification.search</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <search string="Certificaciones BC3">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="budget_id"/>
                <filter name="draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmada" domain="[('state','=','confirmed')]"/>
                <filter name="invoiced" string="Facturada" domain="[('state','=','invoiced')]"/>
            </search>
        </field>
    </record>

    <record id="view_bc3_certification_form" model="ir.ui.view">
        <field name="name">bc3.certification.form</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_lines" string="Recargar líneas" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_apply_global_percent" string="Aplicar % global" type="object" class="btn-secondary" invisible="state != 'draft' or certification_method != 'global_percent'"/>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Crear factura a origen" type="object" class="btn-primary" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('cancelled', 'invoiced')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_text">Sale Order</span></div>
                        </button>
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Facturas"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="General">
                            <field name="sale_order_id" required="1"/>
                            <field name="budget_id" required="1"/>
                            <field name="previous_certification_id"/>
                            <field name="origin_bc3_file_id"/>
                        </group>
                        <group string="Certificación">
                            <field name="certification_number"/>
                            <field name="certification_date"/>
                            <field name="certification_method"/>
                            <field name="global_percent" invisible="certification_method != 'global_percent'"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Parámetros de factura">
                        <group>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="award_discount_percent"/>
                        </group>
                        <group>
                            <field name="retention_warranty_percent"/>
                            <field name="retention_fiscal_percent"/>
                        </group>
                    </group>
                    <group string="Resumen de factura a origen">
                        <group>
                            <field name="gross_amount_origin" readonly="1"/>
                            <field name="award_discount_amount" readonly="1"/>
                            <field name="net_amount_origin" readonly="1"/>
                            <field name="previous_amount_origin" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_base_amount" readonly="1"/>
                            <field name="tax_amount" readonly="1"/>
                            <field name="retention_warranty_amount" readonly="1"/>
                            <field name="retention_fiscal_amount" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="bc3_code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="sale_order_line_id" readonly="1" optional="show"/>
                                    <field name="budget_qty" readonly="1"/>
                                    <field name="previous_certified_qty" readonly="1"/>
                                    <field name="previous_percent" readonly="1" optional="hide"/>
                                    <field name="current_certified_qty" optional="show"/>
                                    <field name="current_percent" readonly="1" optional="show"/>
                                    <field name="cumulative_certified_qty" optional="show"/>
                                    <field name="cumulative_percent" optional="show"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="price_unit"/>
                                    <field name="previous_amount" readonly="1" optional="hide"/>
                                    <field name="current_amount" readonly="1"/>
                                    <field name="cumulative_amount" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bc3_certification" model="ir.actions.act_window">
        <field name="name">Certificaciones BC3</field>
        <field name="res_model">bc3.certification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bc3_certification_search"/>
    </record>
</odoo>
