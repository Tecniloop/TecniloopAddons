<odoo>
    <record id="view_bc3_certification_list" model="ir.ui.view">
        <field name="name">bc3.certification.list</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="budget_id"/>
                <field name="certification_number"/>
                <field name="certification_date"/>
                <field name="amount_current"/>
                <field name="amount_cumulative"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bc3_certification_search" model="ir.ui.view">
        <field name="name">bc3.certification.search</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <search string="BC3 Certifications">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="budget_id"/>
            </search>
        </field>
    </record>

    <record id="view_bc3_certification_form" model="ir.ui.view">
        <field name="name">bc3.certification.form</field>
        <field name="model">bc3.certification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_lines" string="Reload Lines" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'invoiced')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_text">Sale Order</span></div>
                        </button>
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="sale_order_id" required="1"/>
                            <field name="budget_id" required="1"/>
                            <field name="previous_certification_id"/>
                        </group>
                        <group>
                            <field name="certification_number"/>
                            <field name="certification_date"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="amount_previous"/>
                        <field name="amount_current"/>
                        <field name="amount_cumulative"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="bc3_code" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="sale_order_line_id" readonly="1" optional="show"/>
                                    <field name="budget_qty" readonly="1"/>
                                    <field name="previous_certified_qty" readonly="1"/>
                                    <field name="current_certified_qty"/>
                                    <field name="cumulative_certified_qty"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="price_unit"/>
                                    <field name="current_amount" readonly="1"/>
                                    <field name="cumulative_amount" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bc3_certification" model="ir.actions.act_window">
        <field name="name">BC3 Certifications</field>
        <field name="res_model">bc3.certification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bc3_certification_search"/>
    </record>
</odoo>
