<odoo>
    <record id="view_move_form_inherit_bc3_certification" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bc3.certification</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="bc3_certification_id" readonly="1"/>
                <field name="bc3_sale_order_id" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='name']" position="after">
                <field name="bc3_code" optional="hide"/>
                <field name="bc3_cumulative_qty" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
