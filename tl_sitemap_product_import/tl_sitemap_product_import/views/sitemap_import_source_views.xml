<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sitemap_import_source_form" model="ir.ui.view">
        <field name="name">sitemap.import.source.form</field>
        <field name="model">sitemap.import.source</field>
        <field name="arch" type="xml">
            <form string="Fuente de importación">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="p. ej. Skechers España"/></h1>
                    </div>
                    <group>
                        <group string="Origen">
                            <field name="connector_model"/>
                            <field name="sitemap_index_url"/>
                            <field name="respect_robots_txt"/>
                        </group>
                        <group string="Red">
                            <field name="user_agent"/>
                            <field name="request_delay"/>
                            <field name="request_timeout"/>
                        </group>
                    </group>
                    <group>
                        <group string="Procesamiento">
                            <field name="products_per_run"/>
                            <field name="auto_sync_enabled"/>
                            <field name="auto_archive_discontinued"/>
                        </group>
                        <group string="Imágenes y códigos">
                            <field name="import_images"/>
                            <field name="max_images_per_product"/>
                            <field name="import_eans"/>
                            <field name="max_ean_requests_per_product" invisible="not import_eans"/>
                        </group>
                    </group>
                    <group>
                        <group string="Categorías">
                            <field name="root_category_id"/>
                            <field name="import_public_categories"/>
                            <field name="public_root_category_id" invisible="not import_public_categories"/>
                            <field name="product_tag_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Producto">
                            <field name="sale_ok"/>
                            <field name="purchase_ok"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        ¿Quieres que ciertas rutas de categoría de esta fuente usen una categoría
                        ya existente en vez de crear una nueva? Ve a
                        <strong>Importación por sitemap &gt; Mapeo de categorías</strong>. El
                        asistente <strong>Explorar categorías</strong> te muestra las rutas
                        reales del catálogo de esta fuente.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sitemap_import_source_list" model="ir.ui.view">
        <field name="name">sitemap.import.source.list</field>
        <field name="model">sitemap.import.source</field>
        <field name="arch" type="xml">
            <list string="Fuentes de importación">
                <field name="name"/>
                <field name="connector_model"/>
                <field name="sitemap_index_url"/>
                <field name="auto_sync_enabled"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_sitemap_import_source" model="ir.actions.act_window">
        <field name="name">Fuentes de importación</field>
        <field name="res_model">sitemap.import.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una fuente por cada sitio web del que quieras importar productos.
            </p>
            <p>
                Elige el conector correspondiente al sitio (cada uno sabe interpretar la
                estructura de sitemap y de ficha de ese sitio en concreto) e indica su URL de
                sitemap, categorías raíz, etiquetas y ajustes de red -así puedes reutilizar el
                mismo módulo para varias marcas o tiendas sin mezclar su configuración.
            </p>
        </field>
    </record>
</odoo>
