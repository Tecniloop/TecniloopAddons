<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sitemap_import_wizard_form" model="ir.ui.view">
        <field name="name">sitemap.import.wizard.form</field>
        <field name="model">sitemap.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar productos">
                <group>
                    <field name="source_id"/>
                    <field name="category_filter" placeholder="p. ej. mujer/calzado/zapatillas"/>
                    <field name="url_limit"/>
                    <field name="force_update"/>
                </group>
                <footer>
                    <button name="action_start_import" type="object" string="Iniciar importación"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sitemap_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar productos</field>
        <field name="res_model">sitemap.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
