<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sitemap_import" model="ir.ui.view">
        <field name="name">product.template.form.sitemap.import</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Importación" invisible="not is_sitemap_import_product">
                    <button name="action_refresh_sitemap_eans" type="object"
                            string="Actualizar EAN/GTIN" class="btn-secondary"/>
                    <group>
                        <group>
                            <field name="is_sitemap_import_product"/>
                            <field name="sitemap_source_id"/>
                            <field name="sitemap_source_url" widget="url"/>
                        </group>
                        <group>
                            <field name="sitemap_style_code"/>
                            <field name="sitemap_color_code"/>
                            <field name="sitemap_single_ean"/>
                            <field name="sitemap_ean_count"/>
                            <field name="sitemap_public_categ_id"/>
                            <field name="sitemap_lastmod"/>
                            <field name="sitemap_last_sync"/>
                        </group>
                    </group>
                    <separator string="EAN/GTIN recuperados por variante"/>
                    <field name="sitemap_ean_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="variant_label"/>
                            <field name="sku"/>
                            <field name="ean"/>
                            <field name="gtin_type"/>
                            <field name="available"/>
                            <field name="source_variant_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_action_sitemap_import" model="ir.actions.act_window">
        <field name="name">Productos importados</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_sitemap_import_product', '=', True)]</field>
        <field name="context">{'default_is_sitemap_import_product': True}</field>
    </record>

    <record id="ir_actions_server_refresh_sitemap_eans" model="ir.actions.server">
        <field name="name">Actualizar EAN/GTIN desde la fuente</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_refresh_sitemap_eans()</field>
    </record>
</odoo>
