<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sitemap_fetch_previews" model="ir.cron">
        <field name="name">Importación por sitemap: Obtener vistas previas pendientes</field>
        <field name="model_id" ref="model_sitemap_import_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_pending_previews()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_sitemap_scheduled_sync" model="ir.cron">
        <field name="name">Importación por sitemap: Sincronización periódica</field>
        <field name="model_id" ref="model_sitemap_import_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_scheduled_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
