<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sitemap_category_mapping_list" model="ir.ui.view">
        <field name="name">sitemap.category.mapping.list</field>
        <field name="model">sitemap.category.mapping</field>
        <field name="arch" type="xml">
            <list string="Mapeo de categorías" editable="bottom">
                <field name="source_id"/>
                <field name="sequence" widget="handle"/>
                <field name="category_path"/>
                <field name="product_category_id"/>
                <field name="public_category_id"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sitemap_category_mapping_form" model="ir.ui.view">
        <field name="name">sitemap.category.mapping.form</field>
        <field name="model">sitemap.category.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapeo de categoría">
                <sheet>
                    <group>
                        <field name="source_id"/>
                        <field name="category_path"/>
                        <field name="product_category_id"/>
                        <field name="public_category_id"/>
                        <field name="note"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sitemap_category_mapping_search" model="ir.ui.view">
        <field name="name">sitemap.category.mapping.search</field>
        <field name="model">sitemap.category.mapping</field>
        <field name="arch" type="xml">
            <search string="Buscar mapeos">
                <field name="category_path"/>
                <field name="source_id"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fuente" name="group_source" context="{'group_by': 'source_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sitemap_category_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo de categorías</field>
        <field name="res_model">sitemap.category.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sitemap_category_mapping_search"/>
        <field name="context">{'search_default_group_source': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un mapeo para dirigir una ruta de categoría de una fuente a una categoría
                interna y/o de comercio electrónico ya existente, en lugar de crear una nueva
                bajo la categoría raíz de esa fuente.
            </p>
            <p>
                Usa el asistente "Explorar categorías" para ver qué rutas existen realmente en
                el catálogo de cada fuente antes de crear un mapeo.
            </p>
        </field>
    </record>
</odoo>
