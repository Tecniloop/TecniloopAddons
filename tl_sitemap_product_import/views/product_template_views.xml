<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sitemap_import" model="ir.ui.view">
        <field name="name">product.template.form.sitemap.import</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Importación" invisible="not is_sitemap_import_product">
                    <button name="action_refresh_sitemap_eans" type="object"
                            string="Actualizar EAN/GTIN" class="btn-secondary"/>
                    <button name="action_repair_imported_products_direct" type="object"
                            string="Corregir contenido ahora" class="btn-secondary"
                            confirm="La corrección descargará contenido, imágenes y documentos en esta misma operación, sin queue_job. ¿Desea continuar?"/>
                    <group>
                        <group>
                            <field name="is_sitemap_import_product"/>
                            <field name="sitemap_source_id"/>
                            <field name="sitemap_source_url" widget="url"/>
                        </group>
                        <group>
                            <field name="sitemap_style_code"/>
                            <field name="sitemap_color_code"/>
                            <field name="sitemap_single_ean"/>
                            <field name="sitemap_ean_count"/>
                            <field name="sitemap_public_categ_id"/>
                            <field name="sitemap_lastmod"/>
                            <field name="sitemap_last_sync"/>
                        </group>
                    </group>
                    <separator string="Recetas y artículos relacionados"/>
                    <field name="sitemap_blog_post_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="blog_id"/>
                            <field name="website_published" optional="show"/>
                            <field name="sitemap_source_url" widget="url" optional="hide"/>
                            <field name="sitemap_last_sync" optional="hide"/>
                        </list>
                    </field>
                    <separator string="EAN/GTIN recuperados por variante"/>
                    <field name="sitemap_ean_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="variant_label"/>
                            <field name="sku"/>
                            <field name="ean"/>
                            <field name="gtin_type"/>
                            <field name="available"/>
                            <field name="source_variant_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <record id="view_product_template_list_sitemap_import" model="ir.ui.view">
        <field name="name">product.template.list.sitemap.import</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Productos importados" create="0">
                <header>
                    <button name="action_refresh_sitemap_eans" type="object"
                            string="Actualizar EAN/GTIN" class="btn-secondary"
                            display="always"/>
                    <button name="action_queue_repair_imported_products" type="object"
                            string="Corregir contenidos en cola" class="btn-secondary"
                            display="always"
                            confirm="La corrección se enviará a queue_job e incluirá contenidos, imágenes y documentos. ¿Desea continuar?"/>
                    <button name="action_repair_imported_products_direct" type="object"
                            string="Corregir contenidos ahora" class="btn-primary"
                            display="always"
                            confirm="La corrección descargará contenidos, imágenes y documentos en esta misma operación, sin queue_job. ¿Desea continuar?"/>
                </header>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="sitemap_source_id" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="list_price" optional="show"/>
                <field name="sitemap_last_sync" optional="show"/>
                <field name="sitemap_ean_count" optional="hide"/>
                <field name="sitemap_source_url" widget="url" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_template_action_sitemap_import" model="ir.actions.act_window">
        <field name="name">Productos importados</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="view_product_template_list_sitemap_import"/>
        <field name="domain">[('is_sitemap_import_product', '=', True)]</field>
        <field name="context">{'default_is_sitemap_import_product': True}</field>
    </record>

    <record id="ir_actions_server_refresh_sitemap_eans" model="ir.actions.server">
        <field name="name">Actualizar EAN/GTIN desde la fuente</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_refresh_sitemap_eans()</field>
    </record>

    <record id="ir_actions_server_repair_imported_products" model="ir.actions.server">
        <field name="name">Corregir contenidos en cola (imágenes y documentos)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_queue_repair_imported_products()</field>
    </record>

    <record id="ir_actions_server_repair_imported_products_direct" model="ir.actions.server">
        <field name="name">Corregir contenidos ahora (imágenes y documentos, sin cola)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_repair_imported_products_direct()</field>
    </record>
</odoo>
