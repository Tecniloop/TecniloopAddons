<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_package_dimensions" model="ir.ui.view">
        <field name="name">product.template.form.package.dimensions</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Dimensiones del embalaje" name="package_physical_dimensions">
                    <group>
                        <field name="package_length"/>
                        <field name="package_width"/>
                        <field name="package_height"/>
                        <field name="package_dimensional_uom_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="package_weight"/>
                        <field name="package_weight_uom_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="package_volume_m3" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
