<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_catastro" model="ir.ui.view">
        <field name="name">res.partner.form.catastro</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Catastro" name="partner_catastro_page">
                    <group>
                        <group>
                            <field name="catastro_ref" readonly="1"/>
                            <field name="catastro_last_sync" readonly="1"/>
                            <field name="catastro_sync_state" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_open_catastro_wizard"
                                    type="object"
                                    string="Importar desde Catastro"
                                    class="btn-primary"/>
                        </group>
                    </group>

                    <group string="Resumen">
                        <group>
                            <field name="catastro_bi_type" readonly="1"/>
                            <field name="catastro_use" readonly="1"/>
                            <field name="catastro_surface" readonly="1"/>
                            <field name="catastro_coefficient" readonly="1"/>
                            <field name="catastro_antiquity" readonly="1"/>
                        </group>
                        <group>
                            <field name="catastro_province" readonly="1"/>
                            <field name="catastro_municipality" readonly="1"/>
                            <field name="catastro_zip" readonly="1"/>
                        </group>
                    </group>

                    <group string="Dirección Catastro">
                        <group>
                            <field name="catastro_street_type" readonly="1"/>
                            <field name="catastro_street_name" readonly="1"/>
                            <field name="catastro_street_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="catastro_block" readonly="1"/>
                            <field name="catastro_stair" readonly="1"/>
                            <field name="catastro_floor" readonly="1"/>
                            <field name="catastro_door" readonly="1"/>
                        </group>
                    </group>

                    <group string="Coordenadas">
                        <group>
                            <field name="catastro_coord_x" readonly="1"/>
                            <field name="catastro_coord_y" readonly="1"/>
                            <field name="catastro_srs" readonly="1"/>
                        </group>
                    </group>

                    <group string="Error" invisible="not catastro_error">
                        <field name="catastro_error" readonly="1" nolabel="1"/>
                    </group>

                    <separator string="Todos los campos devueltos por Catastro"/>
                    <field name="catastro_line_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0" open_form_view="0">
                            <field name="sequence" optional="hide"/>
                            <field name="section"/>
                            <field name="label"/>
                            <field name="value"/>
                            <field name="path" optional="hide"/>
                        </list>
                    </field>

                    <separator string="Payload bruto"/>
                    <field name="catastro_raw_payload" widget="text" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
