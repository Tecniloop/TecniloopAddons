<odoo>
    <data noupdate="1">
        <record id="ir_cron_auto_close_attendances" model="ir.cron">
            <field name="name">Cierre automático de asistencias abiertas</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">
model._cron_auto_check_out_all()
# model._cron_auto_check_out_all('01:00')</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">2</field>
            <field name="nextcall">2026-01-10 00:00:00</field>
            <field name="active">True</field>
        </record>
    </data>

    <record id="hr_attendance_view_tree_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.tree</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree" />
        <field name="arch" type="xml">
            <field name="validated_overtime_hours" position="after">
                <field name="extra_hours_required" readonly="1" optional="show"/>
                <field name="extra_hours_payroll" readonly="1" optional="show"/>
                <field name="real_extra_hours" readonly="1" widget="float_time" invisible="not extra_hours_required" optional="show"/>
                <field name="work_location" readonly="1" optional="show"/>
                <field name="validated_attendance" readonly="not extra_hours_required" group="hr_attendance.group_hr_attendance_manager" widget="boolean_toggle" optional="show"/>
            </field>
        </field>
    </record>
    
    <record id="hr_attendance_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">            
            <xpath expr="//sheet/group[1]/group[1]/group[2]" position="inside">
                <separator string="Información Extra"/>      
                <field name="work_location" readonly="not in_mode == 'manual'" />
                <field name="extra_hours_required" readonly="1" widget="boolean_toggle"/>       
                <label for="real_extra_hours" string="Horas extra reales" invisible="not extra_hours_required"/>
                <div class="o_row">
                    <field name="real_extra_hours" widget="float_time" invisible="not extra_hours_required" />       
                    <button class="btn btn-outline-secondary" name="button_asing_extra_hours" string="Asignar horas extra" type="object" invisible="not extra_hours_required or validated_attendance or time_off_hours or extra_hours_payroll" />                
                    <button class="btn btn-outline-danger" name="button_undo_free_time_assign" string="Deshacer" type="object" invisible="not extra_hours_required or not time_off_hours or validated_attendance" icon="fa-undo" />                
                </div>
                <field name="time_off_hours" invisible="1" />
                <field name="hr_allocation_id" invisible="not time_off_hours" readonly="1" />
                <field name="extra_hours_payroll" invisible="not extra_hours_required" group="hr_attendance.group_hr_attendance_manager" widget="boolean_toggle" readonly="time_off_hours" />       
                <field name="validated_attendance" invisible="not extra_hours_required" group="hr_attendance.group_hr_attendance_manager" widget="boolean_toggle" />
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_view_filter_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter" />
        <field name="arch" type="xml">
            <filter name="myteam" position="after">
                <separator/>
                <filter string="Pagar en Nómina" name="extra_hours_payroll" domain="[('extra_hours_payroll','=', True)]"/>
                <filter string="Bolsa de Horas" name="time_off_hours" domain="[('time_off_hours','=', True)]"/>
                <filter string="Horas extra a Validar" name="validate_extra_hours" domain="[('extra_hours_required','=', True), ('validated_attendance','=',False)]"/>
                <filter string="Horas extra Validadas" name="validated_extra_hours" domain="[('validated_attendance','=', True)]"/>
            </filter>
            <filter name="groupby_name" position="before">
                <filter string="Ubicación" name="groupby_location" context="{'group_by': 'work_location'}"/>
            </filter>
        </field>
    </record>
    
</odoo>