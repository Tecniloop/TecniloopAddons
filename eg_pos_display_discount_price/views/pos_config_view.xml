<odoo>
    <record id="eg_pos_display_discount_price_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">eg.pos.display.discount.price.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="eg_app_base.eg_app_base_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='eg_app_base']" position="after">
                <block title="POS Display Discount Price" id="eg_app_base">
                    <setting help="eg_pos_display_discount_price" id="display_discount_price">
                        <field name="display_discount_price"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
