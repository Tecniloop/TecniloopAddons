<odoo>
    <record id="product_template_view_for_pos_display_discount_price" model="ir.ui.view">
        <field name="name">product.template.form.for.pos.display.discount.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <field name="discount_price" position="after">
                    <field name="discount_price" invisible="not is_display_discount_price"/>
                </field>
            </xpath>
        </field>
    </record>
</odoo>


