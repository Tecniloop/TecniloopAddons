<odoo>
    <record id="ir_cron_icecat_category_sync" model="ir.cron">
        <field name="name">Icecat: sync category taxonomy</field>
        <field name="active" eval="False"/>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="model_id" ref="model_icecat_category"/>
        <field name="code">model.action_sync_from_icecat()</field>
        <field name="state">code</field>
    </record>

    <record id="ir_cron_icecat_bulk_import" model="ir.cron">
        <field name="name">Icecat: process bulk product imports</field>
        <field name="active" eval="True"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="model_id" ref="product_brand.model_product_brand"/>
        <field name="code">model._cron_process_icecat_bulk_import()</field>
        <field name="state">code</field>
    </record>
</odoo>
