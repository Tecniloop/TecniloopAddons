#. module: product_icecat
#: model:ir.model,name:product_icecat.model_icecat_import_line
msgid "Icecat Bulk Import Line"
msgstr "Línea de importación masiva de Icecat"

#. module: product_icecat
#: model:ir.model,name:product_icecat.model_icecat_product_import
msgid "Import a Product from Icecat"
msgstr "Importar un producto desde Icecat"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__name
msgid "Exact manufacturer/vendor name as known by Icecat. This is sent as the 'vendor' parameter when querying the Icecat API, so it must match Icecat's own spelling (e.g. as seen in their supplier mapping export)."
msgstr "Nombre exacto del fabricante/proveedor tal y como lo conoce Icecat. Se envía como parámetro 'vendor' al consultar la API de Icecat, por lo que debe coincidir con la grafía de Icecat (p. ej. la de su exportación de proveedores)."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_manufacturer__icecat_supplier_id
msgid "Icecat Supplier ID"
msgstr "ID de proveedor Icecat"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__icecat_supplier_id
msgid "Icecat's internal numeric Supplier ID, used to find this manufacturer's products in Icecat's catalog index during bulk imports. Filled in automatically from Icecat's suppliers list (by 'Sync Manufacturers from Icecat', or on demand the first time it is needed) — only fill it by hand if the automatic lookup cannot match this manufacturer's name."
msgstr "ID numérico interno de proveedor de Icecat, usado para localizar los productos de este fabricante en el índice de catálogo de Icecat durante las importaciones masivas. Se rellena automáticamente desde la lista de proveedores de Icecat (con 'Sincronizar fabricantes desde Icecat' o bajo demanda la primera vez que se necesita); rellénelo a mano solo si la búsqueda automática no encuentra el nombre de este fabricante."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_manufacturer__product_brand_ids
msgid "Linked Brands"
msgstr "Marcas vinculadas"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__import_main_image
msgid "When importing a product from this manufacturer, set Icecat's main picture as the product image."
msgstr "Al importar un producto de este fabricante, establecer la imagen principal de Icecat como imagen del producto."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_manufacturer__import_gallery_images
#: model:ir.model.fields,field_description:product_icecat.field_icecat_product_import__import_gallery_images
msgid "Import Additional Images"
msgstr "Importar imágenes adicionales"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__import_gallery_images
msgid "When importing a product from this manufacturer, import Icecat's additional pictures as extra website media (product gallery images shown on the eCommerce product page)."
msgstr "Al importar un producto de este fabricante, importar las imágenes adicionales de Icecat como medios extra del sitio web (galería de imágenes mostrada en la página de producto del comercio electrónico)."

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__create_product_category
msgid "When importing a product from this manufacturer, get or create a Product Category matching its Icecat category, and set it on the product."
msgstr "Al importar un producto de este fabricante, obtener o crear una categoría de producto correspondiente a su categoría Icecat y asignarla al producto."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_manufacturer__create_ecommerce_category
#: model:ir.model.fields,field_description:product_icecat.field_icecat_product_import__create_ecommerce_category
msgid "Create eCommerce Category"
msgstr "Crear categoría de comercio electrónico"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_manufacturer__create_ecommerce_category
msgid "When importing a product from this manufacturer, get or create a Website/eCommerce Category matching its Icecat category, and add it to the product."
msgstr "Al importar un producto de este fabricante, obtener o crear una categoría de sitio web/comercio electrónico correspondiente a su categoría Icecat y añadirla al producto."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_category__icecat_id
msgid "Icecat Category ID"
msgstr "ID de categoría Icecat"

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_category__parent_id
msgid "Parent Category"
msgstr "Categoría padre"

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_category__child_ids
msgid "Child Categories"
msgstr "Categorías hijas"

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_category__product_categ_id
msgid "Mapped Product Category"
msgstr "Categoría de producto mapeada"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_category__product_categ_id
msgid "Product Category created/linked from this Icecat category. Only populated for manufacturers with 'Create Product Category' enabled."
msgstr "Categoría de producto creada/vinculada desde esta categoría Icecat. Solo se rellena para fabricantes con 'Crear categoría de producto' activado."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_icecat_category__ecommerce_categ_id
msgid "Mapped eCommerce Category"
msgstr "Categoría de comercio electrónico mapeada"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_icecat_category__ecommerce_categ_id
msgid "Website/eCommerce Category created/linked from this Icecat category. Only populated for manufacturers with 'Create eCommerce Category' enabled."
msgstr "Categoría de sitio web/comercio electrónico creada/vinculada desde esta categoría Icecat. Solo se rellena para fabricantes con 'Crear categoría de comercio electrónico' activado."

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_product_template__icecat_category_id
msgid "Icecat catalog category this product was classified under."
msgstr "Categoría del catálogo Icecat bajo la que se clasificó este producto."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_product_template__icecat_product_id
msgid "Icecat Product ID"
msgstr "ID de producto Icecat"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_product_template__icecat_product_id
msgid "Icecat's internal numeric product ID (Product/@ID). Kept to identify this exact Icecat record when refreshing."
msgstr "ID numérico interno de producto de Icecat (Product/@ID). Se conserva para identificar este registro exacto de Icecat al actualizar."

#. module: product_icecat
#: model:ir.model.fields,field_description:product_icecat.field_product_template__icecat_prod_id
msgid "Icecat Part Number"
msgstr "Referencia de fabricante Icecat"

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_product_template__icecat_prod_id
msgid "Manufacturer part number as known by Icecat (Product/@Prod_id), used together with the brand's Icecat manufacturer to refresh this product's data."
msgstr "Referencia del fabricante tal y como la conoce Icecat (Product/@Prod_id), usada junto con el fabricante Icecat de la marca para actualizar los datos de este producto."

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_product_brand__icecat_manufacturer_id
msgid "Icecat manufacturer linked to this brand. Used to look up products by part number on the Icecat catalog, and to resolve the default import settings (images, categories) applied when importing products for this brand."
msgstr "Fabricante Icecat vinculado a esta marca. Se usa para buscar productos por referencia en el catálogo Icecat y para resolver los ajustes de importación por defecto (imágenes, categorías) aplicados al importar productos de esta marca."

#. module: product_icecat
#: model:ir.model.fields,help:product_icecat.field_product_brand__icecat_bulk_state
msgid "Status of the last 'Import All Products from Icecat' run for this brand."
msgstr "Estado de la última ejecución de 'Importar todos los productos desde Icecat' para esta marca."

