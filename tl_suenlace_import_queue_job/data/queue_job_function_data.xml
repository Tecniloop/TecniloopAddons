<odoo noupdate="1">
    <record id="channel_suenlace" model="queue.job.channel">
        <field name="name">suenlace</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>

    <record id="job_function_suenlace_batch" model="queue.job.function">
        <field name="model_id" ref="tl_suenlace_import.model_tl_suenlace_import"/>
        <field name="method">job_run_batch</field>
        <field name="channel_id" ref="channel_suenlace"/>
        <field name="retry_pattern" eval="{1: 60, 3: 180, 5: 600}"/>
    </record>
</odoo>
