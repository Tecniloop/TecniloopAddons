<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tl_suenlace_import_view_form_queue_job" model="ir.ui.view">
        <field name="name">tl.suenlace.import.view.form.queue.job</field>
        <field name="model">tl.suenlace.import</field>
        <field name="inherit_id" ref="tl_suenlace_import.tl_suenlace_import_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_jobs" type="object"
                        class="oe_stat_button" icon="fa-tasks"
                        invisible="job_count == 0">
                    <field name="job_count" widget="statinfo" string="Jobs"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='post_moves']" position="before">
                <field name="async_mode" invisible="not background_mode"/>
                <field name="job_uuids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
