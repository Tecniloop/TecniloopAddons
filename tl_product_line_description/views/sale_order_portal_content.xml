<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sale_order_portal_content_inherit" inherit_id="sale.sale_order_portal_content">
        
        <!--AÑADIR DESCRIPCION PARA DISTINGUIR NOMBRE PRODUCTO DE DESCRIPCION-->
        <xpath expr="//td[@name='td_product_name']" position="replace">
            <td name="td_product_name">
                <p style="font-weight: bold;" t-field="line.product_display"/>
                <p style="white-space: pre-wrap;font-size:10px; font-style: italic; line-height: 1.5;" t-field="line.description_display"/>
            </td>
        </xpath>
        
    </template>
</odoo>