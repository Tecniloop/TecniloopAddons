<odoo>
    <record id="view_order_form_inherit_mst" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mst</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
           <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div class="o_row float-end" style="width: auto; margin-bottom: 10px;">
                    <field name="etapa_oferta" 
                           widget="statusbar" 
                           options="{'clickable': '1'}"
                           invisible="state not in ['draft', 'sent']"/>
                    
                    <field name="etapa_comanda" 
                           widget="statusbar" 
                           options="{'clickable': '1'}"
                           invisible="state not in ['sale', 'done']"/>
                </div>
                <div class="clearfix"/>
            </xpath>

        </field>
    </record>
</odoo>