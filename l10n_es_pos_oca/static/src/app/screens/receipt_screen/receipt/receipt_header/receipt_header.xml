<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_es_pos_oca.ReceiptHeader"
        t-inherit="point_of_sale.ReceiptHeader"
        t-inherit-mode="extension"
    >
        <xpath expr="//span[hasclass('pos-receipt-vat')]" position="before">
            <t t-if="order.config.is_simplified_config and !order.isToInvoice()">
                <div>Simplified invoice</div>
                <div
                    class="simplified-invoice-number"
                    t-esc="order.l10n_es_unique_id"
                />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-customer')]" position="attributes">
            <attribute
                name="t-if"
            >order.partner_id and order.partner_id.id !== order.config.simplified_partner_id?.id</attribute>
        </xpath>
    </t>
</templates>
