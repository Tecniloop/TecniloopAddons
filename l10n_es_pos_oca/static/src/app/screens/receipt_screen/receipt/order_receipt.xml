<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_es_pos_oca.OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('pos-receipt-qr')]" position="attributes">
            <attribute
                name="t-if"
            >order.company.point_of_sale_use_ticket_qr_code and order.finalized and (!order.config.is_simplified_config or order.isToInvoice())</attribute>
        </xpath>
    </t>
</templates>
