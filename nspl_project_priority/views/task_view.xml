<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nspl_task_priority_filter" model="ir.ui.view">
        <field name="name">project.task.search.priority</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="before">
                <filter name="priority_low" string="Low Priority" domain="[('priority', '=', '0')]"/>
                <filter name="priority_medium" string="Medium Priority" domain="[('priority', '=', '1')]"/>
                <filter name="priority_high" string="High Priority" domain="[('priority', '=', '2')]"/>
                <filter name="priority_very_high" string="Very High Priority" domain="[('priority', '=', '3')]"/>
                <separator/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter name="group_by_priority" string="Priority" context="{'group_by': 'priority'}"/>
            </xpath>
        </field>
    </record>
</odoo>
